---
interface Props {
  label: string;
}

const { label } = Astro.props;

const contacts = [
  { icon: "icon-phone", text: "+(86) 18721400154", href: "tel:+8618721400154", external: false },
  { icon: "icon-mail", text: "me@wilboerht.cn", href: "mailto:me@wilboerht.cn", external: false },
  { icon: "icon-globe", text: "wilboerht.com", href: "https://www.wilboerht.com", external: true },
  { icon: "icon-github", text: "GitHub", href: "https://github.com/Wilboerht", external: true },
  { icon: "icon-twitter", text: "X", href: "https://twitter.com/wilboerht", external: true },
];
---

<div class="contact-menu">
  <button
    class="contact-trigger"
    type="button"
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls="contact-dropdown"
  >
    <svg class="icon" aria-hidden="true"><use href="#icon-mail" /></svg>
    <span>{label}</span>
    <svg
      class="chevron"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    ><polyline points="6 9 12 15 18 9"></polyline></svg>
  </button>

  <div class="contact-dropdown" id="contact-dropdown" role="menu" aria-label={label}>
    {
      contacts.map((c) => (
        <a
          class="contact-link"
          role="menuitem"
          href={c.href}
          target={c.external ? "_blank" : undefined}
          rel={c.external ? "noopener noreferrer" : undefined}
        >
          <svg class="icon" aria-hidden="true">
            <use href={`#${c.icon}`} />
          </svg>
          <span>{c.text}</span>
        </a>
      ))
    }
  </div>
</div>

<div class="contact-print">
  {contacts.map((c) => <span>{c.text}</span>)}
</div>

<style>
  .contact-menu {
    position: relative;
    display: inline-block;
    margin-top: 14px;
  }

  .contact-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-color);
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.15s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  .contact-trigger:hover {
    border-color: var(--link-color);
    color: var(--link-color);
    box-shadow: 0 2px 12px rgba(26, 84, 144, 0.14);
    transform: translateY(-1px);
  }

  .contact-trigger .chevron {
    width: 14px;
    height: 14px;
    transition: transform 0.25s ease;
  }

  .contact-menu.open .contact-trigger {
    background: var(--primary-color);
    border-color: var(--primary-color);
    color: #fff;
  }

  .contact-menu.open .contact-trigger .chevron {
    transform: rotate(180deg);
  }

  .contact-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(-8px) scale(0.96);
    transform-origin: top center;
    min-width: 225px;
    padding: 6px;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.13);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.22s ease,
      transform 0.22s ease,
      visibility 0.22s;
    z-index: 150;
  }

  .contact-menu.open .contact-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .contact-dropdown::before {
    content: "";
    position: absolute;
    top: -5.5px;
    left: 50%;
    width: 10px;
    height: 10px;
    background: var(--card-bg);
    border-left: 1px solid var(--border-color);
    border-top: 1px solid var(--border-color);
    transform: translateX(-50%) rotate(45deg);
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    font-size: 0.875rem;
    color: var(--text-color);
    text-decoration: none;
    border-radius: 7px;
    white-space: nowrap;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      padding-left 0.15s ease;
  }

  .contact-link:hover {
    background: var(--hover-bg);
    color: var(--link-color);
    padding-left: 16px;
    opacity: 1;
  }

  .contact-link .icon {
    color: var(--light-text);
    transition: color 0.15s ease;
  }

  .contact-link:hover .icon {
    color: var(--link-color);
  }

  .contact-print {
    display: none;
  }

  @media print {
    .contact-menu {
      display: none;
    }
    .contact-print {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 4px 0;
      margin-top: 8px;
      font-size: 9pt;
      color: #333;
    }
    .contact-print span:not(:last-child)::after {
      content: "·";
      margin: 0 8px;
      color: #999;
    }
  }
</style>

<script>
  const menu = document.querySelector(".contact-menu");
  if (menu) {
    const trigger = menu.querySelector(".contact-trigger") as HTMLButtonElement;
    const setOpen = (open: boolean) => {
      menu.classList.toggle("open", open);
      trigger.setAttribute("aria-expanded", String(open));
    };
    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(!menu.classList.contains("open"));
    });
    document.addEventListener("click", (e) => {
      if (!menu.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  }
</script>
