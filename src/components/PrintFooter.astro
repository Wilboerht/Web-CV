---
interface Props {
  warning: string;
}

const { warning } = Astro.props;
---

<footer class="print-footer">
  <p class="print-footer-warning">{warning}</p>
</footer>

<style>
  .print-footer {
    display: none;
  }

  @media print {
    .print-footer {
      display: block;
      margin-top: 16pt;
      border: 1px solid #ddd;
      border-radius: 4px;
      padding: 8pt 12pt;
      text-align: center;
    }
    .print-footer-warning {
      margin: 0;
      font-size: 8pt;
      line-height: 1.5;
      color: #555;
      font-weight: 600;
    }
  }
</style>
