---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();

const copyright: Record<string, string> = {
  "zh-CN": `© ${year} 王泓坤`,
  "zh-TW": `© ${year} 王泓坤`,
  "zh-HK": `© ${year} 王泓坤`,
  en: `© ${year} Hongkun Wang`,
  de: `© ${year} Hongkun Wang`,
  ko: `© ${year} 왕홍곤`,
};

const text = copyright[lang] ?? copyright.en;
---

<footer class="site-footer">
  <p>{text}</p>
</footer>

<style>
  .site-footer {
    margin-top: 0;
    padding-top: 16px;
    border-top: 1px solid var(--border-color);
    text-align: center;
    color: var(--light-text);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    line-height: 1.6;
  }
  .site-footer p {
    margin: 0;
  }
  @media (max-width: 600px) {
    .site-footer {
      margin-top: 0;
      padding-top: 14px;
      font-size: 0.75rem;
    }
  }
  @media print {
    .site-footer {
      display: none;
    }
  }
</style>
