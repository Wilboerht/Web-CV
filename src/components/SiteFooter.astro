---
import { CONTENT_LAST_UPDATED } from "../data/site";

interface Props {
  lang: string;
}

const { lang } = Astro.props;

const labels: Record<string, string> = {
  "zh-CN": "最后更新：",
  "zh-TW": "最後更新：",
  "zh-HK": "最後更新：",
  en: "Last updated: ",
  de: "Zuletzt aktualisiert: ",
  ko: "최종 업데이트: ",
};

const locales: Record<string, string> = {
  "zh-CN": "zh-CN",
  "zh-TW": "zh-TW",
  "zh-HK": "zh-HK",
  en: "en-US",
  de: "de-DE",
  ko: "ko-KR",
};

const updated = new Date(CONTENT_LAST_UPDATED);
const formatted = new Intl.DateTimeFormat(locales[lang] ?? "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "Asia/Shanghai",
}).format(updated);

const label = labels[lang] ?? labels.en;
---

<footer class="site-footer">
  <p class="site-footer__updated">
    {label}<time datetime={CONTENT_LAST_UPDATED}>{formatted}</time>
  </p>
</footer>

<style>
  .site-footer {
    padding: 24px 24px calc(20px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--border-color);
    background: var(--background);
    text-align: center;
    color: var(--cv-text-muted);
    font-size: var(--cv-fs-meta);
    line-height: var(--cv-lh-base);
  }

  .site-footer__updated {
    margin: 0;
    font-variant-numeric: tabular-nums lining-nums;
  }

  @media (max-width: 600px) {
    .site-footer {
      padding: 18px 16px calc(14px + env(safe-area-inset-bottom, 0px));
      font-size: var(--cv-fs-caption);
    }
  }

  @media print {
    .site-footer {
      display: none;
    }
  }
</style>
