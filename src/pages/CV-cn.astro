        "name": "天翼云高级开发工程师认证（SCCP）",
        "dateCreated": "2024-11"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "阿里云 ACA 云安全助理工程师认证",
        "dateCreated": "2024-10"
