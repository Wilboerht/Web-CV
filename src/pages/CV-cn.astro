---
import Layout from "../layouts/Layout.astro";
import ContactMenu from "../components/ContactMenu.astro";
import "../styles/global.css";
import "../styles/cv.css";
---

<Layout title="王泓坤 - 简历" lang="zh-CN">
  <slot name="head">
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "王泓坤",
        "alternateName": "Hongkun Wang",
        "givenName": "泓坤",
        "familyName": "王",
        "email": "me@wilboerht.cn",
        "telephone": "+8618721400154",
        "url": "https://www.wilboerht.com",
        "sameAs": [
          "https://github.com/Wilboerht",
          "https://twitter.com/wilboerht"
        ],
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "上海科学技术职业学院"
        },
        "knowsAbout": [
          "TypeScript",
          "React",
          "Next.js",
          "Node.js",
          "Prisma",
          "PostgreSQL",
          "Large Language Models",
          "RAG",
          "Docker",
          "Linux"
        ],
        "jobTitle": "数字开发经理",
        "worksFor": {
          "@type": "Organization",
          "name": "穆埃达思 Moidas"
        }
      }
    </script>
  </slot>
  <style>
    :root {
      --cv-font-body: 'Noto Serif SC', 'Source Serif 4', serif;
    }
  </style>

  <div class="container">
    <header>
      <h1>王泓坤</h1>
      <ContactMenu label="联系我" />
    </header>

    <section>
      <h2>教育背景</h2>
      <div class="entry">
        <div class="entry-header">
          <div class="entry-title-group">
            <span class="entry-org">上海科学技术职业学院</span>
          </div>
          <span class="entry-date">2023.10 - 2026.06</span>
        </div>
        <div class="entry-major">
          通信与电子工程学院，信息安全技术应用专业，专科
        </div>
        <p class="entry-desc">
          主修课程：网络安全、程序设计、算法与数据结构、体系结构、操作系统、数据库系统、计算机网络等
        </p>
        <p class="entry-desc" style="margin-top: 4px;">
          校内获奖：2023-2025 双学年校二等奖学金，2023-2024 学年校优秀学生，校优秀毕业生
        </p>
        <p class="entry-desc" style="margin-top: 4px;">
          学业成绩：GPA: 3.41/4.00
        </p>
      </div>
    </section>

    <section>
      <h2>工作经历</h2>
      <div class="entry">
        <div class="entry-header">
          <span class="entry-org"
            >穆埃达思 Moidas | 旎柏事业部 —— 数字开发经理</span
          >
          <span class="entry-date">2025.10 – 至今</span>
        </div>
        <div class="entry-role-detail">实习转正，前职：AI 应用全栈开发工程师（2025.10 - 2026.6）</div>
        <p class="entry-desc">
          <strong>数字化产品规划与落地：</strong>主导品牌大中华区数字化产品矩阵从 0 到 1 建设，统筹官网、微信小程序、AI 护肤顾问、授权验真平台等核心系统的需求分析、技术架构、模型选型及合规上线；同时承担核心模块的一线开发，实现全链路闭环交付。
        </p>
        <p class="entry-desc">
          <strong>AI 研发效能体系：</strong>建立 AI 辅助研发工作流（Claude Code、Codex 等工具链），将平均交付周期压缩 50% 以上；制定 UI/UX 设计规范与前端实现标准，并直接参与核心页面与组件的开发实现，确保品牌视觉一致性。
        </p>
        <p class="entry-desc">
          <strong>大模型业务落地：</strong>设计并落地 AI 护肤顾问系统，基于 RAG 架构构建领域知识库，实现多轮对话与个性化推荐；主导模型集成与核心接口开发，直接驱动用户咨询转化率提升。
        </p>
        <p class="entry-desc">
          <strong>技术运营与成本治理：</strong>负责服务器资源规划与成本优化，依据业务流量动态调整架构配置；主导 SEO &amp; GEO 策略实施，亲自推进搜索引擎收录与生成式引擎引用展示的技术实现，提升品牌线上曝光。
        </p>
        <p class="entry-desc">
          <strong>跨部门协同与需求管理：</strong>作为技术侧负责人对接产品、营销团队，参与营销活动玩法设计，建立迭代响应机制；同时承担紧急需求的一线快速响应与开发，保障多项目并行交付与持续运营。
        </p>
      </div>
      <div class="entry">
        <div class="entry-header">
          <span class="entry-org"
            >上海临港景鸿安全防范科技发展有限公司 —— 技术研发实习生</span
          >
          <span class="entry-date">2025.07 - 2025.09</span>
        </div>
        <p class="entry-desc">
          <strong>企业官网全栈交付：</strong>独立完成公司官网系统架构设计、前后端开发及生产环境部署，基于 Next.js 构建桌面端方案，支撑品牌线上形象展示与业务获客。
        </p>
        <p class="entry-desc">
          <strong>AI 能力内部赋能：</strong>本地化部署大模型智能问答助手（Weknora），构建企业知识库 AI 交互系统，基于 RAG 架构实现精准问答，推动 AI 工具在内部流程中的首次落地，与百度企业问答库团队对接，为后续产品化积累经验。
        </p>
        <p class="entry-desc">
          <strong>安全架构实践：</strong>针对安防行业数据敏感特性，设计 Prisma 数据库模型，配置 JWT 认证、RLS 行级安全及 CSP 内容安全策略，实现多层安全防护体系。
        </p>
      </div>
    </section>

    <section>
      <h2>项目经历</h2>

      <div class="project-entry">
        <div class="entry-header">
          <span class="project-name">旎柏（NIHPLOD）中国官方数字化平台</span>
          <span class="entry-date">2025.11 – 至今</span>
        </div>
        <div class="project-meta">
          产品规划 · 技术架构 · AI 集成 · 全栈开发 · 合规上线 · 成果展示：<a
            href="https://www.nihplod.cn"
            target="_blank" rel="noopener noreferrer">www.nihplod.cn</a
          >、<a href="https://advisor.nihplod.cn" target="_blank" rel="noopener noreferrer"
            >advisor.nihplod.cn</a
          >
        </div>
        <p class="project-abstract">
          作为技术负责人，主导品牌大中华区数字化产品矩阵从 0 到 1 规划与落地，覆盖官网、微信商城、授权验真、AI 护肤顾问、H5 核销、达人合作等 6+ 核心系统。
        </p>
        <ul class="project-points">
          <li>
            <strong>产品规划与架构设计：</strong>基于业务目标拆解产品路线图，独立完成 6 个核心系统的技术选型与架构设计，确保系统可扩展性与品牌视觉一致性。
          </li>
          <li>
            <strong>AI 驱动研发提效：</strong>建立 AI 辅助开发工作流（Claude Code、Codex），将平均交付周期压缩 50% 以上，支撑多项目并行快速迭代。
          </li>
          <li>
            <strong>成本可控的运维体系：</strong>根据业务流量动态调整服务器资源配置，在保障稳定性的前提下实现成本优化。
          </li>
          <li>
            <strong>合规与风险管控：</strong>主导 ICP 备案、隐私政策及用户协议制定，完成数据合规审查，确保产品符合监管要求。
          </li>
          <li>
            <strong>搜索可见性提升：</strong>实施 SEO &amp; GEO 策略，优化搜索引擎收录与生成式引擎引用展示，提升品牌线上曝光。
          </li>
        </ul>
        <p class="entry-desc" style="margin-top: 8px;">
          关键成果：NIHPLOD 中国区官网、授权验真平台、AI 护肤顾问等核心系统已稳定上线运营。
        </p>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <span class="project-name"
            >上海临港景鸿安全防范科技发展有限公司网站系统</span
          >
          <span class="entry-date">2025.07 - 2025.09</span>
        </div>
        <div class="project-meta">
          独立设计并完成的网站系统项目 · 全栈开发、AI 集成、安全架构 · 成果展示：<a
            href="https://www.lingangjh.com"
            target="_blank" rel="noopener noreferrer">www.lingangjh.com</a
          >
        </div>
        <ul class="project-points">
          <li>
            <strong>全栈开发与性能优化：</strong>基于 Next.js 独立完成企业官网全栈开发，配合 CMS 后台实现内容自主管理，首屏加载时间控制在 1.5s 以内。
          </li>
          <li>
            <strong>AI 问答助手落地：</strong>本地化部署文心大模型及 Qwen 大模型智能问答助手 Weknora，搭建 RAG 知识检索管道，实现企业知识库的高效问答交互，回答准确率 > 85%。
          </li>
          <li>
            <strong>安全架构设计：</strong>设计 Prisma 数据库模型，实现 JWT 用户认证、RLS 数据隔离、CSP 安全策略，保障系统数据安全与访问控制。
          </li>
        </ul>
      </div>

    </section>

    <section>
      <h2>技术栈</h2>
      <div class="skills-row">
        <span class="skills-label">前端开发：</span>
        <span class="skills-content">TypeScript / React / Next.js / Tailwind CSS / 响应式与移动端适配</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">后端 &amp; 数据库：</span>
        <span class="skills-content">Node.js / Prisma / PostgreSQL / RESTful API / JWT 认证</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">AI &amp; 大模型：</span>
        <span class="skills-content">大模型集成 / RAG 检索增强 / AI 工作流设计 / Claude Code / Codex 驱动开发</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">运维 &amp; 部署：</span>
        <span class="skills-content">Linux / Docker / Nginx / CDN / 域名备案 / 成本控制与资源优化</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">安全 &amp; 合规：</span>
        <span class="skills-content">CSP / RLS / JWT / 等保基础 / 项目备案与技术合规</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">UI/UX 设计：</span>
        <span class="skills-content">Figma / 品牌视觉系统 / 交互原型 / 设计至代码落地</span>
      </div>
    </section>

    <section>
      <h2>获奖及证书</h2>
      <div class="award-row">
        <span class="award-name"
          >上海市"星光计划"职业院校技能竞赛"网站技术"三等奖（上海市第 16 名）</span
        ><span class="award-date">2025.05</span>
      </div>
      <div class="award-row">
        <span class="award-name"
          >人社部"职业技能等级证书"计算机程序设计员 三级（高级）（竞赛）</span
        ><span class="award-date">2025.05</span>
      </div>
      <div class="award-row">
        <span class="award-name"
          >国家信息安全水平考试二级（NISP）</span
        ><span class="award-date">2025.05</span>
      </div>
      <div class="award-row">
        <span class="award-name"
          >中国电子学会专业技术证书：青少年软件编程指导教师（Python）</span
        ><span class="award-date">2024.11</span>
      </div>
      <div class="award-row">
        <span class="award-name"
          >天翼云高级运维工程师认证 &amp; 天翼云高级开发工程师认证（SCCP）</span
        ><span class="award-date">2024.05 &amp; 2024.11</span>
      </div>
      <div class="award-row">
        <span class="award-name">阿里云 ACA 云安全助理工程师认证</span><span
          class="award-date">2024.10</span
        >
      </div>
    </section>

    <section>
      <h2>其它</h2>
      <div class="award-row">
        <span class="award-name"
          >SCITE 大学信息技术 + 数字媒体基础（通过等级：优秀），及熟练使用
          Markdown 语言编写文档</span
        >
      </div>
      <div class="award-row">
        <span class="award-name">国家普通话水平测试二级乙等</span>
      </div>
      <div class="award-row">
        <span class="award-name">上海市红十字会初级救护员</span>
      </div>
      <div class="award-row">
        <span class="award-name">大学英语四级考试（CET-4）</span>
      </div>
      <div class="award-row">
        <span class="award-name">Google Developer Group 社区成员</span>
      </div>
    </section>
  </div>
</Layout>
