---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="王泓坤 - 简历" lang="zh-CN">
  <style>
    body {
      font-family: "Times New Roman", "Noto Serif SC", SimSun, serif;
      background: var(--background);
      color: var(--text-color);
      line-height: 1.5;
    }
    .container {
      max-width: 800px;
      margin: 40px auto;
      padding: 0 40px;
    }
    header {
      text-align: center;
      margin-bottom: 25px;
      padding-bottom: 20px;
      border-bottom: 1px solid transparent;
      background-image:
        linear-gradient(var(--background), var(--background)),
        linear-gradient(
          90deg,
          transparent,
          var(--header-line-color) 20%,
          var(--header-line-color) 80%,
          transparent
        );
      background-origin: padding-box, border-box;
      background-clip: padding-box, border-box;
    }
    h1 {
      font-size: 26px;
      font-weight: 700;
      margin: 0 0 8px 0;
      letter-spacing: 2px;
    }
    .contact-info {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 10px;
      font-size: 13px;
      color: var(--light-text);
    }
    .contact-item a {
      color: var(--link-color);
      text-decoration: none;
    }
    section {
      margin-bottom: 20px;
    }
    h2 {
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin: 0 0 12px 0;
      padding-bottom: 5px;
      border-bottom: 1px solid var(--primary-color);
    }
    .entry {
      margin-bottom: 16px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border-color);
    }
    .entry:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }
    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 6px;
    }
    .entry-org {
      font-weight: 700;
      font-size: 15px;
      color: var(--text-color);
    }
    .entry-date {
      font-size: 13px;
      color: var(--light-text);
    }
    .entry-major {
      font-size: 13px;
      color: var(--text-color);
      margin-bottom: 3px;
    }
    .entry-school {
      font-size: 12px;
      color: var(--light-text);
    }
    .entry-role {
      font-size: 14px;
      color: var(--text-color);
      font-weight: 500;
      margin-bottom: 4px;
    }
    .entry-desc {
      font-size: 13px;
      color: var(--tag-text);
      margin: 6px 0 0 0;
      padding-left: 10px;
      border-left: 1px solid var(--border-color);
      line-height: 1.6;
    }
    .entry-title-group {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .edu-icon {
      color: var(--link-color);
      font-size: 15px;
    }
    .uni-logo {
      height: 18px;
      width: 18px;
      object-fit: contain;
      vertical-align: text-bottom;
      margin-right: 4px;
    }
    .status-tag {
      font-size: 11px;
      background: var(--tag-bg);
      color: var(--link-color);
      padding: 1px 6px;
      border-radius: 3px;
      font-weight: 500;
      border: 1px solid var(--tag-border);
    }
    .entry-sub-info {
      display: flex;
      align-items: center;
      gap: 15px;
      margin-top: 2px;
    }
    .entry-major {
      font-size: 14px;
      color: var(--text-color);
      font-weight: 500;
      margin-top: 2px;
    }
    .project-entry {
      margin-bottom: 18px;
      padding-bottom: 15px;
      border-bottom: 1px dotted var(--border-color);
    }
    .project-entry:last-child {
      border-bottom: none;
    }
    .project-name {
      font-weight: 700;
      font-size: 15px;
      color: var(--text-color);
    }
    .project-role {
      font-size: 13px;
      color: var(--tag-text);
      margin-left: 10px;
    }
    .project-meta {
      font-size: 12px;
      color: var(--light-text);
      margin: 4px 0 8px 0;
    }
    .project-meta a {
      color: var(--link-color);
      text-decoration: none;
    }
    .project-abstract {
      font-size: 13px;
      color: var(--text-color);
      margin: 8px 0;
      padding-left: 12px;
      border-left: 2px solid var(--border-color);
    }
    .project-points {
      margin: 8px 0 0 0;
      padding-left: 18px;
    }
    .project-points li {
      font-size: 13px;
      margin-bottom: 4px;
      color: var(--text-color);
    }
    .tech-tags {
      margin-top: 8px;
    }
    .tech-tag {
      display: inline-block;
      font-size: 11px;
      background: var(--tag-bg);
      color: var(--tag-text);
      padding: 2px 8px;
      margin-right: 5px;
      margin-bottom: 4px;
      border: 1px solid var(--tag-border);
    }
    .skills-row {
      display: flex;
      margin-bottom: 6px;
      font-size: 13px;
    }
    .skills-label {
      width: 85px;
      font-weight: 600;
      color: var(--text-color);
      flex-shrink: 0;
    }
    .skills-content {
      color: var(--light-text);
    }
    .award-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 13px;
      margin-bottom: 5px;
    }
    .award-name {
      color: var(--text-color);
    }
    .award-date {
      color: var(--light-text);
    }
    .other-list {
      margin: 0;
      padding-left: 18px;
    }
    .other-list li {
      font-size: 13px;
      margin-bottom: 4px;
      color: var(--text-color);
    }
    /* 超大屏幕 */
    @media (min-width: 1400px) {
      .container {
        max-width: 900px;
      }
      body {
        font-size: 16px;
        line-height: 1.6;
      }
      h1 {
        font-size: 32px;
      }
      h2 {
        font-size: 16px;
      }
      .contact-info {
        font-size: 14px;
        gap: 28px;
      }
      .entry-title,
      .project-name {
        font-size: 16px;
      }
      .entry-date,
      .project-role {
        font-size: 14px;
      }
      .entry-desc,
      .project-abstract,
      .project-points li,
      .skills-row,
      .award-row,
      .other-list li {
        font-size: 14px;
      }
      .project-meta {
        font-size: 13px;
      }
      .tech-tag {
        font-size: 12px;
        padding: 3px 10px;
      }
      .skills-label {
        width: 100px;
      }
    }
    /* 大屏幕 */
    @media (min-width: 1200px) and (max-width: 1399px) {
      .container {
        max-width: 850px;
      }
      h1 {
        font-size: 28px;
      }
      h2 {
        font-size: 15px;
      }
      .contact-info {
        font-size: 14px;
        gap: 24px;
      }
      .entry-title,
      .project-name {
        font-size: 15px;
      }
      .entry-desc,
      .project-abstract,
      .project-points li {
        font-size: 14px;
      }
    }
    /* 中等屏幕 */
    @media (min-width: 900px) and (max-width: 1199px) {
      .container {
        max-width: 820px;
      }
    }
    /* 平板适配 */
    @media (max-width: 768px) {
      .container {
        padding: 0 30px;
      }
      .skills-row {
        flex-wrap: wrap;
      }
      .skills-label {
        width: 100%;
        margin-bottom: 4px;
      }
      .award-row {
        gap: 5px;
      }
    }
    /* 手机适配 */
    @media (max-width: 600px) {
      .container {
        margin: 20px auto;
        padding: 0 16px;
      }
      h1 {
        font-size: 22px;
        letter-spacing: 1px;
      }
      h2 {
        font-size: 13px;
      }
      .contact-info {
        flex-direction: column;
        align-items: center;
        gap: 6px;
      }
      .entry-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 2px;
      }
      .entry-org {
        font-size: 14px;
      }
      .entry-date {
        margin-top: 2px;
        font-size: 12px;
      }
      .entry-major {
        font-size: 13px;
      }
      .entry-school {
        font-size: 12px;
      }
      .entry-role {
        font-size: 13px;
      }
      .project-name {
        font-size: 13px;
      }
      .project-role {
        display: block;
        margin-left: 0;
        margin-top: 2px;
      }
      .project-meta {
        font-size: 11px;
        line-height: 1.6;
      }
      .project-abstract {
        padding-left: 10px;
        font-size: 12px;
      }
      .project-points {
        padding-left: 16px;
      }
      .project-points li {
        font-size: 12px;
      }
      .tech-tag {
        font-size: 10px;
        padding: 2px 6px;
      }
      .skills-row {
        flex-direction: column;
        font-size: 12px;
      }
      .skills-label {
        width: 100%;
        margin-bottom: 3px;
      }
      .skills-content {
        padding-left: 0;
      }
      .award-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 2px;
        font-size: 12px;
      }
      .award-date {
        margin-left: 0;
      }
      .other-list li {
        font-size: 12px;
      }
    }
    /* 超小屏幕 */
    @media (max-width: 380px) {
      .container {
        padding: 0 12px;
      }
      h1 {
        font-size: 20px;
      }
      .contact-info {
        font-size: 12px;
      }
    }
    /* 打印优化 */
    @media print {
      body {
        font-size: 12px;
      }
      .container {
        margin: 0;
        padding: 20px;
        max-width: 100%;
      }
      a {
        color: black;
        text-decoration: none;
      }
      .tech-tag {
        border-color: #999;
      }
      .toggle-projects-btn {
        display: none !important;
      }
      .project-entry.hidden {
        display: block !important;
      }
    }

    .toggle-projects-btn {
      display: block;
      margin: 10px auto 0;
      padding: 6px 20px;
      background: transparent;
      border: 1px solid #ddd;
      color: #666;
      font-size: 13px;
      cursor: pointer;
      border-radius: 20px;
      transition: all 0.2s;
      font-family: inherit;
    }
    .toggle-projects-btn:hover {
      background: var(--hover-bg);
      color: var(--text-color);
      border-color: var(--tag-border);
    }
    .project-entry.hidden {
      display: none;
    }
    .project-entry.no-border {
      border-bottom: none;
    }
    .back-btn {
      position: fixed;
      top: 20px;
      left: 20px;
      text-decoration: none;
      color: #666;
      font-size: 14px;
      z-index: 100;
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 5px;
    }
    .back-btn:hover {
      color: var(--text-color);
    }
    @media print {
      .back-btn {
        display: none;
      }
    }
    @media (max-width: 1100px) {
      .back-btn {
        position: absolute;
        top: 15px;
        left: 15px;
      }
    }
  </style>

  <a href="/" class="back-btn">
    <i class="fas fa-arrow-left"></i> 返回首页
  </a>

  <div class="container">
    <header>
      <h1>王泓坤</h1>
      <div class="contact-info">
        <span class="contact-item">
          <i class="fas fa-envelope"></i>
          <a href="mailto:me@wilboerht.cn">me@wilboerht.cn</a>
        </span>
        <span class="contact-item">
          <i class="fas fa-map-marker-alt"></i>
          上海市 徐汇区
        </span>
        <span class="contact-item">
          <i class="fas fa-globe"></i>
          <a href="https://www.wilboerht.cn" target="_blank">wilboerht.cn</a>
        </span>
        <span class="contact-item">
          <i class="fab fa-github"></i>
          <a href="https://github.com/Wilboerht" target="_blank">GitHub</a>
        </span>
        <span class="contact-item">
          <i class="fab fa-twitter"></i>
          <a href="https://twitter.com/wilboerht" target="_blank">Twitter</a>
        </span>
      </div>
    </header>

    <section>
      <h2>教育背景</h2>
      <div class="entry">
        <div class="entry-header">
          <div class="entry-title-group">
            <span class="entry-org">上海建桥学院</span>
          </div>
          <span class="entry-date">2026.09 - 2028.06</span>
        </div>
        <div class="entry-major">计算机科学与技术专业，信息技术学院，本科</div>
      </div>
      <div class="entry">
        <div class="entry-header">
          <div class="entry-title-group">
            <span class="entry-org">上海科学技术职业学院</span>
          </div>
          <span class="entry-date">2023.10 - 2026.06</span>
        </div>
        <div class="entry-major">
          信息安全技术应用专业，通信与电子工程学院，专科
        </div>
        <p class="entry-desc">
          <i
            class="fas fa-chart-line"
            style="font-size: 13px; margin-right: 4px; color: var(--light-text);"
          ></i>
          GPA: 3.49/4.00 · 专业排名第 7 · 校级优秀学生 & 二等奖学金
        </p>
      </div>
    </section>

    <section>
      <h2>工作经历</h2>
      <div class="entry">
        <div class="entry-header">
          <span class="entry-org"
            >穆埃达思 Moidas —— NIHPLOD 事业部（中国）</span
          >
          <span class="entry-date">2025.10 - 2026.06</span>
        </div>
        <div class="entry-role">AI 应用全栈开发工程师</div>
        <p class="entry-desc">
          设计并实现 NIHPLOD H5
          核销系统、旎柏中国区官网、达人合作效率平台等多个商业项目
        </p>
      </div>
      <div class="entry">
        <div class="entry-header">
          <span class="entry-org">上海临港景鸿安全防范科技发展有限公司</span>
          <span class="entry-date">2025.07 - 2025.09</span>
        </div>
        <div class="entry-role">技术研发实习生</div>
        <p class="entry-desc">
          独立完成公司官网系统全栈开发上线，包括 CMS
          后台、招聘管理系统及安全体系建设
        </p>
      </div>
    </section>

    <section>
      <h2>项目经历</h2>

      <div class="project-entry">
        <div class="entry-header">
          <span class="project-name"
            >MySkin.Today — AI 多模态智能测肤 SaaS 平台 及 项目网站</span
          >
          <span class="project-role">产品设计 & AI 全栈开发负责人</span>
        </div>
        <div class="project-meta">
          <a href="https://myskin.today" target="_blank">myskin.today</a> ·
          <a href="https://github.com/Wilboerht" target="_blank">GitHub</a> · 2025.12
          - 至今
        </div>
        <p class="project-abstract">
          赋能护肤行业的 AI 多模态测肤 SaaS，兼容 C 端直面消费者 (DTC)
          模式，通过「拍照 + 问卷 + 环境数据」三维输入，生成临床级精度 8
          维度评分与区域诊断。设计了 Guest (周限1次) → Member (解锁报告) → VIP
          (AR热力图/日限5次) 三级增长漏斗，基于浏览器指纹追踪实现「诊断 → 推荐 →
          裂变」商业闭环。
        </p>
        <ul class="project-points">
          <li>
            <strong>多模型 AI 视觉编排：</strong>搭建 5 服务商（OpenAI /
            Anthropic / Gemini / Qwen / DeepSeek）网关，支持多 Key
            轮询、预定义自动降级链路与 CMS 热切换；实现「图像自适应缩放(1024px)
            → 视觉分析 → 问卷融合」混合流水线；设计 AI 请求队列控制并发（视觉 3
            / 聊天 10）与排队反馈，对抗大模型限流与延迟。
          </li>
          <li>
            <strong>边缘计算与高性能前端：</strong>集成 MediaPipe Face Mesh
            (WASM)，浏览器端提取 468 特征点，实现零 GPU 成本 VIP 专属 AR
            实时热力图（~900 三角形网格重构 + HSL 插值）；封装
            <code>useAsyncAnalysis</code>
            两阶段状态机 (Face → Skin) 配合指数退避重试机制，平滑处理大模型长时推理。
          </li>
          <li>
            <strong>全栈架构与安全体系：</strong>基于 Prisma 7 + PostgreSQL
            (Supabase) 设计 15+ 模型 Schema；构建三层防护：JWT 认证 + LRU
            内存速率限制（防暴破 5次/15min、API 100次/min）+ FingerprintJS
            指纹防刷（IP / Cookie / 设备交叉匹配与置信度评分）；自建 CMS
            后台实现 Prompt 热更新与运营监控。
          </li>
          <li>
            <strong>科学护肤推荐算法：</strong>主导自研 Dermatologist
            Grade（联合护肤顾问团队）
            算法（~1000行），融合肤质、BioFactors（压力/生理周期）与实时环境因子（UV/湿度），生成三级方案
            × 四场景推荐；输出 28 天 Skin Cycling 护理日历（视黄醇 → 酸类 → 修护
            → 屏障日 轮替策略）。
          </li>
          <li>
            <strong>产品知识图谱引擎：</strong
            >构建基于成分与功效标签的匹配引擎，将 AI 诊断结果（肤质 + 关注点 +
            年龄）动态映射为 Daily / Advanced / Ultimate
            分级产品组合，并根据环境因子（如高紫外线加权防晒）动态调整推荐排序。
          </li>
        </ul>
        <div class="tech-tags">
          <span class="tech-tag">Next.js 16</span>
          <span class="tech-tag">React 19</span>
          <span class="tech-tag">TypeScript</span>
          <span class="tech-tag">MediaPipe WASM</span>
          <span class="tech-tag">GPT-4o / Claude 3.5</span>
          <span class="tech-tag">Prisma 7</span>
          <span class="tech-tag">PostgreSQL</span>
          <span class="tech-tag">Supabase</span>
          <span class="tech-tag">TailwindCSS 4</span>
          <span class="tech-tag">Framer Motion</span>
        </div>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <span class="project-name">NIHPLOD 中国区官网</span>
          <span class="project-role">全栈开发 & 项目设计</span>
        </div>
        <div class="project-meta">
          <a href="https://www.nihplod.cn" target="_blank">www.nihplod.cn</a> · 2025.12
          - 2026.01
        </div>
        <p class="project-abstract">
          独立完成高端护肤品牌中国区官网的产品设计与全栈开发，交付涵盖品牌展示、AI
          护肤顾问、CMS 管理后台的完整系统。
        </p>
        <ul class="project-points">
          <li>
            <strong>全栈开发：</strong>基于 Next.js 14 App Router + React 18 +
            TypeScript 构建，后端采用 API Routes + Prisma + PostgreSQL；自建 CMS
            管理后台，集成 JWT 认证、产品管理、媒体库及 AI 配置功能。
          </li>
          <li>
            <strong>AI 与体验：</strong>集成 OpenAI API 实现智能肤质分析，设计
            Prompt 策略确保专业性；结合 Framer Motion + GSAP
            打造毛玻璃、悬浮卡片等高端动效与 6 步问答交互体验。
          </li>
          <li>
            <strong>产品设计：</strong>主导 AI
            护肤顾问规划，完成竞品分析（Aesop、Le Labo）与 PRD
            撰写，设计“问答交互 → 肌肤分析 → 护肤建议 →
            产品推荐”的完整用户旅程。
          </li>
        </ul>
        <div class="tech-tags">
          <span class="tech-tag">Next.js 14</span><span class="tech-tag"
            >TypeScript</span
          ><span class="tech-tag">React 18</span><span class="tech-tag"
            >Prisma</span
          ><span class="tech-tag">PostgreSQL</span><span class="tech-tag"
            >OpenAI API</span
          ><span class="tech-tag">Framer Motion</span><span class="tech-tag"
            >GSAP</span
          ><span class="tech-tag">Tailwind CSS</span>
        </div>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <span class="project-name">NIHPLOD H5 核销系统</span>
          <span class="project-role">全栈开发</span>
        </div>
        <div class="project-meta">2025.10 - 2025.11</div>
        <p class="project-abstract">
          面向会员的核销平台，支持女王卡、黑曜卡、SPA券等多种卡券的管理与核销，已上线生产环境。
        </p>
        <ul class="project-points">
