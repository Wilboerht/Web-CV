---
import Layout from "../layouts/Layout.astro";
import PrintFooter from "../components/PrintFooter.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MermaidDiagram from "../components/MermaidDiagram.astro";
import { moidasArchitecture } from "../diagrams/moidas-architecture";
import "../styles/global.css";
import "../styles/cv.css";

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://cv.wilboerht.com/CV-cn/#page",
  "url": "https://cv.wilboerht.com/CV-cn/",
  "inLanguage": "zh-CN",
  "dateModified": new Date().toISOString(),
  "mainEntity": {
    "@type": "Person",
    "@id": "https://www.wilboerht.com/#person",
    "name": "王泓坤",
    "alternateName": "Hongkun Wang",
    "givenName": "泓坤",
    "familyName": "王",
    "description": "数字开发经理、全栈工程师（TypeScript / React / Next.js / AI / RAG），常驻上海。作为品牌大中华区首位工程师，从 0 到 1 搭建品牌官网、会员体系与积分、统一认证（SSO）、AI 顾问与智能客服等数字系统。",
    "email": "me@wilboerht.cn",
    "url": "https://www.wilboerht.com",
    "image": "https://cv.wilboerht.com/og-image.png",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "上海",
      "addressCountry": "CN"
    },
    "sameAs": [
      "https://github.com/Wilboerht",
      "https://twitter.com/wilboerht"
    ],
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "上海科学技术职业学院"
      }
    ],
    "knowsAbout": [
      "TypeScript",
      "React",
      "Next.js",
      "Vue 3",
      "Node.js",
      "FastAPI",
      "Prisma",
      "PostgreSQL",
      "Redis",
      "Large Language Models",
      "RAG",
      "Docker",
      "Linux"
    ],
    "jobTitle": "数字开发经理",
    "worksFor": {
      "@type": "Organization",
      "name": "穆埃达思 Moidas",
      "url": "https://www.nihplod.cn"
    },
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": "上海市“星光计划”职业院校技能竞赛“网站技术”三等奖（上海市第 16 名）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "人社部“职业技能等级证书”计算机程序设计员 三级（高级）（竞赛）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "国家信息安全水平考试二级（NISP）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "天翼云高级开发工程师认证（SCCP）",
        "dateCreated": "2024-11"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "阿里云 ACA 云安全助理工程师认证",
        "dateCreated": "2024-10"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "天翼云高级运维工程师认证",
        "dateCreated": "2024-05"
      }
    ],
    "award": "上海市“星光计划”职业院校技能竞赛“网站技术”三等奖"
  }
};
---

<Layout title="王泓坤 - 简历" lang="zh-CN">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld, null, 2)} />
  </Fragment>
  <style>
    :root {
      --cv-font-body: 'Source Serif 4', 'Noto Serif SC', serif;
    }
  </style>

  <div class="container">
    <header>
      <h1>王泓坤</h1>
      <p class="tagline">数字开发经理 · 全栈工程师 · 上海</p>
      <div class="contact-info">
        <span class="contact-item"><a href="mailto:me@wilboerht.cn">me@wilboerht.cn</a></span>
        <span class="contact-item"><a href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer">GitHub</a></span>
        <span class="contact-item"><a href="https://www.wilboerht.com" target="_blank" rel="noopener noreferrer">wilboerht.com</a></span>
      </div>
    </header>

    <section>
      <h2>工作经历</h2>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">穆埃达思 Moidas · 旎柏（大中华区）事业部</h3>
          <div class="entry-meta">
            <span class="entry-role">数字开发经理</span>
            <span class="entry-date">2025.10 – 至今</span>
          </div>
        </div>
        <p class="entry-summary">
          2025.10 以实习生加入，2026.07 转正并直接汇报品牌负责人；作为事业部首位技术人员，以产品思维和 AI 辅助研发独立完成从需求、设计到开发、上线的全栈交付，12 个月内从 0 到 1 交付 7 个核心系统及 2100+ 自动化测试用例，并以统一账号与档案数据打通「测肤 → 个性化方案 → AI 顾问跟进 → 复购」业务闭环。
        </p>
        <ul class="project-points">
          <li>负责品牌大中华区数字化产品矩阵的规划、技术选型与全栈交付，统筹 7 个核心系统从需求、设计、开发到上线运维的完整生命周期。</li>
          <li>参与品牌大中华区会员体系制定，联合品牌与运营团队设计四档会员等级、权益、积分与兑礼规则，并落地官网 / 小程序会员中心，支撑会员留存与复购。</li>
          <li>建立 AI 辅助研发工作流与设计规范，将平均交付周期压缩 50% 以上，保障多项目并行交付。</li>
          <li>作为技术侧负责人承接产品、营销团队需求并拆解排期，主导需求评审与迭代节奏，支撑品牌线上零售渠道（中国官网）从 0 上线。</li>
          <li>主导 ICP 备案、隐私政策及用户协议制定，完成数据合规审查，保障多系统合规上线；依据流量动态调整服务器资源配置，实现成本优化。</li>
        </ul>
        <MermaidDiagram
          code={moidasArchitecture.cn}
          alt="穆埃达思 Moidas 大中华区数字化系统架构图：统一认证（SSO）连接官网、AI 测肤、AI 客服与授权验真等核心系统"
          zoomLabel="点击放大查看"
          closeLabel="关闭"
        />
      </div>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">上海临港景鸿安全防范科技发展有限公司</h3>
          <div class="entry-meta">
            <span class="entry-role">技术研发实习生</span>
            <span class="entry-date">2025.07 – 2025.09</span>
          </div>
        </div>
        <ul class="project-points">
          <li>独立承担企业官网全链路交付，覆盖从架构设计、UI/UX 设计到生产部署全过程。</li>
          <li>基于宇树机器狗 SDK 二次开发，完成园区巡逻管理控制平台内部初版并验证产品可行性。</li>
          <li>推动 AI 问答助手在企业内部首次落地，参与企业与百度官方企业问答团队对接业务工作。</li>
        </ul>
      </div>
    </section>

    <section>
      <div class="project-section-head">
        <h2>项目经历</h2>
        <a class="project-github-link" href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer" aria-label="去 GitHub 查看更多">
          <svg class="project-github-link__icon" aria-hidden="true"><use href="#icon-github"></use></svg>
          去 GitHub 查看更多
        </a>
      </div>

      <div class="project-entry" id="project-website">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-website" aria-haspopup="dialog">NIHPLOD 中国官网</button></h3>
          <span class="entry-date">2025.11 – 至今</span>
        </div>
        <div class="project-meta">
          独立完成 · 产品 / UI/UX / 全栈 · <a href="https://www.nihplod.cn" target="_blank" rel="noopener noreferrer">nihplod.cn ↗</a>
        </div>
        <p class="project-summary">品牌在中国市场的官网与会员中台：整合产品展示、电商导购、会员积分与测肤档案，统一微信 / 抖音 / 手机号多端账号；从 0 到 1 支撑品牌线上零售与复购，169 API / 43 模型 / 1725 测试。</p>
        <button type="button" class="project-more" data-project-dialog="project-website" aria-haspopup="dialog" aria-label="查看详情：NIHPLOD 中国官网"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>查看详情</button>
        <dialog class="project-dialog" id="dialog-project-website">
          <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="关闭">&times;</button>
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
            </div>
            <div class="project-dialog__content">
            <ul class="project-points">
              <li>
                <strong>品牌官网与会员中台：</strong>基于 Next.js 16 + Prisma + PostgreSQL 构建品牌官网、产品陈列与第三方电商导购（天猫 / 抖音 / 小红书外链 + GA 事件追踪），并落地会员等级、积分账本、积分兑礼（顺丰物流轨迹）、消费补录、测肤档案与安全中心；聚合微信、抖音、手机号验证码多端身份至统一账号体系；全站 169 个 API 路由、43 个数据模型、1725 个自动化测试用例。
              </li>
              <li>
                <strong>产品与交互设计：</strong>从信息架构、Figma 交互原型到视觉样式全程独立设计，基于 Framer Motion + View Transitions 实现多步骤护肤仪式指南与沉浸式品牌叙事，集成产品抽屉与详情页联动，全端响应式适配。
              </li>
              <li>
                <strong>运营后台与安全治理：</strong>搭建覆盖产品 / 分类 / 会员 / 积分兑礼 / 消费补录 / 职位 / 消息 / OAuth 客户端的运营后台（Tiptap 富文本），配套 TOTP 二因素与敏感操作 Step-up 验证、操作审计与每日完整性锚点、定时任务、数据库持久化限流及 Webhook 失败重投；完成 SEO / GEO（sitemap / JSON-LD / llms.txt / 百度推送）。
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

      <div class="project-entry" id="project-sso">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-sso" aria-haspopup="dialog">NIHPLOD 统一认证平台（SSO / OIDC）</button></h3>
          <span class="entry-date">2026.06 – 至今</span>
        </div>
        <div class="project-meta">
          独立完成 · 产品 / 全栈
        </div>
        <p class="project-summary">品牌大中华区的统一身份底座：自建 OAuth 2.0 / OIDC 单点登录，打通官网、测肤站、双小程序与管理端的账号与登录状态；支撑 5 个系统跨域免登、全局登出与二因素验证，并沉淀为可复用 npm SDK。</p>
        <button type="button" class="project-more" data-project-dialog="project-sso" aria-haspopup="dialog" aria-label="查看详情：NIHPLOD 统一认证平台（SSO / OIDC）"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>查看详情</button>
        <dialog class="project-dialog" id="dialog-project-sso">
          <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="关闭">&times;</button>
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
            </div>
            <div class="project-dialog__content">
            <ul class="project-points">
              <li>
                <strong>协议实现：</strong>自建 OAuth 2.0 / OIDC 单点登录，与官网主站同构部署，主站作为 Authorization Server 签发 JWT（RS256），完整实现 authorize / token / userinfo / introspect / revoke / end-session 协议端点，支持 PKCE、DPoP 与 TOTP 二因素。
              </li>
              <li>
                <strong>SDK 与接入：</strong>封装并发布 npm SDK（@nihplod/sso-sdk / @nihplod/sso-verify）供子项目分钟级接入，通过 Token Introspection + Backchannel Logout 实现跨域免登与全局登出，支撑官网、测肤站、微信双小程序及管理端统一登录。
              </li>
              <li>
                <strong>安全加固：</strong>支持密钥轮换、Token 撤销（RFC 7009）与多实例黑名单共享，保障认证体系可运维、可审计。
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

      <div class="project-entry" id="project-ai-advisor">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-ai-advisor" aria-haspopup="dialog">AI 护肤顾问系统</button></h3>
          <span class="entry-date">2026.01 – 至今</span>
        </div>
        <div class="project-meta">
          独立完成 · 产品 / UX / 全栈 · UI 视觉协作 · <a href="https://advisor.nihplod.cn" target="_blank" rel="noopener noreferrer">advisor.nihplod.cn ↗</a>
        </div>
        <p class="project-summary">面向消费者的 AI 护肤顾问：以「问卷 + 扫脸」双通道完成皮肤分析，结合肤质 / 季节 / 地域规则生成个性化产品方案，并将报告与档案透传至企微顾问，形成「测肤 → 方案 → 跟进 → 复购」闭环；85 API / 426 测试。</p>
        <button type="button" class="project-more" data-project-dialog="project-ai-advisor" aria-haspopup="dialog" aria-label="查看详情：AI 护肤顾问系统"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>查看详情</button>
        <dialog class="project-dialog" id="dialog-project-ai-advisor">
          <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="关闭">&times;</button>
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
            </div>
            <div class="project-dialog__content">
            <ul class="project-points">
              <li>
                <strong>AI 测肤与个性化推荐：</strong>接入通义千问 VL / DeepSeek 大模型实现「问卷 + 扫脸」双通道皮肤分析；自研规则引擎按 8 种肤质画像与季节 / 地域环境因子打分匹配产品，支持后台可视化配置（运营零代码调整）。
              </li>
              <li>
                <strong>转化与归因：</strong>主导模型集成与核心接口开发；电商外链（天猫 / 抖音 / 小红书）支持 UTM / pid 追踪与点击事件埋点，结合企微顾问短链形成可归因的咨询转化链路。
              </li>
              <li>
                <strong>增长与会员运营：</strong>打通四档会员测肤配额（普通 10 次、银卡按消费解锁、金卡 / 钻石不限量），以登录账号承接报告与档案；设计分享海报、渠道 ref 归因与注册转化弹窗，并输出脱敏群体统计 CSV 反哺品牌白皮书与市场洞察。
              </li>
              <li>
                <strong>AI 成本与稳定性工程：</strong>设计 AI 请求队列与并发控制、熔断器、日/月 Token 与费用预算熔断、调用计费持久化、模型白名单与 Provider 回退；以失败重试幂等与额度预占 / 释放规避重复扣费；报告采用 90 天滚动有效期 + 冷热分层归档（冷层脱敏摘要）。
              </li>
              <li>
                <strong>数据资产闭环：</strong>设计 HMAC 签名 + IP 限流的服务端间接口，测肤报告与护肤档案随 session_id 一键透传至企微 AI 客服，将一次性测肤沉淀为可持续运营、可驱动复购的用户数据资产。
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

    </section>

    <section>
      <h2>技术栈</h2>
      <div class="skills-row">
        <span class="skills-label">前端开发：</span>
        <span class="skills-content">TypeScript / React / Next.js / Vue 3 / uni-app / 微信小程序（原生 / TypeScript）/ Tailwind CSS / Canvas 2D / 响应式与移动端适配</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">后端 &amp; 数据库：</span>
        <span class="skills-content">Node.js / Python (FastAPI) / Prisma / PostgreSQL / Redis / RESTful API / JWT · OAuth 2.0 · OIDC</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">AI &amp; 大模型：</span>
        <span class="skills-content">大模型集成 / 视觉模型测肤 / RAG 检索增强 / AI 成本工程（熔断与预算控制）/ Claude Code / Codex 驱动开发</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">运维 &amp; 部署：</span>
        <span class="skills-content">Linux / Docker / Nginx / CDN / ICP 备案 / 成本控制与资源优化</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">安全 &amp; 合规：</span>
        <span class="skills-content">CSP / RLS / 信息安全基线 / 隐私政策与数据合规</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">UI/UX 设计：</span>
        <span class="skills-content">Figma / 品牌视觉系统 / 交互原型 / 设计及代码实现</span>
      </div>
    </section>

    <section>
      <h2>获奖及证书</h2>
      <div class="award-row">
        <span class="award-name"
          >上海市"星光计划"职业院校技能竞赛"网站技术"三等奖（上海市第 16 名）</span
        ><span class="award-date">2025.05</span>
      </div>
