---
import Layout from "../layouts/Layout.astro";
import PrintFooter from "../components/PrintFooter.astro";
import "../styles/global.css";
import "../styles/cv.css";
---

<Layout title="王泓坤 - 简历" lang="zh-CN">
  <slot name="head">
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "王泓坤",
        "alternateName": "Hongkun Wang",
        "givenName": "泓坤",
        "familyName": "王",
        "email": "me@wilboerht.cn",
        "telephone": "+8618721400154",
        "url": "https://www.wilboerht.com",
        "sameAs": [
          "https://github.com/Wilboerht",
          "https://twitter.com/wilboerht"
        ],
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "上海科学技术职业学院"
        },
        "knowsAbout": [
          "TypeScript",
          "React",
          "Next.js",
          "Node.js",
          "Prisma",
          "PostgreSQL",
          "Large Language Models",
          "RAG",
          "Docker",
          "Linux"
        ],
        "jobTitle": "数字开发经理",
        "worksFor": {
          "@type": "Organization",
          "name": "穆埃达思 Moidas"
        }
      }
    </script>
  </slot>
  <style>
    :root {
      --cv-font-body: 'Noto Serif SC', 'Source Serif 4', serif;
    }
  </style>

  <div class="container">
    <header>
      <h1>王泓坤</h1>
      <div class="contact-info">
        <span class="contact-item"><a href="mailto:me@wilboerht.cn">me@wilboerht.cn</a></span>
        <span class="contact-item"><a href="tel:+8618721400154">+86 187 2140 0154</a></span>
        <span class="contact-item"><a href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer">GitHub</a></span>
        <span class="contact-item"><a href="https://www.wilboerht.com" target="_blank" rel="noopener noreferrer">wilboerht.com</a></span>
      </div>
    </header>

    <section>
      <h2>工作经历</h2>
      <div class="entry">
        <div class="entry-header">
          <span class="entry-org"
            >穆埃达思 Moidas | 旎柏事业部 —— 数字开发经理</span
          >
          <span class="entry-date">2025.10 – 至今</span>
        </div>
        <p class="entry-role-detail">
          2025.10 以实习生身份加入并于毕业前全职在岗，2026.07 转正；直接汇报品牌方负责人。
        </p>
        <ul class="project-points">
          <li>统筹品牌大中华区数字化产品矩阵的规划与交付，覆盖官网、微信商城、授权验真、AI 护肤顾问等 6+ 核心系统。</li>
          <li>建立 AI 辅助研发工作流与设计规范，将平均交付周期压缩 50% 以上，保障多项目并行交付。</li>
          <li>作为技术侧负责人对接产品、营销团队，建立快速迭代响应机制，支撑品牌线上业务增长。</li>
        </ul>
      </div>
      <div class="entry">
        <div class="entry-header">
          <span class="entry-org"
            >上海临港景鸿安全防范科技发展有限公司 —— 技术研发实习生</span
          >
          <span class="entry-date">2025.07 - 2025.09</span>
        </div>
        <ul class="project-points">
          <li>独立承担企业官网全链路交付，覆盖从架构设计、UI/UX 设计到生产部署全过程。</li>
          <li>基于宇树机器狗 SDK 二次开发，完成园区巡逻管理控制平台内部初版并验证产品可行性。</li>
          <li>推动 AI 问答助手在企业内部首次落地，作为企业代表与百度官方企业问答团队对接业务合作。</li>
        </ul>
      </div>
    </section>

    <section>
      <h2>项目经历</h2>

      <div class="project-entry">
        <div class="entry-header">
          <span class="project-name">旎柏（NIHPLOD）中国官方数字化平台</span>
          <span class="entry-date">2025.11 – 至今</span>
        </div>
        <div class="project-meta">
          成果展示：<a
            href="https://www.nihplod.cn"
            target="_blank" rel="noopener noreferrer">www.nihplod.cn</a
          >、<a href="https://advisor.nihplod.cn" target="_blank" rel="noopener noreferrer"
            >advisor.nihplod.cn</a
          > 等
        </div>
        <p class="project-abstract">
          作为技术负责人，主导品牌大中华区 6+ 数字化系统的架构设计、开发与合规上线，负责核心模块实现。
        </p>
        <ul class="project-points">
          <li>
            <strong>AI 护肤顾问系统：</strong>基于 RAG 架构构建领域知识库，实现多轮对话与个性化推荐；主导模型集成与核心接口开发，驱动用户咨询转化率提升 30%。
          </li>
          <li>
            <strong>品牌 SSO 体系：</strong>自建 OAuth 2.0 / OIDC 单点登录，主站作为 Authorization Server 签发 JWT，子站通过 Token Introspection + Backchannel Logout 实现跨域免登与全局登出；支持密钥轮换、Token 撤销（RFC 7009）及多实例黑名单共享。
          </li>
          <li>
            <strong>非标交互页面：</strong>基于 Framer Motion + View Transitions 实现多步骤护肤仪式指南与沉浸式品牌叙事，集成产品抽屉与购物车联动，全端响应式适配。
          </li>
          <li>
            <strong>运维与成本治理：</strong>依据业务流量动态调整服务器资源配置，在保障稳定性的前提下实现成本优化。
          </li>
          <li>
            <strong>合规与风险管控：</strong>主导 ICP 备案、隐私政策及用户协议制定，完成数据合规审查，确保产品符合监管要求。
          </li>
          <li>
            <strong>搜索可见性提升：</strong>实施 SEO &amp; GEO 策略，优化搜索引擎收录与生成式引擎引用展示，提升品牌线上曝光。
          </li>
        </ul>

      </div>

      <div class="project-entry">
        <div class="entry-header">
          <span class="project-name"
            >上海临港景鸿安全防范科技发展有限公司网站系统</span
          >
          <span class="entry-date">2025.07 - 2025.09</span>
        </div>
        <div class="project-meta">
          独立完成（全栈） · 成果展示：<a
            href="https://www.lingangjh.com"
            target="_blank" rel="noopener noreferrer">www.lingangjh.com</a
          >
        </div>
        <ul class="project-points">
          <li>
            <strong>全栈开发与性能优化：</strong>基于 Next.js 独立完成企业官网全栈开发，配合 CMS 后台实现内容自主管理，首屏加载时间控制在 1.5s 以内。
          </li>
          <li>
            <strong>UI/UX 设计：</strong>独立完成企业官网视觉系统与交互原型设计，基于 Figma 完成从品牌视觉到界面落地全流程，全端响应式适配。
          </li>
          <li>
            <strong>AI 问答助手落地：</strong>本地化部署文心大模型及 Qwen 大模型智能问答助手 Weknora，搭建 RAG 知识检索管道，实现企业知识库的高效问答交互，回答准确率 > 85%。
          </li>
          <li>
            <strong>安全架构设计：</strong>设计 Prisma 数据库模型，实现 JWT 用户认证、RLS 数据隔离、CSP 安全策略，保障系统数据安全与访问控制。
          </li>
        </ul>
      </div>

    </section>

    <section>
      <h2>技术栈</h2>
      <div class="skills-row">
        <span class="skills-label">前端开发：</span>
        <span class="skills-content">TypeScript / React / Next.js / Tailwind CSS / 响应式与移动端适配</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">后端 &amp; 数据库：</span>
        <span class="skills-content">Node.js / Prisma / PostgreSQL / RESTful API / JWT 认证</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">AI &amp; 大模型：</span>
        <span class="skills-content">大模型集成 / RAG 检索增强 / AI 工作流设计 / Claude Code / Codex 驱动开发</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">运维 &amp; 部署：</span>
        <span class="skills-content">Linux / Docker / Nginx / CDN / 域名备案 / 成本控制与资源优化</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">安全 &amp; 合规：</span>
        <span class="skills-content">CSP / RLS / JWT / 等保基础 / 项目备案与技术合规</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">UI/UX 设计：</span>
        <span class="skills-content">Figma / 品牌视觉系统 / 交互原型 / 设计至代码落地</span>
      </div>
    </section>

    <section>
      <h2>获奖及证书</h2>
      <div class="award-row">
        <span class="award-name"
          >上海市"星光计划"职业院校技能竞赛"网站技术"三等奖（上海市第 16 名）</span
        ><span class="award-date">2025.05</span>
      </div>
      <div class="award-row">
        <span class="award-name"
          >人社部"职业技能等级证书"计算机程序设计员 三级（高级）（竞赛）</span
        ><span class="award-date">2025.05</span>
      </div>
      <div class="award-row">
        <span class="award-name"
          >国家信息安全水平考试二级（NISP）</span
        ><span class="award-date">2025.05</span>
      </div>
      <div class="award-row">
        <span class="award-name">天翼云高级开发工程师认证（SCCP）</span
        ><span class="award-date">2024.11</span>
      </div>
      <div class="award-row">
        <span class="award-name">阿里云 ACA 云安全助理工程师认证</span><span
          class="award-date">2024.10</span
        >
      </div>
      <div class="award-row">
        <span class="award-name">天翼云高级运维工程师认证</span
        ><span class="award-date">2024.05</span>
      </div>
    </section>

    <section>
      <h2>教育背景</h2>
      <div class="entry">
        <div class="entry-header">
          <div class="entry-title-group">
            <span class="entry-org">上海科学技术职业学院</span>
          </div>
          <span class="entry-date">2023.10 - 2026.06</span>
        </div>
        <div class="entry-major">
          通信与电子工程学院，信息安全技术应用专业，专科
        </div>
        <p class="entry-desc">
          <strong>主修课程：</strong>网络安全、程序设计、算法与数据结构、体系结构、操作系统、数据库系统、计算机网络等
        </p>
        <p class="entry-desc" style="margin-top: 4px;">
          <strong>校内获奖：</strong>2023-2025 双学年校二等奖学金，2023-2024 学年校优秀学生，校优秀毕业生
        </p>
        <p class="entry-desc" style="margin-top: 4px;">
          <strong>学业成绩：</strong>GPA: 3.41/4.00
        </p>
        <p class="entry-desc" style="margin-top: 4px;">
          <strong>英语水平：</strong>大学英语四级（CET-4）
        </p>
      </div>
    </section>

    <section>
      <h2>其它</h2>
      <div class="award-row">
        <span class="award-name"
          >SCITE 大学信息技术 + 数字媒体基础（通过等级：优秀），及熟练使用
          Markdown 语言编写文档</span
        >
      </div>
      <div class="award-row">
        <span class="award-name">Google Developer Group 社区成员</span>
      </div>
    </section>
  </div>

  <PrintFooter
    warning="本简历含个人隐私信息，仅限招聘评估使用，未经授权禁止存储、转发或用于其他用途。"
  />
</Layout>
