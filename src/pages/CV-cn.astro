---
import Layout from "../layouts/Layout.astro";
import PrintFooter from "../components/PrintFooter.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MermaidDiagram from "../components/MermaidDiagram.astro";
import { moidasArchitecture } from "../diagrams/moidas-architecture";
import "../styles/global.css";
import "../styles/cv.css";

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://cv.wilboerht.com/CV-cn/#page",
  "url": "https://cv.wilboerht.com/CV-cn/",
  "inLanguage": "zh-CN",
  "dateModified": new Date().toISOString(),
  "mainEntity": {
    "@type": "Person",
    "@id": "https://www.wilboerht.com/#person",
    "name": "王泓坤",
    "alternateName": "Hongkun Wang",
    "givenName": "泓坤",
    "familyName": "王",
    "description": "数字开发经理、全栈工程师（TypeScript / React / Next.js / AI / RAG），常驻上海。作为品牌大中华区首位工程师，从 0 到 1 搭建品牌官网、会员体系与积分、统一认证（SSO）、AI 顾问与智能客服等数字系统。",
    "email": "me@wilboerht.cn",
    "url": "https://www.wilboerht.com",
    "image": "https://cv.wilboerht.com/og-image.png",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "上海",
      "addressCountry": "CN"
    },
    "sameAs": [
      "https://github.com/Wilboerht",
      "https://twitter.com/wilboerht"
    ],
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "上海科学技术职业学院"
      }
    ],
    "knowsAbout": [
      "TypeScript",
      "React",
      "Next.js",
      "Vue 3",
      "Node.js",
      "FastAPI",
      "Prisma",
      "PostgreSQL",
      "Redis",
      "Large Language Models",
      "RAG",
      "Docker",
      "Linux"
    ],
    "jobTitle": "数字开发经理",
    "worksFor": {
      "@type": "Organization",
      "name": "穆埃达思 Moidas",
      "url": "https://www.nihplod.cn"
    },
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": "上海市“星光计划”职业院校技能竞赛“网站技术”三等奖（上海市第 16 名）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "人社部“职业技能等级证书”计算机程序设计员 三级（高级）（竞赛）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "国家信息安全水平考试二级（NISP）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "天翼云高级开发工程师认证（SCCP）",
        "dateCreated": "2024-11"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "阿里云 ACA 云安全助理工程师认证",
        "dateCreated": "2024-10"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "天翼云高级运维工程师认证",
        "dateCreated": "2024-05"
      }
    ],
    "award": "上海市“星光计划”职业院校技能竞赛“网站技术”三等奖"
  }
};
---

<Layout title="王泓坤 - 简历" lang="zh-CN">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld, null, 2)} />
  </Fragment>
  <style>
    :root {
      --cv-font-body: 'Source Serif 4', 'Noto Serif SC', serif;
    }
  </style>

  <div class="container">
    <header>
      <h1>王泓坤</h1>
      <p class="tagline">数字开发经理 · 全栈工程师 · 上海</p>
      <div class="contact-info">
        <span class="contact-item"><a href="mailto:me@wilboerht.cn">me@wilboerht.cn</a></span>
        <span class="contact-item"><a href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer">GitHub</a></span>
        <span class="contact-item"><a href="https://www.wilboerht.com" target="_blank" rel="noopener noreferrer">wilboerht.com</a></span>
      </div>
    </header>

    <section>
      <h2>工作经历</h2>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">穆埃达思 Moidas · 旎柏（大中华区）事业部</h3>
          <div class="entry-meta">
            <span class="entry-role">数字开发经理</span>
            <span class="entry-date">2025.10 – 至今</span>
          </div>
        </div>
        <p class="entry-summary">
          2025.10 以实习生身份加入并于毕业前全职在岗，2026.07 转正，直接汇报品牌负责人；作为事业部首位技术人员，从 0 到 1 冷启动品牌大中华区全部信息系统与数字化基础设施，12 个月内独立完成 7 个核心系统交付，核心系统配套 2100+ 自动化测试用例，并以统一账号与档案数据打通「测肤 → 个性化方案 → 7×24 AI 顾问跟进 → 复购」业务闭环。
        </p>
        <ul class="project-points">
          <li>统筹品牌大中华区数字化产品矩阵的规划与交付，覆盖中国官网、统一认证（SSO）、AI 护肤顾问、微信 AI 客服、授权验真及测肤 / 会员中心双小程序 7 个核心系统。</li>
          <li>参与品牌大中华区会员体系制定，联合品牌与运营团队设计四档会员等级、权益、积分与兑礼规则，并落地官网 / 小程序会员中心，支撑会员留存与复购。</li>
          <li>建立 AI 辅助研发工作流与设计规范，将平均交付周期压缩 50% 以上，保障多项目并行交付。</li>
          <li>作为技术侧负责人承接产品、营销团队需求并拆解排期，主导需求评审与迭代节奏，支撑品牌线上零售渠道（中国官网）从 0 上线。</li>
          <li>主导 ICP 备案、隐私政策及用户协议制定，完成数据合规审查，保障多系统合规上线；依据流量动态调整服务器资源配置，实现成本优化。</li>
        </ul>
        <MermaidDiagram
          code={moidasArchitecture.cn}
          alt="穆埃达思 Moidas 大中华区数字化系统架构图：统一认证（SSO）连接官网、AI 测肤、AI 客服与授权验真等核心系统"
          zoomLabel="点击放大查看"
          closeLabel="关闭"
        />
      </div>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">上海临港景鸿安全防范科技发展有限公司</h3>
          <div class="entry-meta">
            <span class="entry-role">技术研发实习生</span>
            <span class="entry-date">2025.07 – 2025.09</span>
          </div>
        </div>
        <ul class="project-points">
          <li>独立承担企业官网全链路交付，覆盖从架构设计、UI/UX 设计到生产部署全过程。</li>
          <li>基于宇树机器狗 SDK 二次开发，完成园区巡逻管理控制平台内部初版并验证产品可行性。</li>
          <li>推动 AI 问答助手在企业内部首次落地，作为企业代表与百度官方企业问答团队对接业务合作。</li>
        </ul>
      </div>
    </section>

    <section>
      <h2>项目经历</h2>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name">NIHPLOD 中国官网</h3>
          <span class="entry-date">2025.11 – 至今（迭代）</span>
        </div>
        <div class="project-meta">
          独立完成（产品设计 · UI/UX · 全栈开发） · 成果展示：<a
            href="https://www.nihplod.cn"
            target="_blank" rel="noopener noreferrer">www.nihplod.cn</a
          >
        </div>
        <ul class="project-points">
          <li>
            <strong>品牌官网与会员中台：</strong>基于 Next.js 16 + Prisma + PostgreSQL 构建品牌官网、产品陈列与第三方电商导购（天猫 / 抖音 / 小红书外链 + GA 事件追踪），并落地会员等级、积分账本、积分兑礼（顺丰物流轨迹）、消费补录、测肤档案与安全中心；聚合微信、抖音、手机号验证码多端身份至统一账号体系；全站 169 个 API 路由、43 个数据模型、1725 个自动化测试用例。
          </li>
          <li>
            <strong>产品与交互设计：</strong>从信息架构、Figma 交互原型到视觉样式全程独立设计，基于 Framer Motion + View Transitions 实现多步骤护肤仪式指南与沉浸式品牌叙事，集成产品抽屉与详情页联动，全端响应式适配。
          </li>
          <li>
            <strong>运营后台与安全治理：</strong>搭建覆盖产品 / 分类 / 会员 / 积分兑礼 / 消费补录 / 职位 / 消息 / OAuth 客户端的运营后台（Tiptap 富文本），配套 TOTP 二因素与敏感操作 Step-up 验证、操作审计与每日完整性锚点、定时任务、数据库持久化限流及 Webhook 失败重投；完成 SEO / GEO（sitemap / JSON-LD / llms.txt / 百度推送）。
          </li>
        </ul>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name">NIHPLOD 统一认证平台（SSO / OIDC）</h3>
          <span class="entry-date">2026.06 – 至今（迭代）</span>
        </div>
        <div class="project-meta">
          独立完成（产品设计 · 全栈开发）
        </div>
        <ul class="project-points">
          <li>
            <strong>协议实现：</strong>自建 OAuth 2.0 / OIDC 单点登录，与官网主站同构部署，主站作为 Authorization Server 签发 JWT（RS256），完整实现 authorize / token / userinfo / introspect / revoke / end-session 协议端点，支持 PKCE、DPoP 与 TOTP 二因素。
          </li>
          <li>
            <strong>SDK 与接入：</strong>封装并发布 npm SDK（@nihplod/sso-sdk / @nihplod/sso-verify）供子项目分钟级接入，通过 Token Introspection + Backchannel Logout 实现跨域免登与全局登出，支撑官网、测肤站、微信双小程序及管理端统一登录。
          </li>
          <li>
            <strong>安全加固：</strong>支持密钥轮换、Token 撤销（RFC 7009）与多实例黑名单共享，保障认证体系可运维、可审计。
          </li>
        </ul>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name">AI 护肤顾问系统</h3>
          <span class="entry-date">2026.01 – 至今</span>
        </div>
        <div class="project-meta">
          负责产品设计 · UX 交互 · 全栈开发（UI 视觉由协作设计师完成） · 85 个 API 路由 / 426 个自动化测试 · 成果展示：<a href="https://advisor.nihplod.cn" target="_blank" rel="noopener noreferrer"
            >advisor.nihplod.cn</a
          >
        </div>
        <ul class="project-points">
          <li>
            <strong>AI 测肤与个性化推荐：</strong>接入通义千问 VL / DeepSeek 大模型实现「问卷 + 扫脸」双通道皮肤分析；自研规则引擎按 8 种肤质画像与季节 / 地域环境因子打分匹配产品，支持后台可视化配置（运营零代码调整）。
          </li>
          <li>
            <strong>转化与归因：</strong>主导模型集成与核心接口开发；电商外链（天猫 / 抖音 / 小红书）支持 UTM / pid 追踪与点击事件埋点，结合企微顾问短链形成可归因的咨询转化链路。
          </li>
          <li>
            <strong>增长与会员运营：</strong>打通四档会员测肤配额（普通 10 次、银卡按消费解锁、金卡 / 钻石不限量），以登录账号承接报告与档案；设计分享海报、渠道 ref 归因与注册转化弹窗，并输出脱敏群体统计 CSV 反哺品牌白皮书与市场洞察。
          </li>
          <li>
            <strong>AI 成本与稳定性工程：</strong>设计 AI 请求队列与并发控制、熔断器、日/月 Token 与费用预算熔断、调用计费持久化、模型白名单与 Provider 回退；以失败重试幂等与额度预占 / 释放规避重复扣费；报告采用 90 天滚动有效期 + 冷热分层归档（冷层脱敏摘要）。
          </li>
          <li>
            <strong>数据资产闭环：</strong>设计 HMAC 签名 + IP 限流的服务端间接口，测肤报告与护肤档案随 session_id 一键透传至企微 AI 客服，将一次性测肤沉淀为可持续运营、可驱动复购的用户数据资产。
          </li>
        </ul>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name">微信 AI 智能客服</h3>
          <span class="entry-date">2026.08</span>
        </div>
        <div class="project-meta">
          独立完成（产品设计 · 全栈开发，基于微信客服原生聊天窗）
        </div>
        <ul class="project-points">
          <li>
            <strong>多入口消息网关：</strong>基于 FastAPI + Redis + DeepSeek 大模型构建，统一接入企业微信客服、企业微信应用与公众号三路消息入口；支持智能转人工（关键词识别 + 服务时间窗 + 接待人粘性绑定）。
          </li>
          <li>
            <strong>陪伴式会话运营：</strong>承接测肤平台透传的用户档案，多轮会话中自动沉淀护肤档案（阶段目标管理与复评提醒），并提供订单查询引导，将一次性咨询转化为长期陪伴式跟进。
          </li>
          <li>
            <strong>提示词与知识库工程：</strong>按客服账号路由双套人设（品牌客服 / 护肤顾问）的独立提示词与知识库；44KB 品牌 FAQ 知识库分段构建、按消息关键词匹配按需注入并支持热加载；内置 Prompt 注入防护与广告法禁语输出过滤双层合规兜底。
          </li>
          <li>
            <strong>质量保障与可用性：</strong>以 34 条真实大模型黄金回归用例锁定提示词迭代质量，配套 340+ 自动化测试用例；AI 调用指数退避重试与超时控制，Redis 故障自动降级内存模式并定时重连恢复；提供 PII 导出/删除接口（个保法合规），Linux + Nginx 自托管部署。
          </li>
        </ul>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name">NIHPLOD 授权验真平台</h3>
          <span class="entry-date">2026.04 – 2026.05</span>
        </div>
        <div class="project-meta">
          独立完成（产品设计 · UI/UX · 全栈开发） · 成果展示：<a href="https://ba.nihplod.cn" target="_blank" rel="noopener noreferrer"
            >ba.nihplod.cn</a
          >
        </div>
        <ul class="project-points">
          <li>
            <strong>授权审核与防伪证书：</strong>基于 Next.js 16 + PostgreSQL 构建经销商授权管理系统，实现「审核员提报 → 负责人终审核发」两级审核与证书状态机（签发 / 打回 / 到期 / 吊销）；浏览器端 Canvas + jsPDF 实时合成含电子公章与动态二维码的防伪授权证书（支持 PNG / PDF 下载）。
          </li>
          <li>
            <strong>公众查验与安全体系：</strong>面向公众提供「精确 → 前缀 → 模糊」三级回退真伪查验（pg_trgm GIN 索引加速，支持摄像头扫码）与带完整状态流转的打假举报工单系统；配套 JWT 黑名单与改密即时失效、数据库持久化限流，以及覆盖证书全生命周期与工单处理的操作审计。
          </li>
        </ul>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name">肌智派 AI 测肤小程序</h3>
          <span class="entry-date">2026.10 – 至今</span>
        </div>
        <div class="project-meta">
          独立完成（产品设计 · UI/UX · 小程序开发） · 复用 H5 测肤平台账号与 AI 能力
        </div>
        <ul class="project-points">
          <li>
            <strong>移动端测肤闭环：</strong>将「问卷 + 扫脸」测肤流程迁移至微信小程序（14 个页面），基于微信 VisionKit 106 关键点实现正脸 / 右转 / 左转 / 抬头四步姿态引导与自动拍摄（连续 5 帧稳定判定、多脸阻断、超时手动降级）；问卷支持 dependsOn 条件题与测肤次数限额拦截。
          </li>
          <li>
            <strong>异步分析与报告渲染：</strong>人脸图片压缩后以 base64 提交，异步任务按 3s × 60 轮询状态；失败重试以「答案 + 照片」指纹复用 sessionId 与服务端预占，避免重复扣减测肤次数与重复 AI 调用。基于 Canvas 2D 按 DPR 绘制十维雷达图与肌肤趋势曲线，端侧合成含动态评分与二维码的证书海报，支持历史回看、档案打卡及报告完成 / 复测订阅消息。
          </li>
          <li>
            <strong>账号与工程治理：</strong>同时对接官网 OAuth public client 与测肤子站双后端，统一请求层实现 Bearer 注入、过期前主动刷新、401 单飞刷新重放、账号禁用强制登出与错误分级；完成微信隐私授权版本化审计、账号注销冷静期接入、登出敏感缓存清理，并与会员中心小程序双向跳转。
          </li>
        </ul>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name">NIHPLOD 会员中心小程序</h3>
          <span class="entry-date">2026.10 – 至今</span>
        </div>
        <div class="project-meta">
          独立完成（产品设计 · 小程序开发） · 原生 TypeScript / 直连官网 OAuth
        </div>
        <ul class="project-points">
          <li>
            <strong>会员中心与积分体系落地：</strong>以原生 TypeScript 构建 19 页会员中心小程序（会员 / 兑礼 / 我的 3 Tab），覆盖微信一键登录与手机号绑定、会员等级权益与升级进度、积分余额与近一年流水（含流水号）、礼品兑换（requestId 幂等）、地址簿、兑换记录与顺丰物流轨迹、消费补录、资料编辑、安全中心（设备 / 授权 / 登录历史）及账号注销。
          </li>
          <li>
            <strong>无自建后端的轻量架构：</strong>小程序直连官网 OAuth 2.0 端点与业务 API，复用统一账号与会员数据；自研 TypeScript 请求层实现 access / refresh 双 Token、单飞刷新与 401 重放、刷新失败分级（invalid / transient）、登录来源回跳、账号禁用强制下线与会话竞态修复，并以 tsc --noEmit 严格类型检查保障 19 页接口契约一致。
          </li>
          <li>
