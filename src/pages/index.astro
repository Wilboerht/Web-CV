---
export const prerender = true;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>王泓坤 | Hongkun Wang</title>
    <meta name="robots" content="noindex, follow" />
    <meta property="og:title" content="王泓坤 | Hongkun Wang" />
    <meta property="og:description" content="王泓坤 · 数字开发经理 · 全栈工程师 · 个人简历 / Hongkun Wang · CV" />
    <meta
      http-equiv="refresh"
      content="0; url=/CV-en/"
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <script is:inline>
      (function () {
        var lang = navigator.language || navigator.userLanguage || "";
        var l = lang.toLowerCase();
        var target;
        if (l.startsWith("zh-hk") || l.startsWith("zh-mo")) target = "/CV-hk/";
        else if (l.startsWith("zh-tw")) target = "/CV-tw/";
        else if (l.startsWith("zh")) target = "/CV-cn/";
        else if (l.startsWith("de")) target = "/CV-de/";
        else if (l.startsWith("ko")) target = "/CV-kr/";
        else target = "/CV-en/";
        window.location.replace(target);
      })();
    </script>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #fafafa;
        font-family: 'Noto Serif SC', 'Source Serif 4', serif;
      }
    </style>
  </head>
  <body>
    <noscript>
      <p style="text-align:center;padding:40px;font-size:0.875rem;color:#666">
        Redirecting... <a href="/CV-cn/">中文</a> | <a href="/CV-tw/">繁體</a> | <a href="/CV-hk/">繁體（港）</a> | <a href="/CV-en/">English</a> | <a href="/CV-de/">Deutsch</a> | <a href="/CV-kr/">한국어</a>
      </p>
    </noscript>
  </body>
</html>
