---
export const prerender = true;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>王泓坤 | Hongkun Wang</title>
    <meta name="robots" content="noindex, follow" />
    <meta
      http-equiv="refresh"
      content="0; url=/CV-cn"
    />
    <script is:inline>
      (function () {
        var lang = navigator.language || navigator.userLanguage || "";
        var l = lang.toLowerCase();
        var target;
        if (l.startsWith("zh")) target = "/CV-cn";
        else if (l.startsWith("ko")) target = "/CV-kr";
        else target = "/CV-en";
        window.location.replace(target);
      })();
    </script>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #fafafa;
        visibility: hidden;
      }
    </style>
  </head>
  <body></body>
</html>
