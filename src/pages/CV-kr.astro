---
import Layout from "../layouts/Layout.astro";
import PrintFooter from "../components/PrintFooter.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MermaidDiagram from "../components/MermaidDiagram.astro";
import { moidasArchitecture } from "../diagrams/moidas-architecture";
import "../styles/global.css";
import "../styles/cv.css";

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://cv.wilboerht.com/CV-kr/#page",
  "url": "https://cv.wilboerht.com/CV-kr/",
  "inLanguage": "ko",
  "dateModified": new Date().toISOString(),
  "mainEntity": {
    "@type": "Person",
    "@id": "https://www.wilboerht.com/#person",
    "name": "왕홍곤",
    "alternateName": "Hongkun Wang",
    "givenName": "Hongkun",
    "familyName": "Wang",
    "description": "상하이에 거주하는 디지털 개발 매니저이자 풀스택 엔지니어(TypeScript / React / Next.js / AI / RAG). 브랜드 중화권 사업부의 첫 엔지니어로 브랜드 공식 사이트, 멤버십·포인트 체계, 통합 인증(SSO), AI 어드바이저, 고객 서비스, 미니프로그램 2종을 0에서 1로 구축.",
    "email": "me@wilboerht.cn",
    "url": "https://www.wilboerht.com",
    "image": "https://cv.wilboerht.com/og-image.png",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "상하이",
      "addressCountry": "CN"
    },
    "sameAs": [
      "https://github.com/Wilboerht",
      "https://twitter.com/wilboerht"
    ],
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "상하이과학기술직업학원"
      }
    ],
    "knowsAbout": [
      "TypeScript",
      "React",
      "Next.js",
      "Vue 3",
      "Node.js",
      "FastAPI",
      "Prisma",
      "PostgreSQL",
      "Redis",
      "Large Language Models",
      "RAG",
      "Docker",
      "Linux"
    ],
    "jobTitle": "디지털 개발 매니저",
    "worksFor": {
      "@type": "Organization",
      "name": "모이다스",
      "url": "https://www.nihplod.cn"
    },
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": '상하이 "스타라이트 플랜" 기술 경연대회 "웹 기술" 부문 3등 (시 전체 16위)',
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "인력자원사회보장부 직업기능등급증서: 컴퓨터 프로그래머 3급 (고급) (경연)",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "국가 정보안전 수준 시험 2급 (NISP)",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "CTyun 고급 개발자 인증 (SCCP)",
        "dateCreated": "2024-11"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "알리바바 클라우드 ACA 클라우드 보안 어소시에이트 인증",
        "dateCreated": "2024-10"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "CTyun 고급 운영 엔지니어 인증",
        "dateCreated": "2024-05"
      }
    ],
    "award": '상하이 "스타라이트 플랜" 기술 경연대회 "웹 기술" 부문 3등'
  }
};
---

<Layout title="왕홍곤 - 이력서" lang="ko">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld, null, 2)} />
  </Fragment>
  <style>
    :root {
      --cv-font-body: 'Noto Serif SC', 'Source Serif 4', serif;
    }
  </style>

  <div class="container">
    <header>
      <h1>왕홍곤</h1>
      <p class="tagline">디지털 개발 매니저 · 풀스택 엔지니어 · 상하이</p>
      <div class="contact-info">
        <span class="contact-item"><a href="mailto:me@wilboerht.cn">me@wilboerht.cn</a></span>
        <span class="contact-item"><a href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer">GitHub</a></span>
        <span class="contact-item"><a href="https://www.wilboerht.com" target="_blank" rel="noopener noreferrer">wilboerht.com</a></span>
      </div>
    </header>

    <section>
      <h2>경력</h2>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">모이다스 · NIHPLOD 중화권 사업부</h3>
          <div class="entry-meta">
            <span class="entry-role">디지털 개발 매니저</span>
            <span class="entry-date">2025년 10월 – 현재</span>
          </div>
        </div>
        <p class="entry-summary">
          2025년 10월 인턴으로 합류, 2026년 7월 정규직 전환 후 브랜드 책임자에게 직접 보고; 사업부 최초의 기술 인력으로서 제품 사고와 AI 보조 개발을 바탕으로 요구사항·디자인·개발·출시까지 풀스택 딜리버리를 독립 수행, 12개월 동안 7개 핵심 시스템과 2,100+ 자동화 테스트 케이스를 0에서 1까지 구축하고 통합 계정 및 프로필 데이터로 「피부 측정 → 맞춤 솔루션 → AI 어드바이저 팔로업 → 재구매」 비즈니스 클로즈드 루프를 완성.
        </p>
        <ul class="project-points">
          <li>브랜드 중화권 디지털 제품 매트릭스의 기획, 기술 선정 및 풀스택 딜리버리 총괄; 7개 핵심 시스템의 요구사항·디자인·개발·출시·운영 전 과정을 아우르는 수명 주기 관리.</li>
          <li>브랜드 중화권 멤버십 체계 수립에 참여하여 브랜드·운영 팀과 함께 4단계 회원 등급, 혜택, 포인트 및 교환 규칙을 설계하고 공식 사이트 / 미니프로그램 멤버십 센터에 구현하여 회원 유지 및 재구매 지원.</li>
          <li>AI 보조 개발 워크플로우 및 디자인 표준 수립, 평균 딜리버리 주기 50% 이상 단축, 다수 프로젝트 병렬 딜리버리 보장.</li>
          <li>기술 책임자로서 제품·마케팅 팀의 요구사항을 접수·분해하여 일정 수립, 요구사항 리뷰 및 반복 주기 주도, 브랜드 온라인 리테일 채널(중국 공식 사이트)의 0부터 론칭까지 지원.</li>
          <li>ICP 등록, 개인정보 보호정책 및 이용약관 제정 주도, 데이터 컴플라이언스 심사 완료로 다중 시스템의 컴플라이언스 론칭 보장; 트래픽에 따른 서버 리소스 동적 조정으로 비용 최적화.</li>
        </ul>
        <MermaidDiagram
          code={moidasArchitecture.kr}
          alt="모이다스 중화권 디지털 시스템 아키텍처: 통합 SSO가 공식 사이트, AI 피부 측정, AI 고객서비스, 인증 검증 시스템을 연결"
          zoomLabel="클릭하여 확대"
          closeLabel="닫기"
        />
      </div>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">상하이 링강 징홍 보안방범과기발전유한공사</h3>
          <div class="entry-meta">
            <span class="entry-role">R&amp;D 인턴</span>
            <span class="entry-date">2025년 7월 – 2025년 9월</span>
          </div>
        </div>
        <ul class="project-points">
          <li>기업 웹사이트 전 과정(아키텍처, UI/UX, 풀스택 개발, 프로덕션 배포) 딜리버리 독립 완료.</li>
          <li>Unitree 로봇견 SDK 기반 2차 개발로 단지 순찰 관리 제어 플랫폼 사내 초기 버전 완성, 제품 타당성 검증.</li>
          <li>AI Q&amp;A 어시스턴트의 사내 최초 도입을 주도하고, 기업과 바이두 공식 기업 Q&amp;A 팀 간의 업무 협업에 참여.</li>
        </ul>
      </div>
    </section>

    <section>
      <div class="project-section-head">
        <h2>프로젝트</h2>
        <a class="project-github-link" href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer" aria-label="GitHub에서 더 보기">
          <svg class="project-github-link__icon" aria-hidden="true"><use href="#icon-github"></use></svg>
          GitHub에서 더 보기
        </a>
      </div>

      <div class="project-entry" id="project-website">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-website" aria-haspopup="dialog">NIHPLOD 중국 공식 사이트</button></h3>
          <span class="entry-date">2025년 11월 – 현재</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">독립 담당</span>: <span class="project-meta-role"><span class="project-meta-tag">제품</span> <span class="project-meta-tag">UI/UX</span> <span class="project-meta-tag">풀스택</span> <a href="https://www.nihplod.cn" target="_blank" rel="noopener noreferrer" class="project-meta-link"><span>nihplod.cn</span><svg class="project-meta-link__icon" aria-hidden="true"><use href="#icon-external"></use></svg></a></span>
        </div>
        <p class="project-summary">중국 시장을 위한 브랜드 공식 사이트와 멤버십 플랫폼: 상품 전시, 이커머스 연동, 멤버십 포인트, 피부 측정 프로필을 하나의 경험으로 통합하고 위챗·더우인·휴대폰 번호 계정을 통일해 0→1 온라인 리테일과 재구매를 지원; 169 API / 43 모델 / 1,725 테스트.</p>
        <button type="button" class="project-more" data-project-dialog="project-website" aria-haspopup="dialog" aria-label="상세 보기: NIHPLOD 중국 공식 사이트"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>상세 보기</button>
        <dialog class="project-dialog" id="dialog-project-website">
          <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="닫기">&times;</button>
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
            </div>
            <div class="project-dialog__content">
            <ul class="project-points">
              <li>
                <strong>브랜드 공식 사이트 &amp; 멤버십 플랫폼:</strong> Next.js 16 + Prisma + PostgreSQL 기반으로 브랜드 공식 사이트와 멤버십 플랫폼 구축 — 상품 진열, 제3자 이커머스 연동(티몰 / 도우인 / 샤오홍슈 링크 + GA 이벤트 추적), 회원 등급, 포인트 원장, 포인트 교환(순펑 물류 추적), 소비 보충 입력, 피부 측정 프로필 및 보안 센터; 위챗·도우인·휴대폰 OTP 등 다중 채널 신원을 통합 계정 체계로 집계 — 전 사이트 169개 API 라우트, 43개 데이터 모델, 1,725개 자동화 테스트 케이스.
              </li>
              <li>
                <strong>제품 &amp; 인터랙션 디자인:</strong> 정보 아키텍처, Figma 인터랙티브 프로토타입, 비주얼 스타일링을 독립적으로 설계; Framer Motion + View Transitions로 다단계 스킨케어 리추얼 가이드와 몰입형 브랜드 스토리텔링을 구현하고 제품 드로어와 상세 페이지를 연동, 전 기기 반응형 레이아웃 제공.
              </li>
              <li>
                <strong>어드민 콘솔 &amp; 보안 거버넌스:</strong> 상품 / 카테고리 / 회원 / 포인트 교환 / 소비 보충 입력 / 채용 / 메시지 / OAuth 클라이언트를 아우르는 어드민 콘솔(Tiptap 리치 텍스트) 구축, TOTP 2단계 인증과 민감 작업 Step-up 검증, 감사 로그와 일일 무결성 앵커, 예약 작업, DB 영속 레이트 리미팅, 웹훅 실패 재시도; SEO / GEO(sitemap / JSON-LD / llms.txt / 바이두 푸시) 완료.
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

      <div class="project-entry" id="project-sso">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-sso" aria-haspopup="dialog">NIHPLOD 통합 인증 플랫폼(SSO / OIDC)</button></h3>
          <span class="entry-date">2026년 6월 – 현재</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">독립 담당</span>: <span class="project-meta-role"><span class="project-meta-tag">제품</span> <span class="project-meta-tag">풀스택</span></span>
        </div>
        <p class="project-summary">중화권의 통합 아이덴티티 기반: 자체 구축한 OAuth 2.0 / OIDC SSO로 공식 사이트, 피부 측정 사이트, 미니프로그램 2종, 관리자 콘솔의 계정과 로그인 상태를 연결하고, 5개 시스템의 크로스 도메인 로그인·글로벌 로그아웃·2단계 인증을 지원하며 재사용 가능한 npm SDK로 패키징.</p>
        <button type="button" class="project-more" data-project-dialog="project-sso" aria-haspopup="dialog" aria-label="상세 보기: NIHPLOD 통합 인증 플랫폼(SSO / OIDC)"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>상세 보기</button>
        <dialog class="project-dialog" id="dialog-project-sso">
          <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="닫기">&times;</button>
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
            </div>
            <div class="project-dialog__content">
            <ul class="project-points">
              <li>
                <strong>프로토콜 구현:</strong> OAuth 2.0 / OIDC 기반 SSO 자체 구축, 공식 메인 사이트와 동일 구조로 배포되며 메인 사이트가 Authorization Server로서 RS256 JWT 발급, authorize / token / userinfo / introspect / revoke / end-session 프로토콜 엔드포인트 전체 구현 및 PKCE·DPoP·TOTP 2단계 인증 지원.
              </li>
              <li>
                <strong>SDK 및 연동:</strong> npm SDK(@nihplod/sso-sdk / @nihplod/sso-verify) 패키징·배포로 서브 프로젝트의 분 단위 신속 연동 지원, Token Introspection + Backchannel Logout으로 크로스도메인 SSO 및 글로벌 로그아웃 구현, 공식 사이트·피부 측정 사이트·위챗 미니프로그램 2종·어드민 콘솔의 통합 로그인 지원.
              </li>
              <li>
                <strong>보안 강화:</strong> 비밀키 순환, 토큰 취소(RFC 7009), 다중 인스턴스 블랙리스트 공유 지원으로 운영·감사 가능한 인증 체계 구축.
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

      <div class="project-entry" id="project-ai-advisor">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-ai-advisor" aria-haspopup="dialog">AI 스킨케어 어드바이저 시스템</button></h3>
          <span class="entry-date">2026년 1월 – 현재</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">독립 담당</span>: <span class="project-meta-role"><span class="project-meta-tag">제품</span> <span class="project-meta-tag">UX</span> <span class="project-meta-tag">풀스택</span> <span class="project-meta-note">UI 비주얼 협업</span> <a href="https://advisor.nihplod.cn" target="_blank" rel="noopener noreferrer" class="project-meta-link"><span>advisor.nihplod.cn</span><svg class="project-meta-link__icon" aria-hidden="true"><use href="#icon-external"></use></svg></a></span>
        </div>
        <p class="project-summary">소비자용 AI 스킨케어 어드바이저: 설문 + 얼굴 스캔의 듀얼 채널로 피부를 분석하고 피부 타입·계절·지역 규칙에 따라 맞춤 제품안을 생성하며, 리포트와 프로필을 WeCom 어드바이저에게 전달해 「피부 측정 → 솔루션 → 팔로업 → 재구매」 루프를 완성; 85 API / 426 테스트.</p>
