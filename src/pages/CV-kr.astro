---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="왕홍곤 - 이력서" lang="ko">
  <style>
    body {
      font-family: "Times New Roman", "Inter", "Noto Sans KR", serif;
      background: var(--background);
      color: var(--text-color);
      line-height: 1.5;
    }
    .container {
      max-width: 800px;
      margin: 40px auto;
      padding: 0 40px;
    }
    header {
      text-align: center;
      margin-bottom: 25px;
      padding-bottom: 20px;
      border-bottom: 1px solid transparent;
      background-image:
        linear-gradient(var(--background), var(--background)),
        linear-gradient(
          90deg,
          transparent,
          var(--header-line-color) 20%,
          var(--header-line-color) 80%,
          transparent
        );
      background-origin: padding-box, border-box;
      background-clip: padding-box, border-box;
    }
    h1 {
      font-size: 26px;
      font-weight: 700;
      margin: 0 0 8px 0;
      letter-spacing: 2px;
    }
    .contact-info {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 10px;
      font-size: 13px;
      color: var(--light-text);
    }
    .contact-item a {
      color: var(--link-color);
      text-decoration: none;
    }
    section {
      margin-bottom: 20px;
    }
    h2 {
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin: 0 0 12px 0;
      padding-bottom: 5px;
      border-bottom: 1px solid var(--primary-color);
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    .entry {
      margin-bottom: 16px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border-color);
    }
    .entry:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }
    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 6px;
    }
    .entry-org {
      font-weight: 700;
      font-size: 15px;
      color: var(--text-color);
    }
    .entry-date {
      font-size: 13px;
      color: var(--light-text);
    }
    .entry-major {
      font-size: 14px;
      color: var(--text-color);
      font-weight: 500;
      margin-top: 2px;
    }
    .entry-role {
      font-size: 14px;
      color: var(--text-color);
      font-weight: 500;
      margin-bottom: 4px;
    }
    .entry-desc {
      font-size: 13px;
      color: var(--tag-text);
      margin: 6px 0 0 0;
      padding-left: 10px;
      border-left: 1px solid var(--border-color);
      line-height: 1.6;
    }
    .project-entry {
      margin-bottom: 18px;
      padding-bottom: 15px;
      border-bottom: 1px dotted var(--border-color);
    }
    .project-entry:last-child {
      border-bottom: none;
    }
    .project-name {
      font-weight: 700;
      font-size: 15px;
      color: var(--text-color);
    }
    .project-role {
      font-size: 13px;
      color: var(--tag-text);
      margin-left: 10px;
    }
    .project-meta {
      font-size: 12px;
      color: var(--light-text);
      margin: 4px 0 8px 0;
    }
    .project-meta a {
      color: var(--link-color);
      text-decoration: none;
    }
    .project-abstract {
      font-size: 13px;
      color: var(--text-color);
      margin: 8px 0;
      padding-left: 12px;
      border-left: 2px solid var(--border-color);
    }
    .project-points {
      margin: 8px 0 0 0;
      padding-left: 18px;
    }
    .project-points li {
      font-size: 13px;
      margin-bottom: 4px;
      color: var(--text-color);
    }
    .tech-tags {
      margin-top: 8px;
    }
    .tech-tag {
      display: inline-block;
      font-size: 11px;
      background: var(--tag-bg);
      color: var(--tag-text);
      padding: 2px 8px;
      margin-right: 5px;
      margin-bottom: 4px;
      border: 1px solid var(--tag-border);
    }
    .skills-row {
      display: flex;
      margin-bottom: 6px;
      font-size: 13px;
    }
    .skills-label {
      width: 120px;
      font-weight: 600;
      color: var(--text-color);
      flex-shrink: 0;
    }
    .skills-content {
      color: var(--light-text);
    }
    .award-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 13px;
      margin-bottom: 5px;
    }
    .award-name {
      color: var(--text-color);
      font-size: 14px;
    }
    .award-date {
      color: var(--light-text);
    }
    .other-list {
      margin: 0;
      padding-left: 18px;
    }
    .other-list li {
      font-size: 14px;
      margin-bottom: 4px;
      color: var(--text-color);
    }
    /* Extra Large Screens */
    @media (min-width: 1400px) {
      .container {
        max-width: 900px;
      }
      body {
        font-size: 16px;
        line-height: 1.6;
      }
      h1 {
        font-size: 32px;
      }
      h2 {
        font-size: 16px;
      }
      .contact-info {
        font-size: 14px;
        gap: 28px;
      }
      .entry-title,
      .project-name {
        font-size: 16px;
      }
      .entry-date,
      .project-role {
        font-size: 14px;
      }
      .entry-desc,
      .project-abstract,
      .project-points li,
      .skills-row,
      .award-row,
      .other-list li {
        font-size: 14px;
      }
      .project-meta {
        font-size: 13px;
      }
      .tech-tag {
        font-size: 12px;
        padding: 3px 10px;
      }
      .skills-label {
        width: 140px;
      }
    }
    /* Large Screens */
    @media (min-width: 1200px) and (max-width: 1399px) {
      .container {
        max-width: 850px;
      }
      h1 {
        font-size: 28px;
      }
      h2 {
        font-size: 15px;
      }
      .contact-info {
        font-size: 14px;
        gap: 24px;
      }
      .entry-title,
      .project-name {
        font-size: 15px;
      }
      .entry-desc,
      .project-abstract,
      .project-points li {
        font-size: 14px;
      }
    }
    /* Medium Screens */
    @media (min-width: 900px) and (max-width: 1199px) {
      .container {
        max-width: 820px;
      }
    }
    /* Tablet Adaptation */
    @media (max-width: 768px) {
      .container {
        padding: 0 30px;
      }
      .skills-row {
        flex-wrap: wrap;
      }
      .skills-label {
        width: 100%;
        margin-bottom: 4px;
      }
      .award-row {
        gap: 5px;
      }
    }
    /* Mobile Adaptation */
    @media (max-width: 600px) {
      .container {
        margin: 20px auto;
        padding: 0 16px;
      }
      h1 {
        font-size: 22px;
        letter-spacing: 1px;
      }
      h2 {
        font-size: 13px;
      }
      .contact-info {
        flex-direction: column;
        align-items: center;
        gap: 6px;
      }
      .entry-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 2px;
      }
      .entry-org {
        font-size: 14px;
      }
      .entry-date {
        margin-top: 2px;
        font-size: 12px;
      }
      .entry-major {
        font-size: 13px;
      }
      .entry-role {
        font-size: 13px;
      }
      .project-name {
        font-size: 13px;
      }
      .project-role {
        display: block;
        margin-left: 0;
        margin-top: 2px;
      }
      .project-meta {
        font-size: 11px;
        line-height: 1.6;
      }
      .project-abstract {
        padding-left: 10px;
        font-size: 12px;
      }
      .project-points {
        padding-left: 16px;
      }
      .project-points li {
        font-size: 12px;
      }
      .tech-tag {
        font-size: 10px;
        padding: 2px 6px;
      }
      .skills-row {
        flex-direction: column;
        font-size: 12px;
      }
      .skills-label {
        width: 100%;
        margin-bottom: 3px;
      }
      .skills-content {
        padding-left: 0;
      }
      .award-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 2px;
        font-size: 12px;
      }
      .award-date {
        margin-left: 0;
      }
      .other-list li {
        font-size: 12px;
      }
    }
    /* Small Mobile Strings */
    @media (max-width: 380px) {
      .container {
        padding: 0 12px;
      }
      h1 {
        font-size: 20px;
      }
      .contact-info {
        font-size: 12px;
      }
    }
    /* Print Optimization */
    @media print {
      body {
        font-size: 12px;
      }
      .container {
        margin: 0;
        padding: 20px;
        max-width: 100%;
      }
      .toggle-projects-btn {
        display: none !important;
      }
      .project-entry.hidden {
        display: block !important;
      }
    }

    .toggle-projects-btn {
      display: block;
      margin: 10px auto 0;
      padding: 6px 20px;
      background: transparent;
      border: 1px solid #ddd;
      color: #666;
      font-size: 13px;
      cursor: pointer;
      border-radius: 20px;
      transition: all 0.2s;
      font-family: inherit;
    }
    .toggle-projects-btn:hover {
      background: var(--hover-bg);
      color: var(--text-color);
      border-color: var(--tag-border);
    }
    .project-entry.hidden {
      display: none;
    }
    .project-entry.no-border {
      border-bottom: none;
    }

  </style>

  <div class="container">
    <header>
      <h1>왕홍곤</h1>
      <div class="contact-info">
        <span class="contact-item">
          <i class="fas fa-phone"></i>
          <a href="tel:+8618721400154">+(86) 18721400154</a>
        </span>
        <span class="contact-item">
          <i class="fas fa-envelope"></i>
          <a href="mailto:me@wilboerht.cn">me@wilboerht.cn</a>
        </span>
        <span class="contact-item">
          <i class="fas fa-globe"></i>
          <a href="https://www.wilboerht.com" target="_blank">wilboerht.com</a>
        </span>
        <span class="contact-item">
          <i class="fab fa-github"></i>
          <a href="https://github.com/Wilboerht" target="_blank">GitHub</a>
        </span>
        <span class="contact-item">
          <i class="fab fa-twitter"></i>
          <a href="https://twitter.com/wilboerht" target="_blank">Twitter</a>
        </span>
      </div>
    </header>

    <section>
      <h2>학력</h2>
      <div class="entry">
        <div class="entry-header">
          <span class="entry-org"
            >상하이과학기술직업학원</span
          >
          <span class="entry-date">2023년 10월 - 2026년 6월</span>
        </div>
        <div class="entry-major">
          통신전자공학부, 정보안전기술응용전공, 전문학사
        </div>
        <p class="entry-desc">
          <i
            class="fas fa-book"
            style="font-size: 13px; margin-right: 4px; color: var(--light-text);"
          ></i>
          주요 과목: 네트워크 보안, 프로그래밍, 알고리즘 및 자료구조, 컴퓨터 구조, 운영체제, 데이터베이스 시스템, 컴퓨터 네트워크 등
        </p>
        <p class="entry-desc" style="margin-top: 4px;">
          <i
            class="fas fa-award"
            style="font-size: 13px; margin-right: 4px; color: var(--light-text);"
          ></i>
          학업 성적: GPA 3.49/4.00, 우수 졸업생
        </p>
      </div>
    </section>

    <section>
      <h2>경력</h2>
      <div class="entry">
        <div class="entry-header">
          <span class="entry-org"
            >모이다스 (NIHPLOD 사업부) — AI 응용 풀스택 개발 엔지니어</span
          >
          <span class="entry-date">2025년 10월 - 현재</span>
        </div>
        <p class="entry-desc">
          브랜드 중국 지역의 AI 응용 및 디지털 시스템 풀스택 개발을 주도하여 공식 웹사이트, 위챗 미니프로그램, AI 스킨케어 어드바이저, 인증 검증 플랫폼 등을 개발 및 런칭. Claude Code, Codex 등 AI 도구를 활용하여 개발 워크플로우를 최적화하고, 기존 대비 개발 기간을 50% 이상 단축. 요구사항 분석, 시스템 아키텍처, 모델 통합, 프론트엔드/백엔드 개발부터 컴플라이언스 론칭까지 전 주기를 독립적으로 수행하며, 운영 배포 및 비용 최적화를 관리.
        </p>
      </div>
      <div class="entry">
        <div class="entry-header">
          <span class="entry-org"
            >상하이 링강 징홍 보안방범과기발전유한공사 — R&D 인턴</span
          >
          <span class="entry-date">2025년 7월 - 2025년 9월</span>
        </div>
        <p class="entry-desc">
          엔터프라이즈급 풀스택 애플리케이션 개발 및 AI 기능 배포를 주도하여 시스템 아키텍처, 프론트엔드/백엔드 개발 및 프로덕션 환경 구축을 독립적으로 수행. 대규모 언어 모델(LLM) 기능을 비즈니스 시나리오에 통합하고, 지역화된 지능형 Q&A 시스템을 배포하여 낶부 워크플로우에서 AI 도구의 실제 활용을 추진.
        </p>
      </div>
    </section>

    <section>
      <h2>프로젝트</h2>

      <div class="project-entry">
        <div class="entry-header">
          <span class="project-name">NIHPLOD 중국 공식 프로젝트 시리즈</span>
          <span class="entry-date">2025년 11월 - 현재</span>
        </div>
        <div class="project-meta">
          프로젝트 설계, 풀스택 개발, UX/UI 디자인, 컴플라이언스 론칭 · 성과: <a
            href="https://www.nihplod.cn"
            target="_blank">www.nihplod.cn</a
          >, <a href="https://ba.nihplod.cn" target="_blank">ba.nihplod.cn</a
          >, <a href="https://advisor.nihplod.cn" target="_blank"
            >advisor.nihplod.cn</a
          >
        </div>
        <p class="project-abstract">
          프로젝트 구성: NIHPLOD China official website & WeChat mini-program,
          authorization verification platform, AI skincare advisor, H5 redemption
          system, influencer cooperation efficiency platform, etc.
        </p>
        <ul class="project-points">
          <li>
            정보 시스템 설계 및 개발, Claude Code 및 Codex 등 AI 도구를 활용하여 프로젝트 개발 및 런칭 시간을 크게 단축.
          </li>
          <li>
            요구사항 분석, 비즈니스 요구에 따라 관련 마케팅 도구 및 기존 정보 시스템 기능의 확장 또는 반복을 탐색 및 후속 조치.
          </li>
          <li>
            서버 운영 및 유지보수, 프로젝트 온라인 배포, 실제 프로젝트 요구 및 예상 방문자 트래픽에 따라 리소스 사용량을 추정하여 비용 절감 달성.
          </li>
          <li>
            등록 및 컴플라이언스, 프로젝트 기능 및 관련 규제 요구사항에 따라 프로젝트 등록 및 기술 컴플라이언스 처리를 완료.
          </li>
          <li>
            검색 엔진 최적화(SEO & GEO), 프로젝트 정보의 노출 및 인용 확률을 높여 도달률을 향상.
          </li>
        </ul>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <span class="project-name"
            >상하이 링강 징홍 보안방범과기발전유한공사 웹사이트 시스템</span
          >
          <span class="entry-date">2025년 7월 - 2025년 9월</span>
        </div>
        <div class="project-meta">
          독립적으로 설계 및 개발한 AI 강화 비즈니스 시스템 · 풀스택 개발, AI 통합, UX/UI 디자인 · 성과: <a
            href="https://www.lingangjh.com"
            target="_blank">www.lingangjh.com</a
          >
        </div>
        <ul class="project-points">
          <li>
            Next.js 기반 반응형 공식 웹사이트 및 CMS 백엔드의 풀스택 개발, 기업 지식베이스 AI 상호작용을 위한 LLM 기반 지능형 Q&A 어시스턴트(Weknora) 지역화 배포.
          </li>
          <li>
            Prisma를 사용하여 데이터베이스 모델을 설계하고, JWT, RLS, CSP를 활용한 다층 보안을 구성.
          </li>
          <li>
            시스템 아키텍처, 프론트엔드/백엔드 개발 및 프로덕션 배포를 독립적으로 수행하며, 웹사이트 디스플레이, 콘텐츠 관리 및 채용 업무 워크플로우를 포괄.
          </li>
        </ul>
      </div>

      <div
        id="project-toggle-btn-container"
        style="text-align: center; margin-top: -10px; margin-bottom: 20px;"
      >
        <button id="toggle-projects-btn" class="toggle-projects-btn"
          >더 많은 프로젝트 보기 <i
            class="fas fa-chevron-down"
            style="font-size: 11px; margin-left: 4px;"></i></button
        >
      </div>
    </section>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const projects = document.querySelectorAll(".project-entry");
        const toggleBtn = document.getElementById("toggle-projects-btn");
        const btnContainer = document.getElementById(
          "project-toggle-btn-container",
        );
        const maxVisible = 3;

        if (!toggleBtn || !btnContainer) return;

        if (projects.length <= maxVisible) {
          btnContainer.style.display = "none";
        } else {
          projects.forEach((project, index) => {
            if (index >= maxVisible) {
              project.classList.add("hidden");
            }
          });

          if (projects[maxVisible - 1]) {
            projects[maxVisible - 1].classList.add("no-border");
          }

          toggleBtn.addEventListener("click", () => {
            const isExpanded =
              toggleBtn.getAttribute("data-expanded") === "true";

            if (isExpanded) {
              projects.forEach((project, index) => {
                if (index >= maxVisible) {
                  project.classList.add("hidden");
                }
              });

              if (projects[maxVisible - 1]) {
                projects[maxVisible - 1].classList.add("no-border");
              }

              toggleBtn.innerHTML =
                '더 많은 프로젝트 보기 <i class="fas fa-chevron-down" style="font-size: 11px; margin-left: 4px;"></i>';
              toggleBtn.setAttribute("data-expanded", "false");
            } else {
              projects.forEach((project) => {
                project.classList.remove("hidden");
              });

              if (projects[maxVisible - 1]) {
                projects[maxVisible - 1].classList.remove("no-border");
              }

              toggleBtn.innerHTML =
                '프로젝트 접기 <i class="fas fa-chevron-up" style="font-size: 11px; margin-left: 4px;"></i>';
              toggleBtn.setAttribute("data-expanded", "true");
            }
          });
        }
      });
    </script>

    <section>
      <h2>수상 및 자격증</h2>
      <div class="award-row">
        <span class="award-name"
          >CTyun Advanced O&M Engineer Certification & CTyun Advanced Developer Certification (SCCP)</span
        >
        <span class="award-date">May & 2024년 11월</span>
