      "https://x.com/wilboerht",
      "https://www.linkedin.com/in/wilboerht/"
    ],
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "상하이과학기술직업학원"
      }
    ],
    "knowsAbout": [
      "TypeScript",
      "React",
      "Next.js",
      "Vue 3",
      "Node.js",
      "FastAPI",
      "Prisma",
      "PostgreSQL",
      "Redis",
      "Large Language Models",
      "RAG",
      "Docker",
      "Linux"
    ],
    "jobTitle": "디지털 개발 매니저",
    "worksFor": {
      "@type": "Organization",
      "@id": "https://nihplod.cn/#organization",
      "name": "모이다스",
      "url": "https://nihplod.cn"
    },
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": '상하이 "스타라이트 플랜" 기술 경연대회 "웹 기술" 부문 3등 (시 전체 16위)',
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "인력자원사회보장부 직업기능등급증서: 컴퓨터 프로그래머 3급 (고급) (경연)",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "국가 정보안전 수준 시험 2급 (NISP)",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "CTyun 고급 개발자 인증 (SCCP)",
