---
import Layout from "../layouts/Layout.astro";
import PrintFooter from "../components/PrintFooter.astro";
import "../styles/global.css";
import "../styles/cv.css";

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://cv.wilboerht.com/CV-kr/#page",
  "url": "https://cv.wilboerht.com/CV-kr/",
  "inLanguage": "ko",
  "dateModified": new Date().toISOString(),
  "mainEntity": {
    "@type": "Person",
    "@id": "https://www.wilboerht.com/#person",
    "name": "왕홍곤",
    "alternateName": "Hongkun Wang",
    "givenName": "Hongkun",
    "familyName": "Wang",
    "description": "상하이에 거주하는 디지털 개발 매니저이자 풀스택 엔지니어(TypeScript / React / Next.js / AI / RAG). 브랜드 중화권 사업부의 첫 엔지니어로 이커머스, SSO, AI 어드바이저, 고객 서비스 시스템을 0에서 1로 구축.",
    "email": "me@wilboerht.cn",
    "url": "https://www.wilboerht.com",
    "image": "https://cv.wilboerht.com/og-image.png",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "상하이",
      "addressCountry": "CN"
    },
    "sameAs": [
      "https://github.com/Wilboerht",
      "https://twitter.com/wilboerht"
    ],
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "상하이과학기술직업학원"
      }
    ],
    "knowsAbout": [
      "TypeScript",
      "React",
      "Next.js",
      "Vue 3",
      "Node.js",
      "FastAPI",
      "Prisma",
      "PostgreSQL",
      "Redis",
      "Large Language Models",
      "RAG",
      "Docker",
      "Linux"
    ],
    "jobTitle": "디지털 개발 매니저",
    "worksFor": {
      "@type": "Organization",
      "name": "모이다스",
      "url": "https://www.nihplod.cn"
    },
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": '상하이 "스타라이트 플랜" 기술 경연대회 "웹 기술" 부문 3등 (시 전체 16위)',
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "인력자원사회보장부 직업기능등급증서: 컴퓨터 프로그래머 3급 (고급) (경연)",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "국가 정보안전 수준 시험 2급 (NISP)",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "CTyun 고급 개발자 인증 (SCCP)",
        "dateCreated": "2024-11"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "알리바바 클라우드 ACA 클라우드 보안 어소시에이트 인증",
        "dateCreated": "2024-10"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "CTyun 고급 운영 엔지니어 인증",
        "dateCreated": "2024-05"
      }
    ],
    "award": '상하이 "스타라이트 플랜" 기술 경연대회 "웹 기술" 부문 3등'
  }
};
---

<Layout title="왕홍곤 · 디지털 개발 매니저 · 풀스택 엔지니어 - 이력서" lang="ko">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld, null, 2)} />
  </Fragment>
  <style>
    :root {
      --cv-font-body: 'Noto Serif SC', 'Source Serif 4', serif;
    }
  </style>

  <div class="container">
    <header>
      <h1>왕홍곤</h1>
      <div class="contact-info">
        <span class="contact-item"><a href="mailto:me@wilboerht.cn">me@wilboerht.cn</a></span>
        <span class="contact-item"><a href="tel:+8618721400154">+86 187 2140 0154</a></span>
        <span class="contact-item"><a href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer">GitHub</a></span>
        <span class="contact-item"><a href="https://www.wilboerht.com" target="_blank" rel="noopener noreferrer">wilboerht.com</a></span>
      </div>
    </header>

    <section>
      <h2>경력</h2>
      <div class="entry">
        <div class="entry-header">
          <h3 class="entry-org"
            >모이다스 | NIHPLOD 중화권 사업부 — 디지털 개발 매니저</h3>
          <span class="entry-date">2025년 10월 – 현재</span>
        </div>
        <p class="entry-role-detail">
          2025년 10월 인턴으로 합류하여 졸업 전 풀타임 근무, 2026년 7월 정규직 전환, 브랜드 책임자에게 직접 보고; 사업부 최초의 기술 인력으로서 브랜드 중화권 전체 정보 시스템 및 디지털 인프라를 0에서 1까지 콜드 스타트.
        </p>
        <ul class="project-points">
          <li>브랜드 중화권 디지털 제품 포트폴리오(공식 이커머스 사이트, 통합 인증 SSO, AI 스킨케어 어드바이저, 위챗 AI 고객서비스, 미니 프로그램 스토어, 인증 검증 등 6개 핵심 시스템)의 기획 및 딜리버리 총괄.</li>
          <li>AI 보조 개발 워크플로우 및 디자인 표준 수립, 평균 딜리버리 주기 50% 이상 단축, 다수 프로젝트 병렬 딜리버리 보장.</li>
          <li>기술 책임자로서 제품·마케팅 팀의 요구사항을 접수·분해하여 일정 수립, 요구사항 리뷰 및 반복 주기 주도, 브랜드 온라인 리테일 채널(공식 이커머스 + 미니 프로그램 스토어)의 0부터 론칭까지 지원.</li>
        </ul>
      </div>
      <div class="entry">
        <div class="entry-header">
          <h3 class="entry-org"
            >상하이 링강 징홍 보안방범과기발전유한공사 — R&amp;D 인턴</h3>
          <span class="entry-date">2025년 7월 – 2025년 9월</span>
        </div>
        <ul class="project-points">
          <li>기업 웹사이트 전 과정(아키텍처, UI/UX, 풀스택 개발, 프로덕션 배포) 딜리버리 독립 완료.</li>
          <li>Unitree 로봇견 SDK 기반 2차 개발로 단지 순찰 관리 제어 플랫폼 사내 초기 버전 완성, 제품 타당성 검증.</li>
          <li>AI Q&amp;A 어시스턴트 사내 최초 도입 주도, 기업 대표로서 바이두 공식 기업 Q&amp;A 팀과 업무 협업.</li>
        </ul>
      </div>
    </section>

    <section>
      <h2>프로젝트</h2>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name">NIHPLOD 중국 공식 디지털 플랫폼 (포트폴리오)</h3>
          <span class="entry-date">2025년 11월 – 현재</span>
        </div>
        <div class="project-meta">
          성과: <a
            href="https://www.nihplod.cn"
            target="_blank" rel="noopener noreferrer">www.nihplod.cn</a
          >, <a href="https://advisor.nihplod.cn" target="_blank" rel="noopener noreferrer"
            >advisor.nihplod.cn</a
          >, <a href="https://ba.nihplod.cn" target="_blank" rel="noopener noreferrer"
            >ba.nihplod.cn</a
          > 등
        </div>
        <p class="project-abstract">
          기술 책임자로서 브랜드 중화권 디지털 제품 매트릭스의 0에서 1까지 아키텍처 설계 및 컴플라이언스 론칭 총괄, 10개월 동안 6개 핵심 시스템(공식 이커머스 사이트, 통합 인증 SSO, AI 스킨케어 어드바이저, 위챗 AI 고객서비스, 미니 프로그램 스토어, 인증 검증, 하위 항목 참조)의 전 과정 딜리버리를 독립 완료하고 1,400+ 자동화 테스트 케이스 병행; 통합 계정 및 프로필 데이터로 「피부 측정 → 맞춤 솔루션 → 7×24 AI 어드바이저 팔로업 → 재구매」 비즈니스 클로즈드 루프 구축.
        </p>
        <ul class="project-points">
          <li>
            <strong>컴플라이언스 및 운영 거버넌스:</strong> ICP 등록, 개인정보 보호정책·이용약관 제정 주도, 데이터 컴플라이언스 심사 완료로 다중 시스템의 컴플라이언스 론칭 보장; 트래픽 기반 서버 리소스 동적 조정으로 비용 최적화.
          </li>
        </ul>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name">위챗 AI 스마트 고객서비스</h3>
          <span class="entry-date">2026년 8월</span>
        </div>
        <ul class="project-points">
          <li>
            <strong>멀티 채널 메시징 게이트웨이:</strong> FastAPI + Redis + DeepSeek LLM 기반 구축, 기업위챗 고객서비스·기업위챗 앱·위챗 공중번호 3개 메시지 채널 통합; 스마트 상담원 전환 지원(키워드 인식 + 근무 시간 판단 + 이전 담당 상담원 고정 배정).
          </li>
          <li>
            <strong>동행형 세션 운영:</strong> 피부 측정 플랫폼에서 전달된 사용자 프로필을 이어받아 다중 턴 대화 중 피부 프로필 자동 축적(단계별 목표 관리 및 재평가 알림) 및 주문 조회 가이드 제공 — 일회성 문의를 장기 동행형 팔로업으로 전환.
          </li>
          <li>
            <strong>프롬프트 및 지식 베이스 엔지니어링:</strong> 고객서비스 계정별로 2종 페르소나(브랜드 상담 / 스킨케어 어드바이저)의 독립 프롬프트·지식 베이스 라우팅; 44KB 브랜드 FAQ 지식 베이스를 세그먼트로 구축하여 메시지 키워드 매칭 기반 온디맨드 주입 및 핫 리로드 지원; 프롬프트 인젝션 방어와 광고법 금지어 출력 필터링 이중 컴플라이언스 안전장치 내장.
          </li>
          <li>
            <strong>품질 보장 및 가용성:</strong> 실제 LLM 기반 골든 회귀 테스트 34건으로 프롬프트 반복 품질 고정, 340+ 자동화 테스트 지원; AI 호출 지수 백오프 재시도 및 타임아웃 제어, Redis 장애 시 인메모리 모드 자동 다운그레이드 및 주기적 재연결 복구; PII 내보내기/삭제 API(개인정보보호법 준수), Linux + Nginx 자체 호스팅.
          </li>
        </ul>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name">NIHPLOD 풀스택 이커머스 시스템(위챗 미니 프로그램 + H5 + 관리자 콘솔)</h3>
          <span class="entry-date">2026년 5월 – 현재</span>
        </div>
        <ul class="project-points">
          <li>
            <strong>풀스택 커머스 클로즈드 루프:</strong> uni-app + Vue 3 + Express 5 + Prisma + PostgreSQL 기반 구축(미니 프로그램/H5 듀얼 빌드 + 독립 관리자 콘솔), 위챗 페이 V3·환불 체인·SF Express 물류·SMS 알림 전 구간 연동; 쿠폰·포인트 등 마케팅 메커닉 탑재.
          </li>
          <li>
            <strong>피부 프로필 데이터 연동:</strong> 미니 프로그램에 피부 측정 진입점 내장(web-view)하여 AI 피부 측정으로 유도, 측정 프로필을 휴대폰 번호로 연동·자동 동기화하여 피부 트렌드·과거 리포트·매일 스킨케어 체크인 제공 — 측정 트래픽을 「측정 → 팔로업 → 재구매」 프라이빗 도메인 장기 운영 자산으로 전환.
          </li>
          <li>
            <strong>엔지니어링 및 보안:</strong> RBAC 권한 분급·감사 로그·다단계 속도 제한 구현, 자체 인메모리 캐시(요청 중복 제거로 캐시 브레이크다운 방지); 26개 데이터 모델·191개 자동화 테스트(동시 주문 테스트 포함), Docker 멀티 스테이지 빌드 배포.
          </li>
        </ul>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name">NIHPLOD 브랜드 인증 검증 플랫폼</h3>
          <span class="entry-date">2026년 4월 – 2026년 5월</span>
        </div>
        <div class="project-meta">
          성과: <a href="https://ba.nihplod.cn" target="_blank" rel="noopener noreferrer"
            >ba.nihplod.cn</a
          >
        </div>
        <ul class="project-points">
          <li>
            <strong>인증 심사 및 위조 방지 인증서:</strong> Next.js + Prisma + PostgreSQL 기반 딜러 인증 관리 시스템 구축, 「신청 — 1차 심사 — 최종 발급」 다단계 심사 플로우 구현; Canvas 자동 합성으로 전자 직인과 동적 QR코드가 포함된 위조 방지 인증서 생성(PNG/PDF 다운로드).
          </li>
          <li>
            <strong>공개 조회 및 보안 체계:</strong> 「정확 → 접두사 → 퍼지」 3단계 폴백 진위 조회(pg_trgm 인덱스 가속) 및 가품 신고 티켓 시스템 제공; JWT 블랙리스트, DB 영속 속도 제한, 전 과정 감사 로그 적용.
          </li>
        </ul>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name">AI 스킨케어 어드바이저 시스템</h3>
          <span class="entry-date">2026년 1월 – 현재</span>
        </div>
        <div class="project-meta">
          성과: <a href="https://advisor.nihplod.cn" target="_blank" rel="noopener noreferrer"
            >advisor.nihplod.cn</a
          >
        </div>
        <ul class="project-points">
          <li>
            <strong>AI 피부 측정 및 개인화 추천:</strong> qwen-vl / deepseek-vl 비전 LLM 연동으로 「설문 + 얼굴 스캔」 듀얼 채널 피부 분석 구현, 자체 룰 엔진으로 8종 피부 유형 페르소나별 제품 스코어링(백오피스 시각화 설정으로 운영팀 무코드 조정) 및 멀티 채널 커머스 링크 어트리뷰션; 모델 통합 및 핵심 API 개발 주도, 상담 전환율 30% 향상 기여.
          </li>
          <li>
            <strong>그로스 및 바이럴 설계:</strong> 게스트 모드(디바이스 핑거프린트 + 기한 한정 프로필)로 무등록 피부 측정 지원, 공유 포스터 생성 및 채널 피션 어트리뷰션으로 소셜 확산 견인; 비식별 통계 데이터를 브랜드 백서 및 시장 인사이트에 환류하여 도구를 브랜드 데이터 자산으로 전환.
          </li>
          <li>
            <strong>AI 비용 엔지니어링:</strong> AI 호출에 서킷 브레이커 및 일/월 토큰 예산 차단, 호출 과금 영속화, 모델 화이트리스트 폴백 설계 — 5xx 재시도로 인한 중복 과금 리스크 수정; 사용자 리포트 90일 롤링 갱신 및 핫/콜드 계층 아카이빙(콜드 티어 비식별 요약).
          </li>
          <li>
            <strong>데이터 자산 클로즈드 루프:</strong> 서버 간 인증 API 설계로 피부 측정 리포트와 프로필이 세션과 함께 위챗 AI 어드바이저에 원클릭 전달(session_id 전달), 일회성 측정을 지속 운영 가능하고 재구매를 견인하는 사용자 데이터 자산으로 전환.
          </li>
        </ul>
      </div>

      <div class="project-entry">
        <div class="entry-header">
