---
import Layout from "../layouts/Layout.astro";
import PrintFooter from "../components/PrintFooter.astro";
import MermaidDiagram from "../components/MermaidDiagram.astro";
import { moidasArchitecture } from "../diagrams/moidas-architecture";
import { CONTENT_LAST_UPDATED } from "../data/site";
import "../styles/global.css";
import "../styles/cv.css";

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://cv.wilboerht.com/CV-jp/#page",
  "url": "https://cv.wilboerht.com/CV-jp/",
  "inLanguage": "ja",
  "name": "王泓坤 - 履歴書",
  "description": "上海を拠点とするデジタル開発マネージャー兼フルスタックエンジニア、王泓坤のプロフィールページ。",
  "isPartOf": { "@id": "https://cv.wilboerht.com/#website" },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".tagline", ".entry-summary"]
  },
  "dateModified": CONTENT_LAST_UPDATED,
  "mainEntity": {
    "@type": "Person",
    "@id": "https://wilboerht.com/#person",
    "name": "王泓坤",
    "alternateName": ["Hongkun Wang", "Hank Wong", "wilboerht"],
    "givenName": "Hongkun",
    "familyName": "Wang",
    "description": "上海を拠点とするデジタル開発マネージャー兼フルスタックエンジニア（TypeScript / React / Next.js / AI / RAG）。Moidas（NIHPLOD）大中華圏事業部初のエンジニアとして、ブランド公式サイト、会員・ポイント制度、統合認証、AIアドバイザー、カスタマーサービス、ミニプログラムをゼロから構築。",
    "email": "me@wilboerht.cn",
    "url": "https://wilboerht.com",
    "image": "https://cv.wilboerht.com/og-image.png",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "上海",
      "addressCountry": "CN"
    },
    "sameAs": [
      "https://github.com/wilboerht",
      "https://x.com/wilboerht",
      "https://www.linkedin.com/in/wilboerht/"
    ],
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "上海科学技術職業学院"
      }
    ],
    "knowsAbout": [
      "TypeScript",
      "React",
      "Next.js",
      "Vue 3",
      "Node.js",
      "FastAPI",
      "Prisma",
      "PostgreSQL",
      "Redis",
      "Large Language Models",
      "RAG",
      "Docker",
      "Linux"
    ],
    "jobTitle": "デジタル開発マネージャー",
    "worksFor": {
      "@type": "Organization",
      "@id": "https://nihplod.cn/#organization",
      "name": "Moidas",
      "url": "https://nihplod.cn"
    },
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": "上海市「星光計画」職業技能競技大会「Web技術」部門3等賞（上海市16位）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "人力資源社会保障部 職業技能等級証書：コンピュータープログラマー3級（上級）（競技）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "国家情報セキュリティレベル試験2級（NISP）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "CTyun上級開発者認定（SCCP）",
        "dateCreated": "2024-11"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "Alibaba Cloud ACAクラウドセキュリティアソシエイト認定",
        "dateCreated": "2024-10"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "CTyun上級運用保守エンジニア認定",
        "dateCreated": "2024-05"
      }
    ],
    "award": "上海市「星光計画」職業技能競技大会「Web技術」部門3等賞"
  }
};
---

<Layout title="王泓坤 - 履歴書" lang="ja">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld, null, 2)} />
  </Fragment>
  <div class="container">
    <header>
      <h1>王泓坤</h1>
      <p class="tagline">デジタル開発マネージャー · フルスタックエンジニア · 上海</p>
      <div class="contact-info">
        <span class="contact-item"><a href="mailto:me@wilboerht.cn">me@wilboerht.cn</a></span>
        <span class="contact-item"><a href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer">GitHub</a></span>
        <span class="contact-item"><a href="https://wilboerht.com" target="_blank" rel="noopener noreferrer">wilboerht.com</a></span>
      </div>
    </header>

    <section>
      <h2>職務経歴</h2>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">Moidas · NIHPLOD 大中華圏事業部</h3>
          <div class="entry-meta">
            <span class="entry-role">デジタル開発マネージャー</span>
            <span class="entry-date">2025年10月 – 現在</span>
          </div>
        </div>
        <p class="entry-summary">
          2025年10月にインターンとして入社し、2026年7月に正社員へ登用。ブランド責任者に直接報告。事業部初のエンジニアとして、プロダクト思考とAI活用型のワークフローを駆使し、要件定義・設計から開発・リリースまでのフルスタック開発を独力で担当。12か月で7つの基幹システムと2,100件以上の自動化テストをゼロから構築し、統一アカウントとプロフィールデータを通じて「肌診断 → パーソナライズされたスキンケア提案 → AIアドバイザーによるフォローアップ → リピート購入」のビジネスサイクルを実現。
        </p>
        <ul class="project-points">
          <li>大中華圏におけるブランドのデジタルプロダクト群について、企画・技術選定・フルスタック開発を統括。7つの基幹システムの要件定義、設計、開発、リリース、運用まで全ライフサイクルを担当。</li>
          <li>ブランド・運営チームと協力し、4段階の会員ランク、特典、ポイント、交換ルールを含む大中華圏向け会員制度の策定に貢献。公式サイトとミニプログラムの会員センターに実装し、会員定着とリピート購入を支援。</li>
          <li>AI活用型の開発ワークフローとデザイン標準を確立し、平均開発期間を50%以上短縮すると同時に、複数プロジェクトの並行開発を実現。</li>
          <li>技術リードとして、プロダクト・マーケティングチームからの要件を受けてスケジュールに分解。要件レビューとイテレーションの進行を管理し、ブランドのオンライン直販チャネル（中国公式サイト）をゼロから立ち上げ。</li>
          <li>ICP届出、プライバシーポリシー・利用規約の起草、データコンプライアンス審査を主導し、各システムのコンプライアンスを確保。トラフィックに応じてサーバーリソースを動的に調整し、コストを最適化。</li>
        </ul>
        <MermaidDiagram
          code={moidasArchitecture.ja}
          alt="Moidas大中華圏デジタルシステムの構成図：統一SSOが公式サイト、AI肌診断、AIカスタマーサービス、認証確認を接続"
          zoomLabel="拡大表示"
          closeLabel="閉じる"
        />
      </div>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">上海臨港景鴻安全防範科技発展有限公司</h3>
          <div class="entry-meta">
            <span class="entry-role">研究開発インターン</span>
            <span class="entry-date">2025年7月 – 2025年9月</span>
          </div>
        </div>
        <ul class="project-points">
          <li>アーキテクチャ設計、UI/UXデザインから本番環境へのデプロイまで、企業公式サイトの全工程を独力で担当。</li>
          <li>Unitreeロボット犬SDKの二次開発により、構内巡回管理プラットフォームの社内MVPを完成させ、製品の実現可能性を検証。</li>
          <li>AI Q&amp;Aツールの社内初導入を推進し、百度公式の企業向けQ&amp;Aチームとの業務連携に参画。</li>
        </ul>
      </div>
    </section>

    <section>
      <div class="project-section-head">
        <h2>プロジェクト経歴</h2>
        <a class="project-github-link" href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer" aria-label="GitHubでさらに見る">
          <svg class="project-github-link__icon" aria-hidden="true"><use href="#icon-github"></use></svg>
          GitHubでさらに見る
        </a>
      </div>

      <div class="project-entry" data-project-logo="/images/NIHPLOD-logo.svg" id="project-website">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-website" aria-haspopup="dialog">NIHPLOD 中国公式サイト</button></h3>
          <span class="entry-date">2025年11月 – 現在</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">プロダクト・デザイン・フルスタック開発：独立担当</span> <a href="https://nihplod.cn" target="_blank" rel="noopener noreferrer" class="project-meta-link"><span>nihplod.cn</span><svg class="project-meta-link__icon" aria-hidden="true"><use href="#icon-external"></use></svg></a>
        </div>
        <p class="project-summary">中国市場向けブランドサイト兼会員プラットフォーム。商品紹介、EC誘導、会員ポイント、肌プロフィールを一つの体験に統合し、WeChat・Douyin・電話番号のIDを統一。オンライン販売とリピート購入をゼロから支援。205 APIルート / 51データモデル / 2,100件以上のテスト。</p>
        <button type="button" class="project-more" data-project-dialog="project-website" aria-haspopup="dialog" aria-label="詳細を見る：NIHPLOD 中国公式サイト"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>詳細を見る</button>
        <dialog class="project-dialog" id="dialog-project-website">
          <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="閉じる">&times;</button>
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
            </div>
            <div class="project-dialog__content">
            <ul class="project-points">
              <li>
                <strong>ブランドサイト・会員プラットフォーム：</strong>Next.js 16 + Prisma + PostgreSQLでブランド公式サイトと会員プラットフォームを構築。商品紹介、外部EC誘導（Tmall / Douyin / Xiaohongshu / WeChat Shopリンク + GAイベント計測）、会員ランク、ポイント台帳、ポイント交換（SF Express配送追跡）、購入実績の補登録、肌プロフィール、セキュリティセンターを実装。WeChat・Douyin・電話番号OTPのIDを統一アカウントに集約。205 APIルート、51データモデル、2,100件以上の自動化テストを整備。
              </li>
              <li>
                <strong>プロダクト・インタラクション設計：</strong>情報アーキテクチャ、Figmaインタラクティブプロトタイプ、ビジュアルスタイルを独力で設計。Framer Motion + View Transitionsによる多段階スキンケアガイドと没入型ブランドストーリーを構築し、商品ドロワーと詳細ページを連携。完全レスポンシブレイアウトを実装。
              </li>
              <li>
                <strong>管理画面・セキュリティガバナンス：</strong>商品・カテゴリー・会員・ポイント交換・購入実績補登録・ジョブ・メッセージ・OAuthクライアント（Tiptapリッチテキスト）を管理する管理画面を構築。TOTP二要素認証、重要操作の再認証、操作監査ログと日次完全性アンカー、定期ジョブ、データベース永続化レート制限、Webhook失敗時リトライを実装。SEO / GEO（sitemap / JSON-LD / llms.txt / 百度プッシュ）に対応。
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

      <div class="project-entry" data-project-logo="/images/NIHPLOD-logo.svg" id="project-sso">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-sso" aria-haspopup="dialog">NIHPLOD 統合認証プラットフォーム（SSO / OIDC）</button></h3>
          <span class="entry-date">2026年7月 – 現在</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">プロダクト・フルスタック開発：独立担当</span>
        </div>
        <p class="project-summary">大中華圏向け統一ID基盤。独自開発のOAuth 2.0 / OIDCシングルサインオンで、公式サイト、肌診断サイト、2つのミニプログラム、管理画面を接続。5システム間のクロスドメインログインとグローバルログアウトを実現し、管理画面にTOTP二要素認証を導入。再利用可能なnpm SDKとして提供。</p>
        <button type="button" class="project-more" data-project-dialog="project-sso" aria-haspopup="dialog" aria-label="詳細を見る：NIHPLOD 統合認証プラットフォーム（SSO / OIDC）"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>詳細を見る</button>
        <dialog class="project-dialog" id="dialog-project-sso">
          <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="閉じる">&times;</button>
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
            </div>
            <div class="project-dialog__content">
            <ul class="project-points">
              <li>
                <strong>プロトコル実装：</strong>自社ホスト型OAuth 2.0 / OIDC SSOを構築し、公式メインサイトと同じ環境にデプロイ。認可サーバーとしてRS256 JWTを発行し、authorize / token / userinfo / introspect / revoke / end-sessionの各プロトコルエンドポイントを完全実装。PKCEとDPoPに対応し、管理画面はTOTP二要素認証で保護。
              </li>
              <li>
                <strong>SDK・システム連携：</strong>npm SDK（@nihplod/sso-sdk / @nihplod/sso-verify）をパッケージ化して公開し、各サブプロジェクトへ数分で導入可能に。Token Introspection + Backchannel LogoutによるクロスドメインSSOとグローバルログアウトを実現し、公式サイト、肌診断サイト、2つのWeChatミニプログラム、管理画面の統一ログインをサポート。
              </li>
              <li>
                <strong>セキュリティ強化：</strong>シークレットローテーション、トークン失効（RFC 7009）、複数インスタンス間のブラックリスト共有に対応し、運用・監査可能な認証基盤を実現。
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

      <div class="project-entry" data-project-logo="/images/NIHPLOD-logo.svg" id="project-ai-advisor">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-ai-advisor" aria-haspopup="dialog">AIスキンケアアドバイザーシステム</button></h3>
          <span class="entry-date">2026年1月 – 現在</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">プロダクト・インタラクション・フルスタック開発：独立担当</span> <span class="project-meta-note">ビジュアルデザインは協働</span> <a href="https://smart.nihplod.cn" target="_blank" rel="noopener noreferrer" class="project-meta-link"><span>smart.nihplod.cn</span><svg class="project-meta-link__icon" aria-hidden="true"><use href="#icon-external"></use></svg></a>
        </div>
        <p class="project-summary">消費者向けAIスキンケアアドバイザー。問診と顔画像による2チャネルの肌診断、肌質・季節・地域に基づくパーソナライズ商品提案を提供。レポートと肌プロフィールをWeComアドバイザーへ連携し、診断からスキンケア提案、フォローアップ、リピート購入までの循環を実現。93 APIルート / 531テスト。</p>
        <button type="button" class="project-more" data-project-dialog="project-ai-advisor" aria-haspopup="dialog" aria-label="詳細を見る：AIスキンケアアドバイザーシステム"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>詳細を見る</button>
        <dialog class="project-dialog" id="dialog-project-ai-advisor">
          <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="閉じる">&times;</button>
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
            </div>
            <div class="project-dialog__content">
            <ul class="project-points">
              <li>
                <strong>AI肌診断・パーソナライズ提案：</strong>Tongyi Qianwen VL / DeepSeek LLMを統合し、問診と顔画像による2チャネルの肌診断を実現。独自ルールエンジンが8種類の肌質ペルソナと季節・地域の環境要因に基づいて商品を採点・マッチング。ビジュアル管理画面から設定でき、運営担当者がコードなしで調整可能。
              </li>
              <li>
                <strong>コンバージョン・アトリビューション：</strong>モデル連携とコアAPI開発を主導。外部ECリンク（Tmall / Douyin / Xiaohongshu / WeChat Shop）にUTM / pidトラッキングとクリックイベント計測を実装し、WeComアドバイザーの短縮リンクと組み合わせて、相談から購入までの経路を測定可能に。
              </li>
              <li>
                <strong>グロース・会員運営：</strong>4段階の会員ランクに応じた肌診断回数を連携（Standard：生涯10回、Silver：基本10回 + 1,000元の購入ごとに20回・1日最大10回、Gold / Diamond：回数無制限・1日最大10回）。レポートと肌プロフィールをログインアカウントに紐付け、シェアポスター、チャネルrefアトリビューション、登録コンバージョンポップアップを設計。匿名化した集計CSVをエクスポートし、ブランド白書と市場インサイトに活用。
              </li>
              <li>
                <strong>AIコスト・信頼性設計：</strong>同時実行制御、サーキットブレーカー、日次・月次のトークン及びコスト予算による停止、呼び出しごとの課金記録の永続化、モデルホワイトリストとプロバイダーフォールバックを備えたAIリクエストキューを設計。冪等リトライと利用枠の事前確保・解放により二重課金を防止。現在の肌プロフィールには90日間の有効期限を設けて再診断を促し、完全レポートは365日間保持。ホット・コールド階層アーカイブにより、最新10件の完全レポートと匿名化したコールド層サマリーを最長3年間保持。
              </li>
              <li>
                <strong>データ資産の循環：</strong>HMAC署名とIPレート制限を備えたサーバー間APIを設計。肌診断レポートとスキンケアプロフィールをsession_id経由でWeCom AIカスタマーサービスに連携し、単発の肌診断を継続的に運用可能なリピート購入促進データ資産へ転換。
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

    </section>

    <section>
      <h2>技術スタック</h2>
      <div class="skills-row">
        <span class="skills-label">フロントエンド・ミニプログラム：</span>
        <span class="skills-content">TypeScript · React · Next.js · Vue 3 · uni-app · WeChatミニプログラム · Tailwind CSS · Canvas 2D</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">バックエンド・データ：</span>
        <span class="skills-content">Node.js · Python（FastAPI） · Prisma · PostgreSQL · Redis · RESTful API</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">AIエンジニアリング：</span>
        <span class="skills-content">LLM連携 · 画像による肌診断 · RAG · プロンプト / ナレッジベース · AIコスト制御（サーキットブレーカー / 予算） · 評価・リグレッション · AI支援開発（Claude Code / Codex）</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">開発基盤・プラットフォーム：</span>
