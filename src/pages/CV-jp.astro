---
import Layout from "../layouts/Layout.astro";
import PrintFooter from "../components/PrintFooter.astro";
import MermaidDiagram from "../components/MermaidDiagram.astro";
import { moidasArchitecture } from "../diagrams/moidas-architecture";
import { CONTENT_LAST_UPDATED } from "../data/site";
import "../styles/global.css";
import "../styles/cv.css";

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://cv.wilboerht.com/CV-jp/#page",
  "url": "https://cv.wilboerht.com/CV-jp/",
  "inLanguage": "ja",
  "name": "王泓坤 - 履歴書",
  "description": "上海を拠点とするデジタル開発マネージャー兼フルスタックエンジニア、王泓坤のプロフィールページ。",
