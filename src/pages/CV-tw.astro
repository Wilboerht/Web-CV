---
import Layout from "../layouts/Layout.astro";
import PrintFooter from "../components/PrintFooter.astro";
import MermaidDiagram from "../components/MermaidDiagram.astro";
import { moidasArchitecture } from "../diagrams/moidas-architecture";
import { CONTENT_LAST_UPDATED } from "../data/site";
import "../styles/global.css";
import "../styles/cv.css";

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://cv.wilboerht.com/CV-tw/#page",
  "url": "https://cv.wilboerht.com/CV-tw/",
  "inLanguage": "zh-TW",
  "name": "王泓坤 - 履歷",
  "description": "王泓坤的個人履歷頁面：常駐上海的數位開發經理、全端工程師。",
  "isPartOf": { "@id": "https://cv.wilboerht.com/#website" },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".tagline", ".entry-summary"]
  },
  "dateModified": CONTENT_LAST_UPDATED,
  "mainEntity": {
    "@type": "Person",
    "@id": "https://wilboerht.com/#person",
    "name": "Hongkun Wang",
    "alternateName": ["王泓坤", "Hank Wong", "wilboerht", "왕홍곤"],
    "givenName": "Hongkun",
    "familyName": "Wang",
    "description": "數位開發經理、全棧工程師（TypeScript / React / Next.js / AI / RAG），常駐上海。作為 Moidas（NIHPLOD）大中華區首位工程師，從零打造品牌官網、會員與積分體系、統一認證（SSO）、AI 護膚顧問、企微 AI 客服、授權驗真與雙小程式等數位系統。",
    "email": "me@wilboerht.cn",
