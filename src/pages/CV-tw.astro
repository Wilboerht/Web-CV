---
import Layout from "../layouts/Layout.astro";
import PrintFooter from "../components/PrintFooter.astro";
import "../styles/global.css";
import "../styles/cv.css";

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://cv.wilboerht.com/CV-tw/#page",
  "url": "https://cv.wilboerht.com/CV-tw/",
  "inLanguage": "zh-TW",
  "dateModified": new Date().toISOString(),
  "mainEntity": {
    "@type": "Person",
    "@id": "https://www.wilboerht.com/#person",
    "name": "王泓坤",
    "alternateName": "Hongkun Wang",
    "givenName": "泓坤",
    "familyName": "王",
    "description": "數位開發經理、全棧工程師（TypeScript / React / Next.js / AI / RAG），常駐上海。作為品牌大中華區首位工程師，從 0 到 1 打造品牌電商、統一認證（SSO）、AI 顧問與智慧客服等數位系統。",
    "email": "me@wilboerht.cn",
    "url": "https://www.wilboerht.com",
    "image": "https://cv.wilboerht.com/og-image.png",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "上海",
      "addressCountry": "CN"
    },
    "sameAs": [
      "https://github.com/Wilboerht",
      "https://twitter.com/wilboerht"
    ],
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "上海科學技術職業學院"
      }
    ],
    "knowsAbout": [
      "TypeScript",
      "React",
      "Next.js",
      "Vue 3",
      "Node.js",
      "FastAPI",
      "Prisma",
      "PostgreSQL",
      "Redis",
      "Large Language Models",
      "RAG",
      "Docker",
      "Linux"
    ],
    "jobTitle": "數位開發經理",
    "worksFor": {
      "@type": "Organization",
      "name": "穆埃達思 Moidas",
      "url": "https://www.nihplod.cn"
    },
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": "上海市“星光計畫”職業院校技能競賽“網站技術”三等獎（上海市第 16 名）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "人社部“職業技能等級證書”電腦程式設計員 三級（高級）（競賽）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "國家資訊安全水平考試二級（NISP）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "天翼雲高級開發工程師認證（SCCP）",
        "dateCreated": "2024-11"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "阿里雲 ACA 雲安全助理工程師認證",
        "dateCreated": "2024-10"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "天翼雲高級運維工程師認證",
        "dateCreated": "2024-05"
      }
    ],
    "award": "上海市“星光計畫”職業院校技能競賽“網站技術”三等獎"
  }
};
---

<Layout title="王泓坤 · 數位開發經理 · 全棧工程師 - 履歷" lang="zh-TW">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld, null, 2)} />
  </Fragment>
  <style>
    :root {
      --cv-font-body: 'Noto Serif SC', 'Source Serif 4', serif;
    }
  </style>

  <div class="container">
    <header>
      <h1>王泓坤</h1>
      <div class="contact-info">
        <span class="contact-item"><a href="mailto:me@wilboerht.cn">me@wilboerht.cn</a></span>
        <span class="contact-item"><a href="tel:+8618721400154">+86 187 2140 0154</a></span>
        <span class="contact-item"><a href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer">GitHub</a></span>
        <span class="contact-item"><a href="https://www.wilboerht.com" target="_blank" rel="noopener noreferrer">wilboerht.com</a></span>
      </div>
    </header>

    <section>
      <h2>工作經歷</h2>
      <div class="entry">
        <div class="entry-header">
          <h3 class="entry-org"
            >穆埃達思 Moidas | 旎柏（大中華區）事業部 —— 數位開發經理</h3>
          <span class="entry-date">2025.10 – 至今</span>
        </div>
        <p class="entry-role-detail">
          2025.10 以實習生身分加入並於畢業前全職在崗，2026.07 轉正，直接彙報品牌負責人；作為事業部首位技術人員，從 0 到 1 冷啟動品牌大中華區全部資訊系統與數位化基礎設施，10 個月內獨立完成 5 個核心系統交付，配套 1400+ 自動化測試用例，並以統一帳號與檔案資料打通「測膚 → 個人化方案 → 7×24 AI 顧問跟進 → 回購」業務閉環。
        </p>
        <ul class="project-points">
          <li>統籌品牌大中華區數位化產品矩陣的規劃與交付，覆蓋中國官網、統一認證（SSO）、AI 護膚顧問、微信 AI 客服、授權驗真 5 個核心系統。</li>
          <li>建立 AI 輔助研發工作流與設計規範，將平均交付週期壓縮 50% 以上，保障多專案並行交付。</li>
          <li>作為技術側負責人承接產品、行銷團隊需求並拆解排期，主導需求評審與迭代節奏，支撐品牌線上零售管道（中國官網）從 0 上線。</li>
          <li>主導 ICP 備案、隱私政策及使用者協議制定，完成資料合規審查，保障多系統合規上線；依據流量動態調整伺服器資源配置，實現成本最佳化。</li>
        </ul>
      </div>
      <div class="entry">
        <div class="entry-header">
          <h3 class="entry-org"
            >上海臨港景鴻安全防範科技發展有限公司 —— 技術研發實習生</h3>
          <span class="entry-date">2025.07 – 2025.09</span>
        </div>
        <ul class="project-points">
          <li>獨立承擔企業官網全鏈路交付，覆蓋從架構設計、UI/UX 設計到生產部署全過程。</li>
          <li>基於宇樹機器狗 SDK 二次開發，完成園區巡邏管理控制平台內部初版並驗證產品可行性。</li>
          <li>推動 AI 問答助手在企業內部首次落地，作為企業代表與百度官方企業問答團隊對接業務合作。</li>
        </ul>
      </div>
    </section>

    <section>
      <h2>項目經歷</h2>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name">NIHPLOD 中國官網</h3>
          <span class="entry-date">2025.11 – 至今（迭代）</span>
        </div>
        <div class="project-meta">
          獨立完成（產品設計 · UI/UX · 全棧開發） · 成果展示：<a
            href="https://www.nihplod.cn"
            target="_blank" rel="noopener noreferrer">www.nihplod.cn</a
          >
        </div>
        <ul class="project-points">
          <li>
            <strong>電商閉環：</strong>基於 Next.js 16 + Prisma + PostgreSQL 構建品牌官網與電商主站，打通微信支付 / 支付寶雙管道支付與退款（非同步通知冪等處理）、順豐物流、會員積分與優惠券體系；聚合微信、抖音、手機號驗證碼多端身分至統一帳號體系（接入統一認證 SSO）；全站 121 個 API 路由、36 個資料模型、824 個測試用例。
          </li>
          <li>
            <strong>產品與互動設計：</strong>從資訊架構、Figma 互動原型到視覺樣式全程獨立設計，基於 Framer Motion + View Transitions 實現多步驟護膚儀式指南與沉浸式品牌敘事，整合產品抽屜與購物車連動，全端響應式適配。
          </li>
        </ul>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name">NIHPLOD 統一認證平台（SSO / OIDC）</h3>
          <span class="entry-date">2026.06 – 至今（迭代）</span>
        </div>
        <div class="project-meta">
          獨立完成（產品設計 · 全棧開發）
        </div>
        <ul class="project-points">
          <li>
            <strong>協定實現：</strong>自建 OAuth 2.0 / OIDC 單一登入，與官網主站同構部署，主站作為 Authorization Server 簽發 JWT（RS256），完整實現 authorize / token / userinfo / introspect / revoke / end-session 協定端點，支援 PKCE、DPoP 與 TOTP 二因素。
          </li>
          <li>
            <strong>SDK 與接入：</strong>封裝並發布 npm SDK（@nihplod/sso-sdk / @nihplod/sso-verify）供子專案分鐘級接入，透過 Token Introspection + Backchannel Logout 實現跨域免登與全域登出，支撐平台群 5 個系統統一登入。
          </li>
          <li>
            <strong>安全加固：</strong>支援金鑰輪換、Token 撤銷（RFC 7009）與多實例黑名單共用，保障認證體系可運維、可稽核。
          </li>
        </ul>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name">AI 護膚顧問系統</h3>
          <span class="entry-date">2026.01 – 至今</span>
        </div>
        <div class="project-meta">
          負責產品設計 · UX 互動 · 全棧開發（UI 視覺由協作設計師完成） · 成果展示：<a href="https://advisor.nihplod.cn" target="_blank" rel="noopener noreferrer"
            >advisor.nihplod.cn</a
          >
        </div>
        <ul class="project-points">
          <li>
            <strong>AI 測膚與個人化推薦：</strong>接入 qwen-vl / deepseek-vl 視覺大模型實現「問卷 + 掃臉」雙通道皮膚分析；自研規則引擎按 8 種膚質畫像打分匹配產品，支援後台視覺化配置（營運零程式碼調整）。
          </li>
          <li>
            <strong>轉化與歸因：</strong>主導模型整合與核心介面開發，多管道電商外鏈歸因，驅動使用者諮詢轉化率提升 30%。
          </li>
          <li>
            <strong>增長與傳播設計：</strong>設計遊客模式（裝置指紋 + 限時檔案）讓使用者免註冊完成測膚，配合分享海報生成與管道裂變歸因支撐社群傳播；輸出去識別化統計資料反哺品牌白皮書與市場洞察，將工具沉澱為品牌資料資產。
          </li>
          <li>
            <strong>AI 成本工程：</strong>為 AI 呼叫設計熔斷器與日/月 Token 預算熔斷、呼叫計費持久化與模型白名單回退，修復 5xx 重試導致的重複扣費風險；使用者報告資料 90 天滾動續期並冷熱分層歸檔（冷層去識別化摘要）。
          </li>
          <li>
            <strong>資料資產閉環：</strong>設計伺服器端間鑑權介面，測膚報告與護膚檔案隨工作階段一鍵透傳至微信 AI 客服（session_id 透傳），將一次性測膚沉澱為可持續營運、可驅動回購的使用者資料資產。
          </li>
        </ul>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name">微信 AI 智慧客服</h3>
          <span class="entry-date">2026.08</span>
        </div>
        <div class="project-meta">
          獨立完成（產品設計 · 全棧開發，基於微信客服原生聊天窗）
        </div>
        <ul class="project-points">
          <li>
            <strong>多入口訊息閘道：</strong>基於 FastAPI + Redis + DeepSeek 大模型構建，統一接入企業微信客服、企業微信應用與公眾號三路訊息入口；支援智慧轉人工（關鍵字辨識 + 服務時間窗 + 接待人黏性繫結）。
          </li>
          <li>
            <strong>陪伴式會話營運：</strong>承接測膚平台透傳的使用者檔案，多輪會話中自動沉澱護膚檔案（階段目標管理與複評提醒），並提供訂單查詢引導，將一次性諮詢轉化為長期陪伴式跟進。
          </li>
          <li>
            <strong>提示詞與知識庫工程：</strong>按客服帳號路由雙套人設（品牌客服 / 護膚顧問）的獨立提示詞與知識庫；44KB 品牌 FAQ 知識庫分段構建、按訊息關鍵字匹配按需注入並支援熱載入；內建 Prompt 注入防護與廣告法禁語輸出過濾雙層合規兜底。
          </li>
          <li>
            <strong>品質保障與可用性：</strong>以 34 條真實大模型黃金迴歸用例鎖定提示詞迭代品質，配套 340+ 自動化測試用例；AI 呼叫指數退避重試與逾時控制，Redis 故障自動降級記憶體模式並定時重連恢復；提供 PII 匯出/刪除介面（個保法合規），Linux + Nginx 自託管部署。
          </li>
        </ul>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name">NIHPLOD 授權驗真平台</h3>
          <span class="entry-date">2026.04 – 2026.05</span>
        </div>
        <div class="project-meta">
          獨立完成（產品設計 · UI/UX · 全棧開發） · 成果展示：<a href="https://ba.nihplod.cn" target="_blank" rel="noopener noreferrer"
            >ba.nihplod.cn</a
          >
        </div>
        <ul class="project-points">
          <li>
            <strong>授權稽核與防偽證書：</strong>基於 Next.js 16 + PostgreSQL 構建經銷商授權管理系統，實現「稽核員提報 → 負責人終審簽發」兩級稽核與證書狀態機（簽發 / 打回 / 到期 / 吊銷）；瀏覽器端 Canvas + jsPDF 即時合成含電子公章與動態 QR Code 的防偽授權證書（支援 PNG / PDF 下載）。
          </li>
          <li>
            <strong>公眾查驗與安全體系：</strong>面向公眾提供「精確 → 前綴 → 模糊」三級回退真偽查驗（pg_trgm GIN 索引加速，支援相機掃碼）與帶完整狀態流轉的打假檢舉工單系統；配套 JWT 黑名單與改密即時失效、資料庫持久化限流，以及覆蓋證書全生命週期與工單處理的操作稽核。
          </li>
        </ul>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name">Myskin.Today（AI 肌膚分析平台官網）</h3>
          <span class="entry-date">2026.01 – 2026.02</span>
        </div>
        <div class="project-meta">
          獨立完成（產品設計 · UI/UX · 全棧開發 · AIGC 視覺素材） · 成果展示：<a
            href="https://myskin.today"
            target="_blank" rel="noopener noreferrer">myskin.today</a
          >
        </div>
        <ul class="project-points">
          <li>
            <strong>官網與商業化落地：</strong>基於 Next.js 16 + Tailwind CSS v4 構建 AI 肌膚分析平台官方網站，覆蓋產品能力展示、API 接入 / 白牌客製 / 策略合作三類 B 端商業模式落地頁與 API 文件站；合作意向表單經 API 路由（IP 限流、輸入消毒、逾時重試）即時推送企業微信機器人。
          </li>
          <li>
            <strong>設計系統與視覺資產：</strong>自建品牌設計系統（色彩 / 字體 / 間距變數、Bento 網格、深淺雙主題），並以 AIGC 產出全站插畫素材與宣傳場景影片；基於 Framer Motion 實現捲動感知導覽與數字捲動等互動動效，全端響應式。
          </li>
          <li>
            <strong>SEO 與工程品質：</strong>全站獨立 metadata / OpenGraph / JSON-LD 結構化資料 / sitemap / PWA 體系；next/image 全站圖片最佳化與域名白名單，配套圖片與影片內容防盜保護。
          </li>
        </ul>
      </div>

      <div class="project-entry">
        <div class="entry-header">
          <h3 class="project-name"
            >上海臨港景鴻安全防範科技發展有限公司網站系統</h3
          >
          <span class="entry-date">2025.07 – 2025.09</span>
        </div>
        <div class="project-meta">
          獨立完成（產品設計 · UI/UX · 全棧開發） · 成果展示：<a
            href="https://www.lingangjh.com"
            target="_blank" rel="noopener noreferrer">www.lingangjh.com</a
          >
        </div>
        <ul class="project-points">
          <li>
            <strong>全棧開發與設計落地：</strong>基於 Next.js 完成企業官網全棧開發與 CMS 內容管理後台，並基於 Figma 完成品牌視覺與互動原型設計；首屏載入時間控制在 1.5s 以內，全端響應式適配。
          </li>
          <li>
            <strong>AI 問答與安全架構：</strong>本地化部署文心 / Qwen 大模型問答助手 Weknora，搭建 RAG 知識檢索管道，回答準確率 > 85%；實現 JWT 使用者認證、RLS 資料隔離與 CSP 安全策略，保障資料安全與存取控制。
          </li>
        </ul>
      </div>

    </section>

    <section>
      <h2>技術棧</h2>
      <div class="skills-row">
        <span class="skills-label">前端開發：</span>
        <span class="skills-content">TypeScript / React / Next.js / Vue 3 / uni-app / Tailwind CSS / 響應式與行動端適配</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">後端 &amp; 資料庫：</span>
        <span class="skills-content">Node.js / Python (FastAPI) / Prisma / PostgreSQL / Redis / RESTful API / JWT · OAuth 2.0 · OIDC</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">AI &amp; 大模型：</span>
        <span class="skills-content">大模型整合 / 視覺模型測膚 / RAG 檢索增強 / AI 成本工程（熔斷與預算控制）/ Claude Code / Codex 驅動開發</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">運維 &amp; 部署：</span>
        <span class="skills-content">Linux / Docker / Nginx / CDN / ICP 備案 / 成本控制與資源最佳化</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">安全 &amp; 合規：</span>
        <span class="skills-content">CSP / RLS / 資訊安全基線 / 隱私政策與資料合規</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">UI/UX 設計：</span>
        <span class="skills-content">Figma / 品牌視覺系統 / 互動原型 / 設計及程式碼實現</span>
      </div>
    </section>

    <section>
