---
import Layout from "../layouts/Layout.astro";
import PrintFooter from "../components/PrintFooter.astro";
import MermaidDiagram from "../components/MermaidDiagram.astro";
import { moidasArchitecture } from "../diagrams/moidas-architecture";
import { CONTENT_LAST_UPDATED } from "../data/site";
import "../styles/global.css";
import "../styles/cv.css";

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://cv.wilboerht.com/CV-tw/#page",
  "url": "https://cv.wilboerht.com/CV-tw/",
  "inLanguage": "zh-TW",
  "name": "王泓坤 - 履歷",
  "description": "王泓坤的個人履歷頁面：常駐上海的數位開發經理、全端工程師。",
  "isPartOf": { "@id": "https://cv.wilboerht.com/#website" },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".tagline", ".entry-summary"]
  },
  "dateModified": CONTENT_LAST_UPDATED,
  "mainEntity": {
    "@type": "Person",
    "@id": "https://wilboerht.com/#person",
    "name": "王泓坤",
    "alternateName": ["Hongkun Wang", "Hank Wong", "wilboerht"],
    "givenName": "泓坤",
    "familyName": "王",
    "description": "數位開發經理、全棧工程師（TypeScript / React / Next.js / AI / RAG），常駐上海。作為 Moidas（NIHPLOD）大中華區首位工程師，從 0 到 1 打造品牌官網、會員與積分體系、統一認證（SSO）、AI 顧問、智慧客服與雙小程式等數位系統。",
    "email": "me@wilboerht.cn",
    "url": "https://wilboerht.com",
    "image": "https://cv.wilboerht.com/og-image.png",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "上海",
      "addressCountry": "CN"
    },
    "sameAs": [
      "https://github.com/wilboerht",
      "https://x.com/wilboerht",
      "https://www.linkedin.com/in/wilboerht/"
    ],
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "上海科學技術職業學院"
      }
    ],
    "knowsAbout": [
      "TypeScript",
      "React",
      "Next.js",
      "Vue 3",
      "Node.js",
      "FastAPI",
      "Prisma",
      "PostgreSQL",
      "Redis",
      "Large Language Models",
      "RAG",
      "Docker",
      "Linux"
    ],
    "jobTitle": "數位開發經理",
    "worksFor": {
      "@type": "Organization",
      "@id": "https://nihplod.cn/#organization",
      "name": "穆埃達思 Moidas",
      "url": "https://nihplod.cn"
    },
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": "上海市“星光計畫”職業院校技能競賽“網站技術”三等獎（上海市第 16 名）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "人社部“職業技能等級證書”電腦程式設計員 三級（高級）（競賽）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "國家資訊安全水平考試二級（NISP）",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "天翼雲高級開發工程師認證（SCCP）",
        "dateCreated": "2024-11"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "阿里雲 ACA 雲安全助理工程師認證",
        "dateCreated": "2024-10"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "天翼雲高級運維工程師認證",
        "dateCreated": "2024-05"
      }
    ],
    "award": "上海市“星光計畫”職業院校技能競賽“網站技術”三等獎"
  }
};
---

<Layout title="王泓坤 - 履歷" lang="zh-TW">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld, null, 2)} />
  </Fragment>
  <div class="container">
    <header>
      <h1>王泓坤</h1>
      <p class="tagline">數位開發經理 · 全棧工程師 · 上海</p>
      <div class="contact-info">
        <span class="contact-item"><a href="mailto:me@wilboerht.cn">me@wilboerht.cn</a></span>
        <span class="contact-item"><a href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer">GitHub</a></span>
        <span class="contact-item"><a href="https://wilboerht.com" target="_blank" rel="noopener noreferrer">wilboerht.com</a></span>
      </div>
    </header>

    <section>
      <h2>工作經歷</h2>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">穆埃達思 Moidas · 旎柏（大中華區）事業部</h3>
          <div class="entry-meta">
            <span class="entry-role">數位開發經理</span>
            <span class="entry-date">2025.10 – 至今</span>
          </div>
        </div>
        <p class="entry-summary">
          2025.10 以實習生身分加入，2026.07 轉正並直接彙報品牌負責人；作為事業部首位技術人員，以產品思維與 AI 輔助研發獨立完成從需求、設計到開發、上線的全端交付，12 個月內從 0 到 1 交付 7 個核心系統及 2100+ 自動化測試用例，並以統一帳號與檔案資料打通「測膚 → 個人化方案 → AI 顧問跟進 → 回購」業務閉環。
        </p>
        <ul class="project-points">
          <li>負責品牌大中華區數位化產品矩陣的規劃、技術選型與全端交付，統籌 7 個核心系統從需求、設計、開發到上線維運的完整生命週期。</li>
          <li>參與品牌大中華區會員體系制定，聯合品牌與營運團隊設計四檔會員等級、權益、積分與兌禮規則，並落地官網 / 小程式會員中心，支撐會員留存與回購。</li>
          <li>建立 AI 輔助研發工作流與設計規範，將平均交付週期壓縮 50% 以上，保障多專案並行交付。</li>
          <li>作為技術側負責人承接產品、行銷團隊需求並拆解排期，主導需求評審與迭代節奏，支撐品牌線上零售管道（中國官網）從 0 上線。</li>
          <li>主導 ICP 備案、隱私政策及使用者協議制定，完成資料合規審查，保障多系統合規上線；依據流量動態調整伺服器資源配置，實現成本最佳化。</li>
        </ul>
        <MermaidDiagram
          code={moidasArchitecture.tw}
          alt="穆埃達思 Moidas 大中華區數位化系統架構圖：統一認證（SSO）連接官網、AI 測膚、AI 客服與授權驗真等核心系統"
          zoomLabel="查看大圖"
          closeLabel="關閉"
        />
      </div>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">上海臨港景鴻安全防範科技發展有限公司</h3>
          <div class="entry-meta">
            <span class="entry-role">技術研發實習生</span>
            <span class="entry-date">2025.07 – 2025.09</span>
          </div>
        </div>
        <ul class="project-points">
          <li>獨立承擔企業官網全鏈路交付，覆蓋從架構設計、UI/UX 設計到生產部署全過程。</li>
          <li>基於宇樹機器狗 SDK 二次開發，完成園區巡邏管理控制平台內部初版並驗證產品可行性。</li>
          <li>推動 AI 問答助手在企業內部首次落地，參與企業與百度官方企業問答團隊對接業務工作。</li>
        </ul>
      </div>
    </section>

    <section>
      <div class="project-section-head">
        <h2>項目經歷</h2>
        <a class="project-github-link" href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer" aria-label="去 GitHub 查看更多">
          <svg class="project-github-link__icon" aria-hidden="true"><use href="#icon-github"></use></svg>
          去 GitHub 查看更多
        </a>
      </div>

      <div class="project-entry" data-project-logo="/images/NIHPLOD-logo.svg" id="project-website">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-website" aria-haspopup="dialog">NIHPLOD 中國官網</button></h3>
          <span class="entry-date">2025.11 – 至今</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">獨立負責</span>：<span class="project-meta-role"><span class="project-meta-tag">產品</span> <span class="project-meta-tag">UI/UX</span> <span class="project-meta-tag">全棧</span> <a href="https://nihplod.cn" target="_blank" rel="noopener noreferrer" class="project-meta-link"><span>nihplod.cn</span><svg class="project-meta-link__icon" aria-hidden="true"><use href="#icon-external"></use></svg></a></span>
        </div>
        <p class="project-summary">品牌在中國市場的官網與會員中台：整合產品展示、電商導購、會員積分與測膚檔案，統一微信 / 抖音 / 手機號多端帳號；從 0 到 1 支撐品牌線上零售與回購，205 API / 51 模型 / 2100+ 測試。</p>
        <button type="button" class="project-more" data-project-dialog="project-website" aria-haspopup="dialog" aria-label="查看詳情：NIHPLOD 中國官網"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>查看詳情</button>
        <dialog class="project-dialog" id="dialog-project-website">
          <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="關閉">&times;</button>
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
            </div>
            <div class="project-dialog__content">
            <ul class="project-points">
              <li>
                <strong>品牌官網與會員中台：</strong>基於 Next.js 16 + Prisma + PostgreSQL 建構品牌官網與會員中台 — 產品陳列、第三方電商導購（天貓 / 抖音 / 小紅書 / 微信小店外鏈 + GA 事件追蹤）、會員等級、積分帳本、積分兌禮（順豐物流軌跡）、消費補錄、測膚檔案與安全中心；聚合微信、抖音、手機號驗證碼多端身分至統一帳號體系；全站 205 個 API 路由、51 個資料模型、2100+ 個自動化測試用例。
              </li>
              <li>
                <strong>產品與互動設計：</strong>從資訊架構、Figma 互動原型到視覺樣式全程獨立設計；基於 Framer Motion + View Transitions 實現多步驟護膚儀式指南與沉浸式品牌敘事，整合產品抽屜與詳情頁連動，全端響應式適配。
              </li>
              <li>
                <strong>營運後台與安全治理：</strong>搭建覆蓋產品 / 分類 / 會員 / 積分兌禮 / 消費補錄 / 職位 / 訊息 / OAuth 客戶端的營運後台（Tiptap 富文字），配套 TOTP 二因素與敏感操作 Step-up 驗證、操作稽核與每日完整性錨點、定時任務、資料庫持久化限流及 Webhook 失敗重投；完成 SEO / GEO（sitemap / JSON-LD / llms.txt / 百度推送）。
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

      <div class="project-entry" data-project-logo="/images/NIHPLOD-logo.svg" id="project-sso">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-sso" aria-haspopup="dialog">NIHPLOD 統一認證平台（SSO / OIDC）</button></h3>
          <span class="entry-date">2026.07 – 至今</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">獨立負責</span>：<span class="project-meta-role"><span class="project-meta-tag">產品</span> <span class="project-meta-tag">全棧</span></span>
        </div>
        <p class="project-summary">品牌大中華區的統一身份底座：自建 OAuth 2.0 / OIDC 單一簽入，打通官網、測膚站、雙小程式與管理端的帳號與登入狀態；支撐 5 個系統跨域免登、全域登出；管理後台啟用 TOTP 二因素驗證，並沉澱為可複用 npm SDK。</p>
        <button type="button" class="project-more" data-project-dialog="project-sso" aria-haspopup="dialog" aria-label="查看詳情：NIHPLOD 統一認證平台（SSO / OIDC）"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>查看詳情</button>
        <dialog class="project-dialog" id="dialog-project-sso">
          <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="關閉">&times;</button>
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
            </div>
            <div class="project-dialog__content">
            <ul class="project-points">
              <li>
                <strong>協定實現：</strong>自建 OAuth 2.0 / OIDC 單一登入，與官網主站同構部署，主站作為 Authorization Server 簽發 JWT（RS256），完整實現 authorize / token / userinfo / introspect / revoke / end-session 協定端點，支援 PKCE、DPoP；管理後台啟用 TOTP 二因素驗證。
              </li>
              <li>
                <strong>SDK 與接入：</strong>封裝並發布 npm SDK（@nihplod/sso-sdk / @nihplod/sso-verify）供子專案分鐘級接入，透過 Token Introspection + Backchannel Logout 實現跨域免登與全域登出，支撐官網、測膚站、微信雙小程式及管理端統一登入。
              </li>
              <li>
                <strong>安全加固：</strong>支援金鑰輪換、Token 撤銷（RFC 7009）與多實例黑名單共用，保障認證體系可運維、可稽核。
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

      <div class="project-entry" data-project-logo="/images/NIHPLOD-logo.svg" id="project-ai-advisor">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-ai-advisor" aria-haspopup="dialog">AI 護膚顧問系統</button></h3>
          <span class="entry-date">2026.01 – 至今</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">獨立負責</span>：<span class="project-meta-role"><span class="project-meta-tag">產品</span> <span class="project-meta-tag">UX</span> <span class="project-meta-tag">全棧</span> <span class="project-meta-note">UI 視覺協作</span> <a href="https://smart.nihplod.cn" target="_blank" rel="noopener noreferrer" class="project-meta-link"><span>smart.nihplod.cn</span><svg class="project-meta-link__icon" aria-hidden="true"><use href="#icon-external"></use></svg></a></span>
        </div>
        <p class="project-summary">面向消費者的 AI 護膚顧問：以「問卷 + 掃臉」雙通道完成肌膚分析，結合膚質 / 季節 / 地域規則生成個人化產品方案，並將報告與檔案透傳至企微顧問，形成「測膚 → 方案 → 跟進 → 回購」閉環；93 API / 531 測試。</p>
        <button type="button" class="project-more" data-project-dialog="project-ai-advisor" aria-haspopup="dialog" aria-label="查看詳情：AI 護膚顧問系統"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>查看詳情</button>
        <dialog class="project-dialog" id="dialog-project-ai-advisor">
          <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="關閉">&times;</button>
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
            </div>
            <div class="project-dialog__content">
            <ul class="project-points">
              <li>
                <strong>AI 測膚與個人化推薦：</strong>接入通義千問 VL / DeepSeek 大模型實現「問卷 + 掃臉」雙通道皮膚分析；自研規則引擎按 8 種膚質畫像與季節 / 地域環境因子打分匹配產品，支援後台視覺化配置（營運零程式碼調整）。
              </li>
              <li>
                <strong>轉化與歸因：</strong>主導模型整合與核心介面開發；電商外鏈（天貓 / 抖音 / 小紅書 / 微信小店）支援 UTM / pid 追蹤與點擊事件埋點，結合企微顧問短鏈形成可歸因的諮詢轉化鏈路。
              </li>
              <li>
                <strong>增長與會員營運：</strong>打通四檔會員測膚配額（一般會員終身 10 次；銀卡 10 + 每消費滿 ¥1,000 加贈 20 次、每日最多 10 次；金卡 / 鑽石總量不限、每日最多 10 次），以登入帳號承接報告與檔案；設計分享海報、渠道 ref 歸因與註冊轉化彈窗，並輸出去識別化群體統計 CSV 反哺品牌白皮書與市場洞察。
              </li>
              <li>
                <strong>AI 成本與穩定性工程：</strong>設計 AI 請求佇列與併發控制、熔斷器、日/月 Token 與費用預算熔斷、呼叫計費持久化、模型白名單與 Provider 回退；以失敗重試冪等與額度預佔 / 釋放規避重複扣費；當前肌膚檔案採用 90 天滾動有效期（用於複測提示），完整報告保留 365 天，並按冷熱分層歸檔（熱層保留最近 10 條完整報告，冷層去識別化摘要最長保留 3 年）。
              </li>
              <li>
                <strong>資料資產閉環：</strong>設計 HMAC 簽名 + IP 限流的伺服器間介面，測膚報告與護膚檔案隨 session_id 一鍵透傳至企微 AI 客服，將一次性測膚沉澱為可持續營運、可驅動回購的使用者資料資產。
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

    </section>

    <section>
      <h2>技術棧</h2>
      <div class="skills-row">
        <span class="skills-label">前端 &amp; 小程式：</span>
        <span class="skills-content">TypeScript · React · Next.js · Vue 3 · uni-app · 微信小程式 · Tailwind CSS · Canvas 2D</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">後端 &amp; 資料：</span>
        <span class="skills-content">Node.js · Python (FastAPI) · Prisma · PostgreSQL · Redis · RESTful API</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">AI 工程：</span>
        <span class="skills-content">大模型整合 · 視覺測膚 · RAG · Prompt / 知識庫 · AI 成本工程（熔斷 / 預算） · 評估與回歸 · AI 輔助研發（Claude Code / Codex）</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">工程化 &amp; 平台：</span>
        <span class="skills-content">Linux · Docker · Nginx · CDN · 自動化測試（單元 / 整合 / 回歸）</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">安全 &amp; 合規：</span>
        <span class="skills-content">OAuth 2.0 · OIDC · SSO · JWT · TOTP · CSP · RLS · ICP 備案 · 隱私與資料合規</span>
      </div>
