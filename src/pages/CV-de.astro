---
import Layout from "../layouts/Layout.astro";
import PrintFooter from "../components/PrintFooter.astro";
import MermaidDiagram from "../components/MermaidDiagram.astro";
import { moidasArchitecture } from "../diagrams/moidas-architecture";
import { CONTENT_LAST_UPDATED } from "../data/site";
import "../styles/global.css";
import "../styles/cv.css";

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://cv.wilboerht.com/CV-de/#page",
  "url": "https://cv.wilboerht.com/CV-de/",
  "inLanguage": "de",
  "name": "Hongkun Wang - Lebenslauf",
  "description": "Profilseite von Hongkun Wang, Digital Development Manager und Full-Stack-Entwickler in Shanghai.",
  "isPartOf": { "@id": "https://cv.wilboerht.com/#website" },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".tagline", ".entry-summary"]
  },
  "dateModified": CONTENT_LAST_UPDATED,
  "mainEntity": {
    "@type": "Person",
    "@id": "https://wilboerht.com/#person",
    "name": "Hongkun Wang",
    "alternateName": ["王泓坤", "Hank Wong", "wilboerht", "왕홍곤"],
    "givenName": "Hongkun",
    "familyName": "Wang",
    "description": "Digital Development Manager und Full-Stack-Entwickler (TypeScript / React / Next.js / AI / RAG) mit Sitz in Shanghai. Erster Ingenieur der Greater-China-Sparte von Moidas (NIHPLOD) — Aufbau der Markenwebsite, des Mitglieder- und Punktesystems, der einheitlichen Authentifizierung, des KI-Hautpflegeberaters, des WeCom-KI-Kundenservice, der Autorisierungsprüfung und zweier Mini-Programme von Grund auf.",
    "email": "me@wilboerht.cn",
    "url": "https://wilboerht.com",
    "image": {
      "@type": "ImageObject",
      "url": "https://wilboerht.com/opengraph-image",
      "width": 1200,
      "height": 630,
      "caption": "Hongkun Wang · CV"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Shanghai",
      "addressCountry": "CN"
    },
    "sameAs": [
      "https://github.com/wilboerht",
      "https://x.com/wilboerht",
      "https://www.linkedin.com/in/wilboerht/"
    ],
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "Shanghai Scientific and Technical Vocational College"
      }
    ],
    "knowsAbout": [
      "TypeScript",
      "React",
      "Next.js",
      "Vue 3",
      "Node.js",
      "FastAPI",
      "Prisma",
      "PostgreSQL",
      "Redis",
      "Large Language Models",
      "RAG",
      "Docker",
      "Linux"
    ],
    "jobTitle": "Digital Development Manager",
    "worksFor": {
      "@type": "Organization",
      "@id": "https://nihplod.cn/#organization",
      "name": "Moidas",
      "url": "https://nihplod.cn"
    },
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": '3. Preis in „Webtechnologie“ beim Berufswettbewerb „Starlight Plan“ in Shanghai (Platz 16 in Shanghai)',
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "MOHRSS-Zertifikat für berufliche Qualifikationsstufen: Computerprogrammierer Stufe III (Fortgeschritten) (Wettbewerb)",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "National Information Security Test Program Stufe II (NISP)",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "CTyun Advanced-Developer-Zertifizierung (SCCP)",
        "dateCreated": "2024-11"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "Alibaba Cloud ACA Cloud Security Associate-Zertifizierung",
        "dateCreated": "2024-10"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "CTyun Advanced-O&M-Engineer-Zertifizierung",
        "dateCreated": "2024-05"
      }
    ],
    "award": "3. Preis in „Webtechnologie“ beim Berufswettbewerb „Starlight Plan“ in Shanghai"
  }
};
---

<Layout
  title="Hongkun Wang - Lebenslauf"
  lang="de"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld, null, 2)} />
  </Fragment>
  <div class="container">
    <header>
      <h1>Hongkun Wang</h1>
      <p class="tagline">Digital Development Manager · Full-Stack-Entwickler · Shanghai</p>
      <div class="contact-info">
        <span class="contact-item"><a href="mailto:me@wilboerht.cn">me@wilboerht.cn</a></span>
        <span class="contact-item"><a href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer">GitHub</a></span>
        <span class="contact-item"><a href="https://www.linkedin.com/in/wilboerht/" target="_blank" rel="noopener noreferrer">LinkedIn</a></span>
        <span class="contact-item"><a href="https://wilboerht.com" target="_blank" rel="noopener noreferrer">wilboerht.com</a></span>
      </div>
    </header>

    <section>
      <h2>Profil</h2>
      <p class="entry-desc">
        Digital Development Manager und Full-Stack-Entwickler mit Sitz in
        Shanghai, spezialisiert auf TypeScript / React / Next.js sowie KI- und
        RAG-Engineering. Als erster Ingenieur der Greater-China-Sparte von
        Moidas (NIHPLOD) 7 Kernsysteme von Grund auf aufgebaut — Markenwebsite
        &amp; Mitgliederplattform, einheitliches SSO, KI-Hautpflegeberater,
        WeCom-KI-Kundenservice, Autorisierungsprüfung,
        KI-Hautanalyse-Mini-Programm und Mitgliedercenter-Mini-Programm —
        abgesichert durch 2.900+ automatisierte Testfälle. Stärke in der
        eigenverantwortlichen End-to-End-Umsetzung von der Anforderung über das
        Design bis zu Launch und Betrieb mit Produktdenken.
      </p>
    </section>

    <section>
      <h2>Berufserfahrung</h2>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">Moidas · NIHPLOD Greater China Division</h3>
          <div class="entry-meta">
            <span class="entry-role">Digital Development Manager</span>
            <span class="entry-date">Okt. 2025 – heute (Festanstellung seit Juli 2026)</span>
          </div>
        </div>
        <p class="entry-summary">
          Im Oktober 2025 als Vollzeitpraktikant während des Studiums eingestiegen, im Juli 2026 in eine Festanstellung übernommen, mit direkter Berichtslinie an die Markenleitung. Als erster Ingenieur der Sparte die Full-Stack-Umsetzung von der Anforderung über das Design bis zur Entwicklung und zum Launch mit Produktdenken und KI-gestützter Entwicklung eigenständig verantwortet; in den ersten 12 Monaten 7 Kernsysteme von Grund auf aufgebaut und gestartet (2 Mini-Programme werden weiterentwickelt), abgesichert durch 2.900+ automatisierte Testfälle, und über einheitliche Konten und Profildaten den Kreislauf „Hautanalyse → personalisierte Pflegeroutine → 7×24-KI-Beratung → Wiederkauf“ geschlossen.
        </p>
        <ul class="project-points">
          <li>Planung, Technologieauswahl und Full-Stack-Lieferung des digitalen Produktportfolios der Marke für Greater China verantwortet; den vollständigen Lebenszyklus von 7 Kernsystemen von Anforderungen und Design über Entwicklung und Launch bis zum Betrieb gesteuert.</li>
          <li>Das Mitgliedersystem für Greater China gemeinsam mit Marken- und Operationsteams mitgestaltet — vier Mitgliedsstufen, Vorteile, Punkte- und Einlöseregeln — und auf der offiziellen Website sowie im Mitgliedercenter-Mini-Programm umgesetzt, um Bindung und Wiederkauf zu fördern.</li>
          <li>KI-gestützte Entwicklungsworkflows und Designstandards etabliert und die durchschnittlichen Entwicklungszyklen um rund 50 % verkürzt — bei paralleler Umsetzung mehrerer Projekte.</li>
          <li>Als technischer Lead Anforderungen von Produkt- und Marketingteams aufgenommen und in Lieferpläne übersetzt, Anforderungs-Reviews und Iterationsrhythmus verantwortet sowie den Online-Handelskanal der Marke (offizielle China-Website) von der Konzeption bis zum Launch begleitet.</li>
          <li>ICP-Anmeldung, Datenschutzrichtlinie und Nutzungsvereinbarung verantwortet sowie Datenschutz-Compliance-Reviews durchgeführt, um Compliance-konforme Launches über alle Systeme sicherzustellen.</li>
          <li>Serverressourcen dynamisch an das Zugriffsvolumen angepasst, um die Infrastrukturkosten zu optimieren.</li>
        </ul>
        <MermaidDiagram
          code={moidasArchitecture.de}
          alt="Architekturübersicht der digitalen Systeme von Moidas Greater China: einheitliches SSO verbindet offizielle Website, KI-Hautanalyse, KI-Kundenservice und Autorisierungsverifizierung"
          zoomLabel="Vergrößern"
          closeLabel="Schließen"
        />
      </div>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">Shanghai Lingang Jinghong Security Technology Development Co., Ltd.</h3>
          <div class="entry-meta">
            <span class="entry-role">F&amp;E-Praktikant</span>
            <span class="entry-date">Jul. 2025 – Sep. 2025</span>
          </div>
        </div>
        <ul class="project-points">
          <li>Eigenverantwortliche End-to-End-Umsetzung der Unternehmenswebsite — von Architektur und UI/UX-Design bis zum Produktions-Deployment.</li>
          <li>Auf Basis des Unitree-Roboterhund-SDKs ein internes MVP für eine Campus-Patrouillen-Verwaltungsplattform entwickelt und die Produktmachbarkeit validiert.</li>
          <li>Die erste interne Einführung von KI-Frage-Antwort-Tools im Unternehmen vorangetrieben und die geschäftliche Abstimmung des Unternehmens mit Baidus offiziellem Enterprise-QA-Team mitgestaltet.</li>
        </ul>
      </div>
    </section>

    <section>
      <div class="project-section-head">
        <h2>Projekte</h2>
        <a class="project-github-link" href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer" aria-label="Mehr auf GitHub ansehen">
          <svg class="project-github-link__icon" aria-hidden="true"><use href="#icon-github"></use></svg>
          Mehr auf GitHub ansehen
        </a>
      </div>

      <div class="project-entry" data-project-logo="/images/NIHPLOD-logo.svg" id="project-website">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-website" aria-haspopup="dialog">NIHPLOD Offizielle China-Website</button></h3>
          <span class="entry-date">Nov. 2025 – heute</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">Produkt, Design und Full-Stack-Entwicklung eigenverantwortlich geleitet</span> <a href="https://nihplod.cn" target="_blank" rel="noopener noreferrer" class="project-meta-link"><span>nihplod.cn</span><svg class="project-meta-link__icon" aria-hidden="true"><use href="#icon-external"></use></svg></a>
        </div>
        <p class="project-summary">Markenwebsite und Mitgliederplattform für den China-Markt: verbindet Produktpräsentation, E-Commerce-Verlinkung, Mitgliederpunkte und Hautprofile in einem integrierten Erlebnis, vereinheitlicht WeChat-, Douyin- und Telefonnummern-Identitäten und unterstützt den Online-Handel von Grund auf sowie Wiederkäufe; 205 API-Routen / 51 Modelle / 2.100+ Tests (dieses System allein).</p>
        <button type="button" class="project-more" data-project-dialog="project-website" aria-haspopup="dialog" aria-label="Details ansehen: NIHPLOD Offizielle China-Website"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>Details ansehen</button>
        <dialog class="project-dialog" id="dialog-project-website">
          <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="Schließen">&times;</button>
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
            </div>
            <div class="project-dialog__content">
            <ul class="project-points">
              <li>
                <strong>Markenwebsite &amp; Mitgliederplattform:</strong> Die offizielle Markenwebsite und Mitgliederplattform mit Next.js 16 + Prisma + PostgreSQL aufgebaut — Produktpräsentation, Drittanbieter-E-Commerce-Verlinkung (Tmall / Douyin / Xiaohongshu / WeChat Shop + GA-Event-Tracking), Mitgliedsstufen, Punktejournal, Punkte-Einlösung (SF-Express-Tracking), manuelle Erfassung von Offline-Käufen, Hautprofile und ein Kontosicherheitszentrum; WeChat-, Douyin- und Telefon-OTP-Identitäten in einem einheitlichen Kontosystem zusammengeführt — 205 API-Routen, 51 Datenmodelle und 2.100+ automatisierte Testfälle (dieses System allein).
              </li>
              <li>
                <strong>Produkt- &amp; Interaktionsdesign:</strong> Informationsarchitektur, interaktive Figma-Prototypen und visuelles Styling eigenständig gestaltet; mehrstufige Hautpflegeritual-Guides und immersives Brand-Storytelling mit Framer Motion + View Transitions umgesetzt, den Produkt-Drawer mit den Detailseiten verknüpft und vollständig responsive Layouts geliefert.
              </li>
              <li>
                <strong>Admin-Konsole &amp; Sicherheits-Governance:</strong> Eine Admin-Konsole für Produkte / Kategorien / Mitglieder / Punkte-Einlösung / manuelle Erfassung von Offline-Käufen / Stellenanzeigen / Nachrichten / OAuth-Clients (Tiptap Rich Text) aufgebaut, mit TOTP-Zwei-Faktor-Authentifizierung und Step-up-Verifizierung für sensible Aktionen, Audit-Logs und täglichen Integritätsprüfungen, geplanten Jobs, datenbankgestütztem Rate-Limiting und Wiederholungsversuchen bei fehlgeschlagenen Webhooks; SEO / GEO (generative Engine-Optimierung; sitemap / JSON-LD / llms.txt / Baidu-Push) umgesetzt.
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

      <div class="project-entry" data-project-logo="/images/NIHPLOD-logo.svg" id="project-sso">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-sso" aria-haspopup="dialog">NIHPLOD Plattform für einheitliche Authentifizierung (SSO / OIDC)</button></h3>
          <span class="entry-date">Juli 2026 – heute</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">Produkt und Full-Stack-Entwicklung eigenverantwortlich geleitet</span>
        </div>
        <p class="project-summary">Die einheitliche Identitätsbasis für Greater China: ein selbst entwickeltes OAuth 2.0 / OIDC Single Sign-on, das Website, Hautanalyse-Seite, zwei WeChat-Mini-Programme und Admin-Konsole verbindet und systemübergreifendes Login sowie globales Logout für 5 Systeme ermöglicht; die Admin-Konsole ist durch TOTP-2FA geschützt – verpackt als wiederverwendbares npm-SDK.</p>
        <button type="button" class="project-more" data-project-dialog="project-sso" aria-haspopup="dialog" aria-label="Details ansehen: NIHPLOD Plattform für einheitliche Authentifizierung (SSO / OIDC)"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>Details ansehen</button>
        <dialog class="project-dialog" id="dialog-project-sso">
          <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="Schließen">&times;</button>
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
            </div>
            <div class="project-dialog__content">
            <ul class="project-points">
              <li>
                <strong>Protokoll-Implementierung:</strong> Self-hosted OAuth 2.0 / OIDC-SSO aufgebaut, auf derselben Domain wie die offizielle Hauptseite betrieben — die Hauptseite fungiert als Authorization Server und stellt RS256-JWTs aus; die Endpunkte authorize / token / userinfo / introspect / revoke / end-session vollständig implementiert, inkl. PKCE und DPoP; die Admin-Konsole ist durch TOTP-Zwei-Faktor-Authentifizierung geschützt.
              </li>
              <li>
                <strong>SDK &amp; Integration:</strong> npm-SDKs (@nihplod/sso-sdk / @nihplod/sso-verify) verpackt und veröffentlicht, sodass Teilprojekte innerhalb von Minuten integriert werden können; mit Token Introspection + Backchannel Logout für systemübergreifendes SSO und globales Logout — einheitlicher Login für die offizielle Website, die Hautanalyse-Website, beide WeChat-Mini-Programme und die Admin-Konsole.
              </li>
              <li>
                <strong>Sicherheits-Härtung:</strong> Unterstützt Secret-Rotation, Token-Widerruf (RFC 7009) und Multi-Instanz-Blacklist-Sharing für ein wartbares und auditierbares Authentifizierungssystem.
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

      <div class="project-entry" data-project-logo="/images/NIHPLOD-logo.svg" id="project-ai-advisor">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-ai-advisor" aria-haspopup="dialog">KI-Hautpflegeberater</button></h3>
          <span class="entry-date">Jan. 2026 – heute</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">Produkt, Interaktion und Full-Stack-Entwicklung eigenverantwortlich geleitet</span> <span class="project-meta-note">Visuelles Design in Zusammenarbeit</span> <a href="https://smart.nihplod.cn" target="_blank" rel="noopener noreferrer" class="project-meta-link"><span>smart.nihplod.cn</span><svg class="project-meta-link__icon" aria-hidden="true"><use href="#icon-external"></use></svg></a>
        </div>
        <p class="project-summary">Ein KI-Hautpflegeberater für Verbraucher: zweikanalige Hautanalyse per Fragebogen + Gesichtsscan, personalisierte Produktempfehlungen nach Hauttyp, Jahreszeit und Region sowie Übergabe von Berichten und Profilen an WeCom-Berater – geschlossener Kreislauf von Analyse über Pflegeplan und Follow-up bis zum Wiederkauf; 93 API-Routen / 531 Tests.</p>
        <button type="button" class="project-more" data-project-dialog="project-ai-advisor" aria-haspopup="dialog" aria-label="Details ansehen: KI-Hautpflegeberater"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>Details ansehen</button>
        <dialog class="project-dialog" id="dialog-project-ai-advisor">
          <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="Schließen">&times;</button>
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
            </div>
            <div class="project-dialog__content">
            <ul class="project-points">
              <li>
                <strong>KI-Hautanalyse &amp; personalisierte Empfehlungen:</strong> Tongyi Qianwen VL / DeepSeek-LLMs für die zweikanalige Hautanalyse (Fragebogen + Gesichtsscan) integriert; eine eigene Regel-Engine bewertet Produkte anhand von 8 Hauttypen sowie saisonalen / regionalen Umweltfaktoren — über eine visuelle Admin-Konsole konfigurierbar, sodass das Betriebsteam ohne Programmieraufwand anpassen kann.
              </li>
              <li>
                <strong>Conversion &amp; Attribution:</strong> Modellintegration und Entwicklung der Kern-APIs geleitet; E-Commerce-Ausgangslinks (Tmall / Douyin / Xiaohongshu / WeChat Shop) unterstützen UTM-/pid-Tracking und Click-Event-Instrumentierung und bilden zusammen mit WeCom-Berater-Kurzlinks einen attribuierbaren Beratungs-Conversion-Pfad.
              </li>
              <li>
                <strong>Wachstum &amp; Mitgliederbetrieb:</strong> Vierstufige Hautanalyse-Kontingente für Mitglieder integriert (Standard: 10 lebenslange Sitzungen; Silber: Basis 10 + 20 pro ¥1.000 Umsatz; Gold / Diamant: unbegrenzt insgesamt; alle bezahlten Stufen: max. 10/Tag), Berichte und Profile an das angemeldete Konto gebunden; Teilen-Poster, Kanal-ref-Attribution und Registrierungs-Conversion-Popups gestaltet sowie anonymisierte aggregierte CSV-Statistiken für Marken-Whitepaper und Markt-Insights exportiert.
              </li>
              <li>
                <strong>KI-Kosten- &amp; Zuverlässigkeits-Engineering:</strong> KI-Anfragewarteschlange mit Nebenläufigkeitskontrolle, Circuit Breaker, Tages-/Monatslimits für Tokens und Kosten, persistenter Abrechnung pro Aufruf sowie Modell-Whitelist mit Anbieter-Fallback entworfen; idempotente Wiederholungsversuche und Kontingent-Reservierung / -Freigabe verhindern Doppelbelastungen; Hautprofile haben eine rollierende 90-Tage-Gültigkeit mit Retest-Hinweisen, vollständige Berichte werden 365 Tage aufbewahrt, und die zweistufige Archivierung (heiß/kalt) behält die letzten 10 vollständigen Berichte sowie anonymisierte Cold-Tier-Zusammenfassungen für bis zu 3 Jahre.
              </li>
              <li>
                <strong>Datenasset-Kreislauf:</strong> Eine Server-zu-Server-API mit HMAC-Signaturen + IP-Rate-Limiting entworfen; Hautanalyse-Berichte und Hautpflegeprofile werden per session_id an den WeCom-KI-Kundenservice übergeben — einmalige Hauttests werden so zu dauerhaft nutzbaren Datenassets, die Wiederholungskäufe fördern.
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

      <div class="project-toggle-wrap">
        <button type="button" class="project-toggle" data-project-toggle aria-expanded="false" aria-controls="project-extra">
          <span class="project-toggle__more">Weitere Projekte anzeigen</span>
          <span class="project-toggle__less">Weniger anzeigen</span>
        </button>
      </div>

      <div class="project-extra" id="project-extra" hidden>
      <div class="project-entry project-entry--static" id="project-wecom-ai">
        <div class="entry-header">
          <h3 class="project-name">WeCom-KI-Kundenservice</h3>
          <span class="entry-date">Aug. 2026</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">Produkt, Design und Full-Stack-Entwicklung eigenverantwortlich geleitet</span>
          <a href="https://kf.nihplod.cn" target="_blank" rel="noopener noreferrer" class="project-meta-link"><span>kf.nihplod.cn</span><svg class="project-meta-link__icon" aria-hidden="true"><use href="#icon-external"></use></svg></a>
        </div>
        <p class="project-summary">WeCom-KI-Kundenservice mit FastAPI + Redis + DeepSeek: vereint drei Nachrichteneingänge (WeCom-Kundenservice, WeCom-App und WeChat Official Account), unterstützt intelligente Übergabe an Menschen, übernimmt Hautpflegeprofile und bietet 7×24-Begleitung; 44KB Marken-FAQ-Wissensbasis, 34 Golden-Regressionfälle, 340+ automatisierte Tests und PIPL-konforme Export-/Löschfunktionen für personenbezogene Daten.</p>
      </div>

      <div class="project-entry project-entry--static" id="project-authorization">
        <div class="entry-header">
          <h3 class="project-name">NIHPLOD Autorisierungs- und Verifizierungsplattform</h3>
          <span class="entry-date">Apr. 2026 – Mai 2026</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">Produkt, Design und Full-Stack-Entwicklung eigenverantwortlich geleitet</span>
          <a href="https://ba.nihplod.cn" target="_blank" rel="noopener noreferrer" class="project-meta-link"><span>ba.nihplod.cn</span><svg class="project-meta-link__icon" aria-hidden="true"><use href="#icon-external"></use></svg></a>
        </div>
