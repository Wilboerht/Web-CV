    <section>
      <h2>Others</h2>
      <div class="award-row">
        <span class="award-name">Google Developer Group Community Member</span>
      </div>
      <div class="award-row">
        <span class="award-name">Chinese Institute of Electronics Youth Level Examination Assessor (Python)</span>
