    <section>
      <h2>Education</h2>
      <div class="entry">
        <div class="entry-header">
          <div class="entry-title-group">
            <h3 class="entry-org"
              >Shanghai Scientific and Technical Vocational College</h3>
          </div>
          <span class="entry-date">Oct 2023 – Jun 2026</span>
        </div>
        <div class="entry-major">
          School of Communication &amp; Electronic Engineering, Information Security
          Technology Application, Associate Degree
        </div>
        <p class="entry-desc">
