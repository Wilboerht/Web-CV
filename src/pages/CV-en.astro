---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="Hongkun Wang - CV" lang="en">
  <style>
    body {
      font-family: "Times New Roman", "Inter", serif;
      background: var(--background);
      color: var(--text-color);
      line-height: 1.5;
    }
    .container {
      max-width: 800px;
      margin: 40px auto;
      padding: 0 40px;
    }
    header {
      text-align: center;
      margin-bottom: 25px;
      padding-bottom: 20px;
      border-bottom: 1px solid transparent;
      background-image:
        linear-gradient(var(--background), var(--background)),
        linear-gradient(
          90deg,
          transparent,
          var(--header-line-color) 20%,
          var(--header-line-color) 80%,
          transparent
        );
      background-origin: padding-box, border-box;
      background-clip: padding-box, border-box;
    }
    h1 {
      font-size: 26px;
      font-weight: 700;
      margin: 0 0 8px 0;
      letter-spacing: 2px;
    }
    .contact-info {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 10px;
      font-size: 13px;
      color: var(--light-text);
    }
    .contact-item a {
      color: var(--link-color);
      text-decoration: none;
    }
    section {
      margin-bottom: 20px;
    }
    h2 {
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin: 0 0 12px 0;
      padding-bottom: 5px;
      border-bottom: 1px solid var(--primary-color);
    }
    .entry {
      margin-bottom: 16px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border-color);
    }
    .entry:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }
    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 6px;
    }
    .entry-org {
      font-weight: 700;
      font-size: 15px;
      color: var(--text-color);
    }
    .entry-date {
      font-size: 13px;
      color: var(--light-text);
    }
    .entry-major {
      font-size: 14px;
      color: var(--text-color);
      font-weight: 500;
      margin-top: 2px;
    }
    .entry-role {
      font-size: 14px;
      color: var(--text-color);
      font-weight: 500;
      margin-bottom: 4px;
    }
    .entry-desc {
      font-size: 13px;
      color: var(--tag-text);
      margin: 6px 0 0 0;
      padding-left: 10px;
      border-left: 1px solid var(--border-color);
      line-height: 1.6;
    }
    .project-entry {
      margin-bottom: 18px;
      padding-bottom: 15px;
      border-bottom: 1px dotted var(--border-color);
    }
    .project-entry:last-child {
      border-bottom: none;
    }
    .project-name {
      font-weight: 700;
      font-size: 15px;
      color: var(--text-color);
    }
    .project-role {
      font-size: 13px;
      color: var(--tag-text);
      margin-left: 10px;
    }
    .project-meta {
      font-size: 12px;
      color: var(--light-text);
      margin: 4px 0 8px 0;
    }
    .project-meta a {
      color: var(--link-color);
      text-decoration: none;
    }
    .project-abstract {
      font-size: 13px;
      color: var(--text-color);
      margin: 8px 0;
      padding-left: 12px;
      border-left: 2px solid var(--border-color);
    }
    .project-points {
      margin: 8px 0 0 0;
      padding-left: 18px;
    }
    .project-points li {
      font-size: 13px;
      margin-bottom: 4px;
      color: var(--text-color);
    }
    .tech-tags {
      margin-top: 8px;
    }
    .tech-tag {
      display: inline-block;
      font-size: 11px;
      background: var(--tag-bg);
      color: var(--tag-text);
      padding: 2px 8px;
      margin-right: 5px;
      margin-bottom: 4px;
      border: 1px solid var(--tag-border);
    }
    .skills-row {
      display: flex;
      margin-bottom: 6px;
      font-size: 13px;
    }
    .skills-label {
      width: 120px;
      font-weight: 600;
      color: var(--text-color);
      flex-shrink: 0;
    }
    .skills-content {
      color: var(--light-text);
    }
    .award-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 13px;
      margin-bottom: 5px;
    }
    .award-name {
      color: var(--text-color);
    }
    .award-date {
      color: var(--light-text);
    }
    .other-list {
      margin: 0;
      padding-left: 18px;
    }
    .other-list li {
      font-size: 13px;
      margin-bottom: 4px;
      color: var(--text-color);
    }
    /* Extra Large Screens */
    @media (min-width: 1400px) {
      .container {
        max-width: 900px;
      }
      body {
        font-size: 16px;
        line-height: 1.6;
      }
      h1 {
        font-size: 32px;
      }
      h2 {
        font-size: 16px;
      }
      .contact-info {
        font-size: 14px;
        gap: 28px;
      }
      .entry-title,
      .project-name {
        font-size: 16px;
      }
      .entry-date,
      .project-role {
        font-size: 14px;
      }
      .entry-desc,
      .project-abstract,
      .project-points li,
      .skills-row,
      .award-row,
      .other-list li {
        font-size: 14px;
      }
      .project-meta {
        font-size: 13px;
      }
      .tech-tag {
        font-size: 12px;
        padding: 3px 10px;
      }
      .skills-label {
        width: 140px;
      }
    }
    /* Large Screens */
    @media (min-width: 1200px) and (max-width: 1399px) {
      .container {
        max-width: 850px;
      }
      h1 {
        font-size: 28px;
      }
      h2 {
        font-size: 15px;
      }
      .contact-info {
        font-size: 14px;
        gap: 24px;
      }
      .entry-title,
      .project-name {
        font-size: 15px;
      }
      .entry-desc,
      .project-abstract,
      .project-points li {
        font-size: 14px;
      }
    }
    /* Medium Screens */
    @media (min-width: 900px) and (max-width: 1199px) {
      .container {
        max-width: 820px;
      }
    }
    /* Tablet Adaptation */
    @media (max-width: 768px) {
      .container {
        padding: 0 30px;
      }
      .skills-row {
        flex-wrap: wrap;
      }
      .skills-label {
        width: 100%;
        margin-bottom: 4px;
      }
      .award-row {
        gap: 5px;
      }
    }
    /* Mobile Adaptation */
    @media (max-width: 600px) {
      .container {
        margin: 20px auto;
        padding: 0 16px;
      }
      h1 {
        font-size: 22px;
        letter-spacing: 1px;
      }
      h2 {
        font-size: 13px;
      }
      .contact-info {
        flex-direction: column;
        align-items: center;
        gap: 6px;
      }
      .entry-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 2px;
      }
      .entry-org {
        font-size: 14px;
      }
      .entry-date {
        margin-top: 2px;
        font-size: 12px;
      }
      .entry-major {
        font-size: 13px;
      }
      .entry-role {
        font-size: 13px;
      }
      .project-name {
        font-size: 13px;
      }
      .project-role {
        display: block;
        margin-left: 0;
        margin-top: 2px;
      }
      .project-meta {
        font-size: 11px;
        line-height: 1.6;
      }
      .project-abstract {
        padding-left: 10px;
        font-size: 12px;
      }
      .project-points {
        padding-left: 16px;
      }
      .project-points li {
        font-size: 12px;
      }
      .tech-tag {
        font-size: 10px;
        padding: 2px 6px;
      }
      .skills-row {
        flex-direction: column;
        font-size: 12px;
      }
      .skills-label {
        width: 100%;
        margin-bottom: 3px;
      }
      .skills-content {
        padding-left: 0;
      }
      .award-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 2px;
        font-size: 12px;
      }
      .award-date {
        margin-left: 0;
      }
      .other-list li {
        font-size: 12px;
      }
    }
    /* Small Mobile Strings */
    @media (max-width: 380px) {
      .container {
        padding: 0 12px;
      }
      h1 {
        font-size: 20px;
      }
      .contact-info {
        font-size: 12px;
      }
    }
    /* Print Optimization */
    @media print {
      body {
        font-size: 12px;
      }
      .container {
        margin: 0;
        padding: 20px;
        max-width: 100%;
      }
      .toggle-projects-btn {
        display: none !important;
      }
      .project-entry.hidden {
        display: block !important;
      }
    }

    .toggle-projects-btn {
      display: block;
      margin: 10px auto 0;
      padding: 6px 20px;
      background: transparent;
      border: 1px solid #ddd;
      color: #666;
      font-size: 13px;
      cursor: pointer;
      border-radius: 20px;
      transition: all 0.2s;
      font-family: inherit;
    }
    .toggle-projects-btn:hover {
      background: var(--hover-bg);
      color: var(--text-color);
      border-color: var(--tag-border);
    }
    .project-entry.hidden {
      display: none;
    }
    .project-entry.no-border {
      border-bottom: none;
    }
    .back-btn {
      position: fixed;
      top: 20px;
      left: 20px;
      text-decoration: none;
      color: #666;
      font-size: 14px;
      z-index: 100;
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 5px;
    }
    .back-btn:hover {
      color: #000;
    }
    @media print {
      .back-btn {
        display: none;
      }
    }
    @media (max-width: 1100px) {
      .back-btn {
        position: absolute;
        top: 15px;
        left: 15px;
      }
    }
  </style>

  <a href="/" class="back-btn">
    <i class="fas fa-arrow-left"></i> Back to Home
  </a>

