---
import Layout from "../layouts/Layout.astro";
import PrintFooter from "../components/PrintFooter.astro";
import MermaidDiagram from "../components/MermaidDiagram.astro";
import { moidasArchitecture } from "../diagrams/moidas-architecture";
import { CONTENT_LAST_UPDATED } from "../data/site";
import "../styles/global.css";
import "../styles/cv.css";

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://cv.wilboerht.com/CV-en/#page",
  "url": "https://cv.wilboerht.com/CV-en/",
  "inLanguage": "en",
  "name": "Hongkun Wang - CV",
  "description": "Profile page for Hongkun Wang, Digital Development Manager and full-stack engineer in Shanghai.",
  "isPartOf": { "@id": "https://cv.wilboerht.com/#website" },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".tagline", ".entry-summary"]
  },
  "dateModified": CONTENT_LAST_UPDATED,
  "mainEntity": {
    "@type": "Person",
    "@id": "https://wilboerht.com/#person",
    "name": "Hongkun Wang",
    "alternateName": ["王泓坤", "Hank Wong", "wilboerht", "왕홍곤"],
    "givenName": "Hongkun",
    "familyName": "Wang",
    "description": "Digital Development Manager and full-stack engineer (TypeScript / React / Next.js / AI / RAG) based in Shanghai. The first engineer in Moidas' (NIHPLOD) Greater China division — built its brand website, membership & points system, unified authentication, AI skincare advisor, WeCom AI customer service, authorization verification platform, and two mini-programs from the ground up.",
    "email": "me@wilboerht.cn",
    "url": "https://wilboerht.com",
    "image": {
      "@type": "ImageObject",
      "url": "https://wilboerht.com/opengraph-image",
      "width": 1200,
      "height": 630,
      "caption": "Hongkun Wang · CV"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Shanghai",
      "addressCountry": "CN"
    },
    "sameAs": [
      "https://github.com/wilboerht",
      "https://x.com/wilboerht",
      "https://www.linkedin.com/in/wilboerht/"
    ],
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "Shanghai Scientific and Technical Vocational College"
      }
    ],
    "knowsAbout": [
      "TypeScript",
      "React",
      "Next.js",
      "Vue 3",
      "Node.js",
      "FastAPI",
      "Prisma",
      "PostgreSQL",
      "Redis",
      "Large Language Models",
      "RAG",
      "Docker",
      "Linux"
    ],
    "jobTitle": "Digital Development Manager",
    "worksFor": {
      "@type": "Organization",
      "@id": "https://nihplod.cn/#organization",
      "name": "Moidas",
      "url": "https://nihplod.cn"
    },
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": '3rd Prize in "Web Technology" at the Shanghai "Starlight Plan" Vocational Skills Competition (ranked 16th in Shanghai)',
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "MOHRSS Vocational Skill Level Certificate: Computer Programmer Grade III (Advanced) (Competition)",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "National Information Security Test Program Grade II (NISP)",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "CTyun Advanced Developer Certification (SCCP)",
        "dateCreated": "2024-11"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "Alibaba Cloud ACA Cloud Security Associate Certification",
        "dateCreated": "2024-10"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "CTyun Advanced O&M Engineer Certification",
        "dateCreated": "2024-05"
      }
    ],
    "award": '3rd Prize in "Web Technology" at the Shanghai "Starlight Plan" Vocational Skills Competition'
  }
};
---

<Layout
  title="Hongkun Wang - CV"
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld, null, 2)} />
  </Fragment>
  <div class="container">
    <header>
      <h1>Hongkun Wang</h1>
      <p class="tagline">Digital Development Manager · Full-Stack Engineer · Shanghai</p>
      <div class="contact-info">
        <span class="contact-item"><a href="mailto:me@wilboerht.cn">me@wilboerht.cn</a></span>
        <span class="contact-item"><a href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer">GitHub</a></span>
        <span class="contact-item"><a href="https://www.linkedin.com/in/wilboerht/" target="_blank" rel="noopener noreferrer">LinkedIn</a></span>
        <span class="contact-item"><a href="https://wilboerht.com" target="_blank" rel="noopener noreferrer">wilboerht.com</a></span>
      </div>
    </header>

    <section>
      <h2>Profile</h2>
      <p class="entry-desc">
        Digital Development Manager and full-stack engineer based in Shanghai,
        focused on TypeScript / React / Next.js and AI / RAG engineering. As the
        first engineer in Moidas' (NIHPLOD) Greater China division, built 7 core
        systems from the ground up — brand website &amp; membership platform,
        unified SSO, AI skincare advisor, WeCom AI customer service, authorization
        verification platform, AI skin-analysis mini-program, and member-center
        mini-program — backed by 2,900+ automated test cases. Strong at owning end-to-end delivery from
        requirements and design to launch and operations with a product mindset.
      </p>
    </section>

    <section>
      <h2>Experience</h2>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">Moidas · NIHPLOD Greater China Division</h3>
          <div class="entry-meta">
            <span class="entry-role">Digital Development Manager</span>
            <span class="entry-date">Oct 2025 – Present (promoted Jul 2026)</span>
          </div>
        </div>
        <p class="entry-summary">
          Joined as a full-time intern in Oct 2025 while completing studies, transitioned to a full-time role in Jul 2026, and reports directly to the brand lead. As the division's first engineer, independently owns full-stack delivery from requirements and design to development and launch with a product mindset and AI-assisted workflows. Within the first 12 months, built and launched 7 core systems from the ground up (2 mini-programs still iterating), backed by 2,900+ automated test cases, and connected the business loop of "skin analysis → personalized regimen → 7×24 AI advisor follow-up → repurchase" through unified accounts and profile data.
        </p>
        <ul class="project-points">
          <li>Own planning, technology selection and full-stack delivery of the brand's Greater China digital product portfolio, covering the full lifecycle of 7 core systems from requirements and design to development, launch and operations.</li>
          <li>Contribute to defining the Greater China membership system with brand and operations teams — four membership tiers, benefits, points and redemption rules — and deliver it across the official website and mini-program member center to support retention and repurchase.</li>
          <li>Establish AI-assisted development workflows and design standards, reducing average delivery cycles by about 50% while enabling parallel multi-project delivery.</li>
          <li>As technical lead, gather requirements from product and marketing teams and translate them into delivery schedules, owning requirement reviews and iteration cadence, supporting the brand's online retail channel (official China website) from inception to launch.</li>
          <li>Lead ICP filing, privacy policy and user agreement drafting, and data compliance review to ensure compliant launches across systems.</li>
          <li>Dynamically adjust server resources based on traffic to optimize infrastructure costs.</li>
        </ul>
        <MermaidDiagram
          code={moidasArchitecture.en}
          alt="Architecture overview of Moidas' Greater China digital systems: unified SSO connecting the official website, AI skin analysis, AI customer service and authorization verification"
          zoomLabel="View larger"
          closeLabel="Close"
        />
      </div>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">Shanghai Lingang Jinghong Security Technology Development Co., Ltd.</h3>
          <div class="entry-meta">
            <span class="entry-role">R&amp;D Intern</span>
            <span class="entry-date">Jul 2025 – Sep 2025</span>
          </div>
        </div>
        <ul class="project-points">
          <li>Independently delivered the company website end-to-end, from architecture and UI/UX design to production deployment, with first-screen load under 1.5s.</li>
          <li>Completed an internal MVP campus patrol management platform via secondary development on the Unitree robot dog SDK, validating product feasibility.</li>
          <li>Drove the company's first internal adoption of an AI Q&amp;A assistant with a RAG pipeline (answer accuracy above 85%) and participated in business discussions with Baidu's Enterprise Q&amp;A team.</li>
        </ul>
      </div>
    </section>

    <section>
      <div class="project-section-head">
        <h2>Projects</h2>
        <a class="project-github-link" href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer" aria-label="View GitHub profile">
          <svg class="project-github-link__icon" aria-hidden="true"><use href="#icon-github"></use></svg>
          GitHub profile
        </a>
      </div>

      <div class="project-entry" data-project-logo="/images/NIHPLOD-logo.svg" id="project-website">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-website" aria-haspopup="dialog">NIHPLOD China Official Website</button></h3>
          <span class="entry-date">Nov 2025 – Present</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">Independently led product, UI/UX, full-stack development, deployment, and operations</span> <a href="https://nihplod.cn" target="_blank" rel="noopener noreferrer" class="project-meta-link"><span>nihplod.cn</span><svg class="project-meta-link__icon" aria-hidden="true"><use href="#icon-external"></use></svg></a>
        </div>
        <p class="project-summary">Brand website and membership platform for the China market: integrates product discovery, e-commerce referral, member points and skin profiles into one experience, unifies WeChat / Douyin / phone-number identities, and supports the brand's online retail launch and repeat purchases; 205 API routes / 51 models / 2,100+ tests (this system alone).</p>
        <button type="button" class="project-more" data-project-dialog="project-website" aria-haspopup="dialog" aria-label="View details: NIHPLOD China Official Website"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>View details</button>
        <dialog class="project-dialog" id="dialog-project-website">
          <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="Close">&times;</button>
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
            </div>
            <div class="project-dialog__content">
            <ul class="project-points">
              <li>
                <strong>Brand Website &amp; Member Platform:</strong> Built the brand's official website and member platform with Next.js 16 + Prisma + PostgreSQL — product showcases, third-party e-commerce referral (Tmall / Douyin / Xiaohongshu / WeChat Shop links + GA event tracking), membership tiers, points ledger, points redemption (SF Express tracking), manual purchase record entry for offline purchases, skin profiles, and an account security center; consolidated WeChat, Douyin, and phone OTP identities into a unified account system — 205 API routes, 51 data models, and 2,100+ automated test cases (this system alone).
              </li>
              <li>
                <strong>Product &amp; Interaction Design:</strong> Owned product design and authored the PRD independently; completed the information architecture, interaction, and UI/UX design independently and implemented directly in code. Built multi-step skincare ritual guides and immersive brand storytelling with Framer Motion + View Transitions, integrated the product drawer with detail pages, and delivered fully responsive layouts.
              </li>
              <li>
                <strong>Admin Console &amp; Security Governance:</strong> Built an admin console covering products / categories / members / points redemption / manual purchase record entry / job postings / messages / OAuth clients (Tiptap rich text), with TOTP two-factor authentication and step-up verification for sensitive actions, operation audit logs and daily integrity checkpoints, scheduled jobs, database-persisted rate limiting, and webhook failure retries; implemented SEO / GEO (generative engine optimization; sitemap / JSON-LD / llms.txt / Baidu push).
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

      <div class="project-entry" data-project-logo="/images/NIHPLOD-logo.svg" id="project-sso">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-sso" aria-haspopup="dialog">NIHPLOD Unified Authentication Platform (SSO / OIDC)</button></h3>
          <span class="entry-date">Jul 2026 – Present</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">Independently led product, full-stack development, deployment, and operations</span>
        </div>
        <p class="project-summary">Unified identity foundation for Greater China: a self-built OAuth 2.0 / OIDC single sign-on covering 5 systems — two WeChat mini-programs, the official website (user and admin sides), the skin-analysis sub-site (user and admin sides), and the BA authorization verification platform (admin side); it enables cross-system single sign-on and global sign-out, with TOTP 2FA on admin consoles, packaged as a reusable npm SDK.</p>
        <button type="button" class="project-more" data-project-dialog="project-sso" aria-haspopup="dialog" aria-label="View details: NIHPLOD Unified Authentication Platform (SSO / OIDC)"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>View details</button>
        <dialog class="project-dialog" id="dialog-project-sso">
          <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="Close">&times;</button>
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
            </div>
            <div class="project-dialog__content">
            <ul class="project-points">
              <li>
                <strong>Protocol Implementation:</strong> Built a self-hosted OAuth 2.0 / OIDC SSO, co-deployed on the same domain as the official main site, which acts as the Authorization Server issuing RS256 JWTs — fully implementing the authorize / token / userinfo / introspect / revoke / end-session protocol endpoints with support for PKCE and DPoP; the admin console is protected by TOTP two-factor authentication.
              </li>
              <li>
                <strong>SDK &amp; Integration:</strong> Packaged and published npm SDKs (@nihplod/sso-sdk / @nihplod/sso-verify) so sub-projects can integrate in minutes; enables cross-system SSO and global sign-out via Token Introspection + Backchannel Logout, supporting unified login across two WeChat mini-programs, the official website (user and admin sides), the skin-analysis sub-site (user and admin sides), and the BA authorization verification platform (admin side).
              </li>
              <li>
                <strong>Security Hardening:</strong> Supports secret rotation, token revocation (RFC 7009), and multi-instance blacklist sharing for a maintainable and auditable auth system.
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

      <div class="project-entry" data-project-logo="/images/NIHPLOD-logo.svg" id="project-ai-advisor">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-ai-advisor" aria-haspopup="dialog">AI Skincare Advisor System</button></h3>
          <span class="entry-date">Jan 2026 – Present</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">Independently led product, interaction, and full-stack development, deployment, and operations, with UI visual design in collaboration</span> <a href="https://smart.nihplod.cn" target="_blank" rel="noopener noreferrer" class="project-meta-link"><span>smart.nihplod.cn</span><svg class="project-meta-link__icon" aria-hidden="true"><use href="#icon-external"></use></svg></a>
        </div>
        <p class="project-summary">AI skincare advisor for consumers: dual-channel skin analysis via questionnaire + face scan, personalized product recommendations based on skin type, season and region, with reports and profiles passed to WeCom advisors — closing the loop from analysis to regimen, follow-up and repurchase; 93 API routes / 531 tests.</p>
        <button type="button" class="project-more" data-project-dialog="project-ai-advisor" aria-haspopup="dialog" aria-label="View details: AI Skincare Advisor System"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>View details</button>
        <dialog class="project-dialog" id="dialog-project-ai-advisor">
          <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="Close">&times;</button>
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
            </div>
            <div class="project-dialog__content">
            <ul class="project-points">
              <li>
                <strong>AI Skin Analysis &amp; Personalized Recommendations:</strong> Integrated Tongyi Qianwen VL / DeepSeek LLMs for dual-channel (questionnaire + facial scan) skin analysis; a custom rule engine scores and matches products against 8 skin types plus seasonal / regional environmental factors, configurable through a visual admin console so operations teams can adjust without code.
              </li>
              <li>
                <strong>Conversion &amp; Attribution:</strong> Led model integration and core API development; e-commerce outbound links (Tmall / Douyin / Xiaohongshu / WeChat Shop) support UTM / pid tracking and click-event instrumentation, forming an attributable consultation-to-conversion path together with WeCom advisor short links.
              </li>
              <li>
                <strong>Growth &amp; Membership Operations:</strong> Integrated four-tier member skin-analysis quotas (Standard: 10 lifetime sessions; Silver: base 10 + 20 per ¥1,000 spent; Gold / Diamond: unlimited total; all paid tiers: max 10/day), with reports and profiles tied to the logged-in account; designed share posters, channel ref attribution, and registration-conversion popups, and exported desensitized aggregate CSV statistics to inform the brand whitepaper and market insights.
              </li>
              <li>
                <strong>AI Cost &amp; Reliability Engineering:</strong> Designed an AI request queue with concurrency control, circuit breakers, daily / monthly token and cost budget caps, persisted per-call billing, and a model whitelist with provider fallback; used idempotent retries and quota reservation / release to prevent duplicate charges; skin profiles have a rolling 90-day validity with retest prompts, full reports are retained for 365 days, and hot / cold tiered storage keeps the latest 10 full reports plus desensitized cold-tier summaries for up to 3 years.
              </li>
              <li>
                <strong>Data Asset Loop:</strong> Designed a server-to-server API with HMAC signatures + IP rate limiting; skin-analysis reports and skincare profiles are passed to WeCom AI customer service via session_id, turning one-off skin tests into user data assets that support ongoing engagement and repeat purchases.
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

      <div class="project-extra" id="project-extra" hidden>
      <div class="project-entry project-entry--static" id="project-wecom-ai">
        <div class="entry-header">
          <h3 class="project-name">WeCom AI Customer Service</h3>
          <span class="entry-date">Aug 2026</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">Independently led product, full-stack development, deployment, and operations</span>
          <a href="https://kf.nihplod.cn" target="_blank" rel="noopener noreferrer" class="project-meta-link"><span>kf.nihplod.cn</span><svg class="project-meta-link__icon" aria-hidden="true"><use href="#icon-external"></use></svg></a>
        </div>
        <p class="project-summary">WeCom AI customer service built with FastAPI + Redis + DeepSeek: unifies three message entry points (WeCom customer service, WeCom app, and WeChat Official Account), supports smart human handoff, inherits skincare profiles, and provides 7×24 companion-style follow-up; 44KB brand FAQ knowledge base, 34 golden regression cases, 340+ automated tests, and PIPL-compliant PII export/deletion.</p>
      </div>

      <div class="project-entry project-entry--static" id="project-authorization">
        <div class="entry-header">
          <h3 class="project-name">NIHPLOD Authorization &amp; Verification Platform</h3>
          <span class="entry-date">Apr 2026 – May 2026</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">Independently led product, design, full-stack development, deployment, and operations</span>
          <a href="https://ba.nihplod.cn" target="_blank" rel="noopener noreferrer" class="project-meta-link"><span>ba.nihplod.cn</span><svg class="project-meta-link__icon" aria-hidden="true"><use href="#icon-external"></use></svg></a>
        </div>
        <p class="project-summary">Dealer authorization management and anti-counterfeit verification platform built with Next.js 16 + PostgreSQL: two-level review workflow and certificate state machine, Canvas + jsPDF real-time synthesis of authorization certificates with e-seal and dynamic QR codes; public verification with three-tier fallback matching and camera QR scanning, plus counterfeit-report ticketing, JWT blacklisting, and operation audit.</p>
      </div>

      <div class="project-entry project-entry--static" id="project-skin-miniprogram">
        <div class="entry-header">
          <h3 class="project-name">Jizhipai AI Skin Analysis Mini-Program</h3>
          <span class="entry-date">Oct 2026 – Present</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">Independently led product, design, mini-program development, deployment, and operations</span>
        </div>
        <p class="project-summary">WeChat mini-program version of the skin-analysis flow: 14 pages, with WeChat VisionKit and 106 keypoints for four-step pose guidance (front / right / left / chin-up) and auto-capture; async analysis polling, Canvas 2D 10-dimension radar chart and skin trend curve, dynamic score poster, and retest subscription messages.</p>
      </div>

      <div class="project-entry project-entry--static" id="project-member-miniprogram">
        <div class="entry-header">
          <h3 class="project-name">NIHPLOD Member Center Mini-Program</h3>
          <span class="entry-date">Oct 2026 – Present</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">Independently led product, mini-program development, deployment, and operations</span>
        </div>
        <p class="project-summary">19-page member center mini-program in native TypeScript: WeChat one-click login, member tiers and upgrade progress, points balance and transactions, gift redemption (requestId idempotency), address book, SF Express tracking, manual purchase record entry, security center, and account deletion; connects directly to the official website's OAuth 2.0 and business APIs with no custom backend.</p>
      </div>

      <div class="project-entry project-entry--static" id="project-myskin">
        <div class="entry-header">
          <h3 class="project-name">Myskin.Today Brand Website</h3>
          <span class="entry-date">Jan 2026 – Feb 2026</span>
        </div>
        <div class="project-meta">
          <span class="project-meta-owner">Independently led product, design, full-stack development, AIGC visuals, deployment, and operations</span>
          <a href="https://myskin.today" target="_blank" rel="noopener noreferrer" class="project-meta-link"><span>myskin.today</span><svg class="project-meta-link__icon" aria-hidden="true"><use href="#icon-external"></use></svg></a>
        </div>
        <p class="project-summary">B2B website for the AI skin-analysis platform built with Next.js 16 + Tailwind CSS v4: product capability showcase, three business-model landing pages (API integration / white-label / strategic partnership), and API documentation; partnership inquiries pushed to a WeCom bot in real time, with a custom design system, light/dark themes, and AIGC visual assets.</p>
      </div>
      </div>

      <div class="project-toggle-wrap">
        <button type="button" class="project-toggle" data-project-toggle aria-expanded="false" aria-controls="project-extra">
          <span class="project-toggle__more">Show more projects</span>
          <span class="project-toggle__less">Show less</span>
        </button>
      </div>

    </section>

    <section>
      <h2>Tech Stack</h2>
      <div class="skills-row">
        <span class="skills-label">Frontend &amp; Mini Programs:</span>
        <span class="skills-content">TypeScript · React · Next.js · Vue 3 · uni-app · WeChat Mini Program · Tailwind CSS · Canvas 2D</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">Backend &amp; Data:</span>
        <span class="skills-content">Node.js · Python (FastAPI) · Prisma · PostgreSQL · Redis · RESTful API</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">AI Engineering:</span>
        <span class="skills-content">LLM integration · vision-based skin analysis · RAG · prompt / knowledge base · AI cost engineering (circuit breakers / budget caps) · model evaluation &amp; regression testing · AI-assisted development (Claude Code / Codex)</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">Engineering &amp; Platform:</span>
        <span class="skills-content">Linux · Docker · Nginx · CDN · automated testing (unit / integration / regression)</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">Security &amp; Compliance:</span>
        <span class="skills-content">OAuth 2.0 · OIDC · SSO · JWT · TOTP · CSP · RLS (row-level security) · ICP filing · privacy &amp; data compliance (PIPL)</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">Product &amp; UI/UX:</span>
        <span class="skills-content">product design (PRD) · UI/UX design · interaction design · design review · design-to-code</span>
      </div>
    </section>

    <section>
      <h2>Awards &amp; Certifications</h2>
      <div class="award-row">
        <span class="award-name">3rd Prize in "Web Technology" at the Shanghai "Starlight Plan" Vocational Skills Competition (16th in Shanghai)</span>
        <span class="award-date">May 2025</span>
      </div>
      <div class="award-row">
        <span class="award-name">MOHRSS Vocational Skill Level Certificate · Computer Programmer (Grade III/Senior Worker, Competition)</span>
