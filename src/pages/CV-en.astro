---
import Layout from "../layouts/Layout.astro";
import PrintFooter from "../components/PrintFooter.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MermaidDiagram from "../components/MermaidDiagram.astro";
import { moidasArchitecture } from "../diagrams/moidas-architecture";
import "../styles/global.css";
import "../styles/cv.css";

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://cv.wilboerht.com/CV-en/#page",
  "url": "https://cv.wilboerht.com/CV-en/",
  "inLanguage": "en",
  "dateModified": new Date().toISOString(),
  "mainEntity": {
    "@type": "Person",
    "@id": "https://www.wilboerht.com/#person",
    "name": "Hongkun Wang",
    "alternateName": "王泓坤",
    "givenName": "Hongkun",
    "familyName": "Wang",
    "description": "Digital Development Manager and full-stack engineer (TypeScript / React / Next.js / AI / RAG) based in Shanghai. First engineer of a brand's Greater China division — built its brand website, membership & points system, unified authentication, AI advisor, customer service, and mini-programs from 0 to 1.",
    "email": "me@wilboerht.cn",
    "url": "https://www.wilboerht.com",
    "image": "https://cv.wilboerht.com/og-image.png",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Shanghai",
      "addressCountry": "CN"
    },
    "sameAs": [
      "https://github.com/Wilboerht",
      "https://twitter.com/wilboerht"
    ],
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "Shanghai Scientific and Technical Vocational College"
      }
    ],
    "knowsAbout": [
      "TypeScript",
      "React",
      "Next.js",
      "Vue 3",
      "Node.js",
      "FastAPI",
      "Prisma",
      "PostgreSQL",
      "Redis",
      "Large Language Models",
      "RAG",
      "Docker",
      "Linux"
    ],
    "jobTitle": "Digital Development Manager",
    "worksFor": {
      "@type": "Organization",
      "name": "Moidas",
      "url": "https://www.nihplod.cn"
    },
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": '3rd Prize in "Web Technology" at the Shanghai "Starlight Plan" Vocational Skills Competition (ranked 16th in Shanghai)',
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "MOHRSS Vocational Skill Level Certificate: Computer Programmer Grade III (Advanced) (Competition)",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "National Information Security Test Program Grade II (NISP)",
        "dateCreated": "2025-05"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "CTyun Advanced Developer Certification (SCCP)",
        "dateCreated": "2024-11"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "Alibaba Cloud ACA Cloud Security Associate Certification",
        "dateCreated": "2024-10"
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": "CTyun Advanced O&M Engineer Certification",
        "dateCreated": "2024-05"
      }
    ],
    "award": '3rd Prize in "Web Technology" at the Shanghai "Starlight Plan" Vocational Skills Competition'
  }
};
---

<Layout
  title="Hongkun Wang - CV"
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld, null, 2)} />
  </Fragment>
  <style>
    :root {
      --cv-font-body: 'Noto Serif SC', 'Source Serif 4', serif;
    }
  </style>

  <div class="container">
    <header>
      <h1>Hongkun Wang</h1>
      <p class="tagline">Digital Development Manager · Full-Stack Engineer · Shanghai</p>
      <div class="contact-info">
        <span class="contact-item"><a href="mailto:me@wilboerht.cn">me@wilboerht.cn</a></span>
        <span class="contact-item"><a href="https://github.com/Wilboerht" target="_blank" rel="noopener noreferrer">GitHub</a></span>
        <span class="contact-item"><a href="https://www.wilboerht.com" target="_blank" rel="noopener noreferrer">wilboerht.com</a></span>
      </div>
    </header>

    <section>
      <h2>Experience</h2>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">Moidas · NIHPLOD Greater China Division</h3>
          <div class="entry-meta">
            <span class="entry-role">Digital Development Manager</span>
            <span class="entry-date">Oct 2025 – Present</span>
          </div>
        </div>
        <p class="entry-summary">
          Joined as an intern in Oct 2025, converted to full-time in Jul 2026, and reports directly to the brand lead. As the division's first engineer, independently owns full-stack delivery from requirements and design to development and launch with a product mindset and AI-assisted workflows; delivered 7 core systems and 2,100+ automated test cases from 0 to 1 within 12 months, connecting the business loop of "skin analysis → personalized regimen → AI advisor follow-up → repurchase" through unified accounts and profile data.
        </p>
        <ul class="project-points">
          <li>Owned planning, technology selection and full-stack delivery of the brand's Greater China digital product portfolio, covering the full lifecycle of 7 core systems from requirements and design to development, launch and operations.</li>
          <li>Contributed to defining the Greater China membership system with brand and operations teams — four membership tiers, benefits, points and redemption rules — and delivered it across the official website and mini-program member center to support retention and repurchase.</li>
          <li>Established AI-assisted development workflows and design standards, reducing average delivery cycles by over 50% while ensuring parallel multi-project delivery.</li>
          <li>As technical lead, took in requirements from product and marketing teams and broke them down into schedules, owning requirement reviews and iteration cadence, supporting the brand's online retail channel (official China website) from 0 to launch.</li>
          <li>Led ICP filing, privacy policy and user agreement drafting, and data compliance review to ensure compliant launches across systems; dynamically adjusted server resources based on traffic to optimize costs.</li>
        </ul>
        <MermaidDiagram
          code={moidasArchitecture.en}
          alt="Architecture overview of Moidas' Greater China digital systems: unified SSO connecting the official website, AI skin analysis, AI customer service and authorization verification"
          zoomLabel="Click to enlarge"
          closeLabel="Close"
        />
      </div>
      <div class="entry">
        <div class="entry-header entry-header--stacked">
          <h3 class="entry-org">Shanghai Lingang Jinghong Security Technology Development Co., Ltd.</h3>
          <div class="entry-meta">
            <span class="entry-role">R&amp;D Intern</span>
            <span class="entry-date">Jul 2025 – Sep 2025</span>
          </div>
        </div>
        <ul class="project-points">
          <li>Independently delivered the company website end-to-end, from architecture and UI/UX design to production deployment.</li>
          <li>Completed an internal MVP campus patrol management platform via secondary development on the Unitree robot dog SDK, validating product feasibility.</li>
          <li>Drove the company's first internal adoption of AI Q&amp;A tools and participated in the company's business engagement with Baidu's official Enterprise Q&amp;A team.</li>
        </ul>
      </div>
    </section>

    <section>
      <h2>Selected Projects</h2>

      <div class="project-entry" id="project-website">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-website">NIHPLOD China Official Website</button></h3>
          <span class="entry-date">Nov 2025 – Present</span>
        </div>
        <div class="project-meta">
          Independently delivered · product / UI/UX / full-stack · <a href="https://www.nihplod.cn" target="_blank" rel="noopener noreferrer">nihplod.cn ↗</a>
        </div>
        <p class="project-summary">Launched the brand website and membership platform from 0 to 1; 169 API routes / 43 models / 1,725 tests, unifying identities across platforms.</p>
        <button type="button" class="project-more" data-project-dialog="project-website"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>View details</button>
        <dialog class="project-dialog" id="dialog-project-website">
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
              <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="Close">&times;</button>
            </div>
            <div class="project-dialog__content">
              <div class="project-dialog__media">
                <div class="project-media-placeholder" aria-hidden="true">
                  <svg class="project-media-placeholder__icon"><use href="#icon-image"></use></svg>
                  <span>Project screenshot / UI preview</span>
                </div>
                <div class="project-media-placeholder" aria-hidden="true">
                  <svg class="project-media-placeholder__icon"><use href="#icon-image"></use></svg>
                  <span>Logic / architecture diagram</span>
                </div>
              </div>
            <ul class="project-points">
              <li>
                <strong>Brand Website &amp; Member Platform:</strong> Built the brand's official website and member platform with Next.js 16 + Prisma + PostgreSQL — product showcases, third-party e-commerce referral (Tmall / Douyin / Xiaohongshu links + GA event tracking), membership tiers, points ledger, points redemption (SF Express tracking), consumption backfill, skin profiles, and a security center; aggregated WeChat, Douyin, and phone OTP identities into a unified account system — 169 API routes, 43 data models, and 1,725 automated test cases.
              </li>
              <li>
                <strong>Product &amp; Interaction Design:</strong> Independently designed the information architecture, Figma interactive prototypes, and visual styling; built multi-step skincare ritual guides and immersive brand storytelling with Framer Motion + View Transitions, integrated the product drawer with detail pages, and delivered fully responsive layouts.
              </li>
              <li>
                <strong>Admin Console &amp; Security Governance:</strong> Built an admin console covering products / categories / members / points redemption / consumption backfill / jobs / messages / OAuth clients (Tiptap rich text), with TOTP two-factor authentication and step-up verification for sensitive actions, operation audit logs and daily integrity anchors, scheduled jobs, database-persisted rate limiting, and webhook failure retries; completed SEO / GEO (sitemap / JSON-LD / llms.txt / Baidu push).
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

      <div class="project-entry" id="project-sso">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-sso">NIHPLOD Unified Authentication Platform (SSO / OIDC)</button></h3>
          <span class="entry-date">Jun 2026 – Present</span>
        </div>
        <div class="project-meta">
          Independently delivered · product / full-stack
        </div>
        <p class="project-summary">Built OAuth 2.0 / OIDC single sign-on for 5 systems, plus a reusable npm SDK.</p>
        <button type="button" class="project-more" data-project-dialog="project-sso"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>View details</button>
        <dialog class="project-dialog" id="dialog-project-sso">
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
              <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="Close">&times;</button>
            </div>
            <div class="project-dialog__content">
              <div class="project-dialog__media">
                <div class="project-media-placeholder" aria-hidden="true">
                  <svg class="project-media-placeholder__icon"><use href="#icon-image"></use></svg>
                  <span>Project screenshot / UI preview</span>
                </div>
                <div class="project-media-placeholder" aria-hidden="true">
                  <svg class="project-media-placeholder__icon"><use href="#icon-image"></use></svg>
                  <span>Logic / architecture diagram</span>
                </div>
              </div>
            <ul class="project-points">
              <li>
                <strong>Protocol Implementation:</strong> Built a self-hosted OAuth 2.0 / OIDC SSO, deployed isomorphically with the official main site, which acts as the Authorization Server issuing RS256 JWTs — fully implementing the authorize / token / userinfo / introspect / revoke / end-session protocol endpoints with support for PKCE, DPoP, and TOTP two-factor authentication.
              </li>
              <li>
                <strong>SDK &amp; Integration:</strong> Packaged and published npm SDKs (@nihplod/sso-sdk / @nihplod/sso-verify) for minute-level sub-project integration, enabling cross-domain SSO and global sign-out via Token Introspection + Backchannel Logout, supporting unified login across the official website, skin-analysis site, both WeChat mini-programs, and the admin console.
              </li>
              <li>
                <strong>Security Hardening:</strong> Supports secret rotation, token revocation (RFC 7009), and multi-instance blacklist sharing for an operable and auditable auth system.
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

      <div class="project-entry" id="project-ai-advisor">
        <div class="entry-header">
          <h3 class="project-name"><button type="button" class="project-name-button" data-project-dialog="project-ai-advisor">AI Skincare Advisor System</button></h3>
          <span class="entry-date">Jan 2026 – Present</span>
        </div>
        <div class="project-meta">
          Independently delivered · product / UX / full-stack · UI visuals in collaboration · <a href="https://advisor.nihplod.cn" target="_blank" rel="noopener noreferrer">advisor.nihplod.cn ↗</a>
        </div>
        <p class="project-summary">Delivered dual-channel AI skin analysis (questionnaire + face scan) and personalized recommendations; 85 API routes / 426 tests, closing the loop to repurchase.</p>
        <button type="button" class="project-more" data-project-dialog="project-ai-advisor"><svg class="project-more__icon" aria-hidden="true"><use href="#icon-file-text"></use></svg>View details</button>
        <dialog class="project-dialog" id="dialog-project-ai-advisor">
          <div class="project-dialog__panel">
            <div class="project-dialog__header">
              <div class="project-dialog__head" data-project-dialog-head></div>
              <button type="button" class="project-dialog__close" data-project-dialog-close autofocus aria-label="Close">&times;</button>
            </div>
            <div class="project-dialog__content">
              <div class="project-dialog__media">
                <div class="project-media-placeholder" aria-hidden="true">
                  <svg class="project-media-placeholder__icon"><use href="#icon-image"></use></svg>
                  <span>Project screenshot / UI preview</span>
                </div>
                <div class="project-media-placeholder" aria-hidden="true">
                  <svg class="project-media-placeholder__icon"><use href="#icon-image"></use></svg>
                  <span>Logic / architecture diagram</span>
                </div>
              </div>
            <ul class="project-points">
              <li>
                <strong>AI Skin Analysis &amp; Personalized Recommendations:</strong> Integrated Tongyi Qianwen VL / DeepSeek LLMs for dual-channel (questionnaire + facial scan) skin analysis; a custom rule engine scores and matches products against 8 skin-type personas plus seasonal / regional environmental factors, configurable through a visual admin console (zero-code adjustments for operations).
              </li>
              <li>
                <strong>Conversion &amp; Attribution:</strong> Led model integration and core API development; e-commerce outbound links (Tmall / Douyin / Xiaohongshu) support UTM / pid tracking and click-event instrumentation, forming an attributable consultation-to-conversion path together with WeCom advisor short links.
              </li>
              <li>
                <strong>Growth &amp; Membership Operations:</strong> Connected four-tier member skin-analysis quotas (Standard 10 sessions; Silver unlocked by spend; Gold / Diamond unlimited), with reports and profiles tied to the logged-in account; designed share posters, channel ref attribution, and registration-conversion popups, and exported desensitized aggregate CSV statistics to feed the brand whitepaper and market insights.
              </li>
              <li>
                <strong>AI Cost &amp; Reliability Engineering:</strong> Designed an AI request queue with concurrency control, circuit breakers, daily / monthly token and cost budget cutoffs, persisted per-call billing, and a model whitelist with provider fallback; used idempotent retries and quota reservation / release to prevent duplicate charges; reports use 90-day rolling validity with hot / cold tiered archiving (desensitized summaries in the cold tier).
              </li>
              <li>
                <strong>Data Asset Loop:</strong> Designed a server-to-server API with HMAC signatures + IP rate limiting; skin-analysis reports and skincare profiles pass through to WeCom AI customer service via session_id, turning one-off skin tests into continuously operable, repurchase-driving user data assets.
              </li>
            </ul>
            </div>
          </div>
        </dialog>
      </div>

      <h3 class="project-index-title">Other Projects</h3>
      <ul class="project-index">
        <li>
          <span class="project-index-name">WeChat AI Customer Service</span>
          <span class="project-index-desc">FastAPI + Redis + DeepSeek; three-entry message gateway, 340+ automated tests.</span>
          <span class="project-index-date">2026.08</span>
        </li>
        <li>
          <span class="project-index-name"><a href="https://ba.nihplod.cn" target="_blank" rel="noopener noreferrer">NIHPLOD Authorization &amp; Verification Platform</a></span>
          <span class="project-index-desc">Next.js + PostgreSQL; authorization review, anti-counterfeit certificates, public verification.</span>
          <span class="project-index-date">2026.04 – 2026.05</span>
        </li>
        <li>
          <span class="project-index-name">Jizhipai AI Skin Analysis Mini-Program</span>
          <span class="project-index-desc">WeChat Mini Program + VisionKit; 14-page skin analysis flow with async reports.</span>
          <span class="project-index-date">2026.10 – Present</span>
        </li>
        <li>
          <span class="project-index-name">NIHPLOD Member Center Mini-Program</span>
          <span class="project-index-desc">Native TypeScript; 19-page membership, points, redemption and OAuth integration.</span>
          <span class="project-index-date">2026.10 – Present</span>
        </li>
        <li>
          <span class="project-index-name"><a href="https://myskin.today" target="_blank" rel="noopener noreferrer">Myskin.Today</a></span>
          <span class="project-index-desc">Next.js 16 + Tailwind v4; B2B website, API docs and design system.</span>
          <span class="project-index-date">2026.01 – 2026.02</span>
        </li>
        <li>
          <span class="project-index-name"><a href="https://www.lingangjh.com" target="_blank" rel="noopener noreferrer">Shanghai Lingang Jinghong Website System</a></span>
          <span class="project-index-desc">Next.js + CMS; 1.5s first paint; RAG Q&amp;A accuracy &gt;85%.</span>
          <span class="project-index-date">2025.07 – 2025.09</span>
        </li>
      </ul>
    </section>

    <section>
      <h2>Tech Stack</h2>
      <div class="skills-row">
        <span class="skills-label">Frontend:</span>
        <span class="skills-content">TypeScript / React / Next.js / Vue 3 / uni-app / WeChat Mini Program (native / TypeScript) / Tailwind CSS / Canvas 2D / Responsive &amp; Mobile Adaptation</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">Backend &amp; DB:</span>
        <span class="skills-content">Node.js / Python (FastAPI) / Prisma / PostgreSQL / Redis / RESTful API / JWT · OAuth 2.0 · OIDC</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">AI &amp; LLM:</span>
        <span class="skills-content">LLM Integration / Vision-Model Skin Analysis / RAG / AI Cost Engineering (Circuit Breakers &amp; Budget Control) / Claude Code / Codex-Driven Development</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">DevOps &amp; Deploy:</span>
        <span class="skills-content">Linux / Docker / Nginx / CDN / ICP Filing / Cost Control &amp; Resource Optimization</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">Security &amp; Compliance:</span>
        <span class="skills-content">CSP / RLS / Information Security Baseline / Privacy &amp; Data Compliance</span>
      </div>
      <div class="skills-row">
        <span class="skills-label">UI/UX Design:</span>
        <span class="skills-content">Figma / Brand Visual System / Interactive Prototyping / Design-to-Code Implementation</span>
      </div>
    </section>

    <section>
      <h2>Awards &amp; Certifications</h2>
      <div class="award-row">
        <span class="award-name"
          >3rd Prize in "Web Technology" at the Shanghai "Starlight Plan" Vocational Skills Competition (ranked 16th in Shanghai)</span
        >
        <span class="award-date">May 2025</span>
      </div>
      <div class="award-row">
        <span class="award-name"
          >MOHRSS Vocational Skill Level Certificate: Computer Programmer Grade III (Advanced) (Competition)</span
        >
        <span class="award-date">May 2025</span>
      </div>
      <div class="award-row">
        <span class="award-name"
          >National Information Security Test Program Grade II (NISP)</span
        >
        <span class="award-date">May 2025</span>
      </div>
      <div class="award-row">
        <span class="award-name"
          >Cloud Certifications: CTyun Advanced Developer (SCCP), CTyun Advanced O&amp;M Engineer, Alibaba Cloud ACA Cloud Security Associate</span
        >
        <span class="award-date">May 2024 – Nov 2024</span>
      </div>
    </section>

