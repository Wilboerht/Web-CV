import "../styles/global.css";
import "../styles/cv.css";
---

<Layout title="Hongkun Wang - CV" lang="en">
  <slot name="head">
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Hongkun Wang",
        "alternateName": "王泓坤",
        "givenName": "Hongkun",
        "familyName": "Wang",
        "email": "me@wilboerht.cn",
        "telephone": "+8618721400154",
        "url": "https://www.wilboerht.com",
        "sameAs": [
          "https://github.com/Wilboerht",
          "https://twitter.com/wilboerht"
        ],
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "Shanghai Scientific and Technical Vocational College"
        },
        "knowsAbout": [
          "TypeScript",
          "React",
          "Next.js",
          "Node.js",
          "Prisma",
          "PostgreSQL",
          "Large Language Models",
          "RAG",
          "Docker",
          "Linux"
        ],
        "jobTitle": "Digital Development Manager",
